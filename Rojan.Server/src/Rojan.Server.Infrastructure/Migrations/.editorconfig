# EF Core scaffolds migration files in the classic block-scoped namespace
# style, not file-scoped - these files are generated/regenerated by
# `dotnet ef migrations add`, not hand-written, so the solution's usual
# code-style enforcement (IDE0161, file-scoped namespaces) does not apply
# to this folder.
root = false

[*.cs]
dotnet_diagnostic.IDE0161.severity = none
