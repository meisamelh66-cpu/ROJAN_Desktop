<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Rojan.Server.Application\Rojan.Server.Application.csproj" />
    <ProjectReference Include="..\Rojan.Server.Infrastructure\Rojan.Server.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!--
      Phase 5: User Secrets support for local development (connection
      strings/credentials that must never be committed - see
      appsettings.Development.json's own comment). Generated once via
      `dotnet user-secrets init` semantics; the GUID itself carries no
      sensitive information, only the secrets stored under it (in
      %APPDATA%\Microsoft\UserSecrets\<id>\secrets.json, outside the repo).
    -->
    <UserSecretsId>7c9e3f8a-2f0f-4d0d-9c6a-6f1e6f3a9b21</UserSecretsId>
  </PropertyGroup>

</Project>
