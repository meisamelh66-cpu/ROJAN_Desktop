<Project>
  <!--
    Central Package Management (CPM). Every project references packages by
    name only (<PackageReference Include="..." /> with no Version attribute)
    — the version is pinned exactly once, here. This prevents the classic
    multi-project drift where two projects end up on two different minor
    versions of the same package with no one noticing until a runtime
    conflict.

    Empty for now — no packages have been chosen yet (Phase 02 decides the
    DI container/MVVM toolkit, Phase 03 decides the logging/config
    libraries). Populated incrementally as each phase's technology
    decisions are approved, never speculatively.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Minimum required for the Phase 02 architecture scaffolding: a test
      framework (so the five test projects build/run at all) plus
      NetArchTest.Rules for the dependency-direction enforcement described
      in docs/architecture/01-desktop-shell.md §9. DI/hosting/logging/MVVM
      toolkit choices are deferred to the phase that actually implements them.
    -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Phase 25: Security Foundation - Windows DPAPI (CurrentUser-scoped
         encryption at rest for secure storage/key material), factored out
         of the shared framework into its own package since .NET Core. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>