<Project>
  <!--
    Central Package Management (CPM). Every project references packages by
    name only (<PackageReference Include="..." /> with no Version attribute)
    — the version is pinned exactly once, here. This prevents the classic
    multi-project drift where two projects end up on two different minor
    versions of the same package with no one noticing until a runtime
    conflict.

    Empty for now — no packages have been chosen yet (Phase 02 decides the
    DI container/MVVM toolkit, Phase 03 decides the logging/config
    libraries). Populated incrementally as each phase's technology
    decisions are approved, never speculatively.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Minimum required for the Phase 02 architecture scaffolding: a test
      framework (so the five test projects build/run at all) plus
      NetArchTest.Rules for the dependency-direction enforcement described
      in docs/architecture/01-desktop-shell.md §9. DI/hosting/logging/MVVM
      toolkit choices are deferred to the phase that actually implements them.
    -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- Sprint 6 Commit 1: EF Core persistence foundation. SQLite provider
         for the desktop app's local database file; Design is a build-time-
         only dependency (dotnet ef migrations tooling), never shipped at
         runtime - see Infrastructure's own csproj for the PrivateAssets
         setting that enforces that. Pinned to the latest 8.0.x patch to
         match this solution's net8.0-windows TargetFramework exactly. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- Phase 7.4.1 Production Hardening: previously only available to Rojan.Desktop.Infrastructure
         transitively (via Microsoft.EntityFrameworkCore), never a first-class managed reference -
         Rojan.Desktop.Presentation needs its own, direct reference to log caught ViewModel
         failures (see SpecialistScheduleViewModel's own doc comment). Abstractions-only, matching
         the same "reference only what's needed" convention already used for
         Microsoft.Extensions.DependencyInjection.Abstractions above. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- QR Ecosystem (Desktop Productionization Sprint 1): the one QR code
         this app generates client-side rather than via a ROJAN_Backend
         endpoint (the Manager app's static download-page URL - not
         salon/invite-specific, so there is no backend resource to ask).
         MIT-licensed, pure C#, zero further dependencies. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <!-- Phase 25: Security Foundation - Windows DPAPI (CurrentUser-scoped
         encryption at rest for secure storage/key material), factored out
         of the shared framework into its own package since .NET Core. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>