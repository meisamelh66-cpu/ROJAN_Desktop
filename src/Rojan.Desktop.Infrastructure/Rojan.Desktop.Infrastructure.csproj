<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rojan.Desktop.Application\Rojan.Desktop.Application.csproj" />
    <!-- Phase 06B: Infrastructure implements IDashboardRepository, a Domain-
         defined interface - this requires a direct reference to Domain (not
         just the transitive one via Application), which is the correct
         Clean Architecture shape for the repository pattern: the inner
         layer (Domain) defines the abstraction, the outer layer
         (Infrastructure) implements it. -->
    <ProjectReference Include="..\Rojan.Desktop.Domain\Rojan.Desktop.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Phase 25: Security Foundation - DPAPI-backed secure storage/key provider. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sprint 6 Commit 1: EF Core persistence foundation - see
         Persistence/RojanDbContext.cs's own doc comment. EF Core types
         must exist only inside this project (enforced by
         ArchitectureTests.DependencyDirectionTests), never in
         Domain/Application/Presentation. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Design-time only (dotnet ef migrations/database update tooling) -
         never needed at runtime, so it must not flow to anything that
         references this project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Rojan.Desktop.Infrastructure.Tests exercise internal path-
         overriding constructors directly (temp-file-backed test doubles
         for file-persisted services), same reasoning as Shell's
         InternalsVisibleTo to Shell.Tests. -->
    <InternalsVisibleTo Include="Rojan.Desktop.Infrastructure.Tests" />
  </ItemGroup>

</Project>
