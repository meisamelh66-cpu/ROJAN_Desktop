<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rojan.Desktop.Application\Rojan.Desktop.Application.csproj" />
    <!-- Phase 06B: Infrastructure implements IDashboardRepository, a Domain-
         defined interface - this requires a direct reference to Domain (not
         just the transitive one via Application), which is the correct
         Clean Architecture shape for the repository pattern: the inner
         layer (Domain) defines the abstraction, the outer layer
         (Infrastructure) implements it. -->
    <ProjectReference Include="..\Rojan.Desktop.Domain\Rojan.Desktop.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Phase 25: Security Foundation - DPAPI-backed secure storage/key provider. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Rojan.Desktop.Infrastructure.Tests exercise internal path-
         overriding constructors directly (temp-file-backed test doubles
         for file-persisted services), same reasoning as Shell's
         InternalsVisibleTo to Shell.Tests. -->
    <InternalsVisibleTo Include="Rojan.Desktop.Infrastructure.Tests" />
  </ItemGroup>

</Project>
