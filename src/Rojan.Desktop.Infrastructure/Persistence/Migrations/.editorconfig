# EF Core CLI-generated migration code lives in this folder
# (`dotnet ef migrations add`) and is regenerated by tooling, not
# hand-authored - it should never need a manual style pass just to match
# the rest of this codebase's house style. Scoped to this directory only;
# every other project rule from the root .editorconfig still applies
# everywhere else, including the rest of Rojan.Desktop.Infrastructure.
[*.cs]
csharp_style_namespace_declarations = block_scoped:none
dotnet_diagnostic.CA1861.severity = none
