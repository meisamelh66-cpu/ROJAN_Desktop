<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.StaffProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="44"
             Height="44">

    <!--
        Phase C-2: a small, single-purpose proportional progress ring for
        the Staff Status Panel's per-row workload indicator - not
        SimpleBarChart's Donut mode, since that control always renders a
        title line and a legend list alongside the ring (Rebuild/RebuildPie
        in Controls/Analytics/SimpleBarChart.xaml.cs), which is the right
        chrome for a full analytics card but would look broken repeated
        five times at 44px in a staff list. This is a small geometry
        primitive (one arc), not a second charting engine - closer in
        spirit to TrendIndicator's small drawn pill than to a chart.
    -->
    <Grid>
        <Ellipse Stroke="{StaticResource Rojan.Brush.Border}" StrokeThickness="3" />
        <Path x:Name="ProgressArc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <TextBlock x:Name="PercentageTextBlock"
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   FontWeight="SemiBold"
                   FontSize="10"
                   Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>

</UserControl>
