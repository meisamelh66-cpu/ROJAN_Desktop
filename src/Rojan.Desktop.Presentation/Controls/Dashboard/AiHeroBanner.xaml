<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.AiHeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Phase B-1: AI Hero Banner - a reusable UserControl decoupled from
        any specific ViewModel (Headline/Subtitle/TagLabel/CtaLabel/
        ViewSuggestionsCommand/SecondaryCommand are its own Dependency
        Properties, same "ItemsSource DP, not ambient DataContext" shape
        NewsTicker already establishes), so DashboardPage supplies content
        via explicit bindings rather than this control assuming a
        DashboardPageViewModel DataContext.

        Phase D-1: the background is now the real ROJAN AI artwork
        (Assets/rojan_ai_hero_banner.png, an unedited copy of the supplied
        asset - see the .csproj Resource entry) via an ImageBrush, replacing
        the former hand-authored gradient + decorative glow ellipses (the
        artwork already has its own robot, glow, and light-streak effects
        baked in, so the old decorative Grid would only have doubled up on
        it). The text/button column below is untouched - same Dependency
        Properties, same bindings, same commands, just layered on top of
        the new background image instead of the old gradient.

        The app runs under FlowDirection=RightToLeft, which mirrors an
        ImageBrush horizontally same as any other visual - that would flip
        the artwork's baked-in text/robot (text reads correctly only
        left-to-right in the source asset). The outer Border is pinned back
        to LeftToRight so the background image renders unmirrored, and the
        inner Grid restores RightToLeft so the text/button column keeps its
        original position (Grid.Column="0" on the physical right).

        The artwork is a fully-composed banner with its own baked-in logo,
        headline, subtitle, tags, and CTA button occupying the left ~55% of
        the source image, with the robot mascot occupying the right side.
        The ViewModel text overlay covers the same semantic content
        (headline/subtitle/tag/CTA) dynamically, so showing the artwork's
        left half would duplicate/overlap it. The ImageBrush.Viewbox below
        selects only the source's right-hand region (robot + background,
        no baked text) so the two text layers never compete - the PNG file
        on disk is untouched, this only selects which part of it is drawn.
    -->
    <Border CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
            Padding="28,24"
            Effect="{StaticResource Rojan.Effect.ElevationCard}"
            FlowDirection="LeftToRight">
        <Border.Background>
            <ImageBrush ImageSource="pack://application:,,,/Rojan.Desktop.Presentation;component/Assets/rojan_ai_hero_banner.png"
                        Stretch="UniformToFill"
                        Viewbox="0.5516,0.3115,0.4484,0.1430" />
        </Border.Background>

        <Grid FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border CornerRadius="{StaticResource Rojan.CornerRadius.Pill}" Padding="10,4" HorizontalAlignment="Right">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource Rojan.Color.ButtonText}" Opacity="0.16" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Rojan.Icon.Sparkle}"
                                   FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                   FontSize="12"
                                   Foreground="{StaticResource Rojan.Brush.ButtonText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TagLabel, ElementName=Root}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.ButtonText}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Headline, ElementName=Root}"
                           Style="{StaticResource Rojan.TextStyle.Subtitle}"
                           Foreground="{StaticResource Rojan.Brush.ButtonText}"
                           FontSize="19"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           Margin="0,14,0,0" />

                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.ButtonText}"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="{Binding CtaLabel, ElementName=Root}"
                            Command="{Binding ViewSuggestionsCommand, ElementName=Root}"
                            Style="{StaticResource Rojan.Style.ButtonHero}" />
                    <Button Command="{Binding SecondaryCommand, ElementName=Root}"
                            Style="{StaticResource Rojan.Style.ButtonHeroIcon}"
                            Margin="10,0,0,0"
                            ToolTip="{Binding TagLabel, ElementName=Root}">
                        <TextBlock Text="{StaticResource Rojan.Icon.AICenter}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="15" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Grid.Column="1" is intentionally empty - the background image already shows the robot in this half of the banner (see the ImageBrush above); no separate mascot element needed. -->
        </Grid>
    </Border>

</UserControl>
