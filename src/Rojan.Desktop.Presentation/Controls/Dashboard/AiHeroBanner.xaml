<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.AiHeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Phase B-1: AI Hero Banner - a reusable UserControl decoupled from
        any specific ViewModel (Headline/Subtitle/TagLabel/CtaLabel/
        ViewSuggestionsCommand/SecondaryCommand are its own Dependency
        Properties, same "ItemsSource DP, not ambient DataContext" shape
        NewsTicker already establishes), so DashboardPage supplies content
        via explicit bindings rather than this control assuming a
        DashboardPageViewModel DataContext.

        Background is the existing Accent/AccentPressed/AccentLavender
        color tokens in a gradient (no new colors) - the "purple gradient
        hero" the reference calls for, built from the same palette every
        other Accent-tinted surface in this app already uses. The mascot
        is a deliberate approximation: Segoe Fluent Icons has no robot
        illustration, and hand-drawing one from primitive shapes would
        either look crude or require an external asset (both against this
        phase's constraints) - so it reuses the existing AICenter glyph
        (a lightning-bolt-shaped icon already used for AI Assistant
        elsewhere in this codebase) inside a soft glass orb with a couple
        of decorative glow dots, rather than fabricating pixel-for-pixel
        artwork this control can't honestly produce without an asset
        pipeline.
    -->
    <Border CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
            Padding="28,24"
            Effect="{StaticResource Rojan.Effect.ElevationCard}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Rojan.Color.AccentPressed}" Offset="0" />
                <GradientStop Color="{StaticResource Rojan.Color.Accent}" Offset="0.55" />
                <GradientStop Color="{StaticResource Rojan.Color.AccentLavender}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Decorative glow blobs - "light effects/curved light streaks" from the reference, built from existing accent tokens at low opacity, IsHitTestVisible=False so they never intercept input (same pattern DashboardPage's own background glows already use). -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-140" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource Rojan.Color.ButtonText}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="160" Height="160" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,40,0" Opacity="0.25">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource Rojan.Color.AccentAqua}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource Rojan.CornerRadius.Pill}" Padding="10,4" HorizontalAlignment="Right">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource Rojan.Color.ButtonText}" Opacity="0.16" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Rojan.Icon.Sparkle}"
                                       FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                       FontSize="12"
                                       Foreground="{StaticResource Rojan.Brush.ButtonText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TagLabel, ElementName=Root}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.ButtonText}"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Headline, ElementName=Root}"
                               Style="{StaticResource Rojan.TextStyle.Subtitle}"
                               Foreground="{StaticResource Rojan.Brush.ButtonText}"
                               FontSize="19"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Margin="0,14,0,0" />

                    <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.ButtonText}"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="{Binding CtaLabel, ElementName=Root}"
                                Command="{Binding ViewSuggestionsCommand, ElementName=Root}"
                                Style="{StaticResource Rojan.Style.ButtonHero}" />
                        <Button Command="{Binding SecondaryCommand, ElementName=Root}"
                                Style="{StaticResource Rojan.Style.ButtonHeroIcon}"
                                Margin="10,0,0,0"
                                ToolTip="{Binding TagLabel, ElementName=Root}">
                            <TextBlock Text="{StaticResource Rojan.Icon.AICenter}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="15" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Mascot: a soft glass orb around the existing AICenter glyph, not a hand-drawn robot (see doc comment above). -->
                <Border Grid.Column="1"
                        Width="96"
                        Height="96"
                        CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                        Margin="24,0,4,0"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource Rojan.Color.ButtonText}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="MascotScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="MascotScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.04" Duration="0:0:1.8" />
                                    <DoubleAnimation Storyboard.TargetName="MascotScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.04" Duration="0:0:1.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <TextBlock Text="{StaticResource Rojan.Icon.AICenter}"
                               FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                               FontSize="34"
                               Foreground="{StaticResource Rojan.Brush.ButtonText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>

</UserControl>
