<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.TopServicesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:analytics="clr-namespace:Rojan.Desktop.Presentation.Controls.Analytics"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization"
             x:Name="Root">

    <!--
        Phase C-1 (Analytics Row): SimpleBarChart reused as-is in
        ChartType.Bar mode (label + proportional bar + value, already the
        shape the reference's Top Services list needs). Values are stored
        as whole "millions" (5,4,3,2,1) rather than raw amounts - the
        control's own bar-label formatting is hardcoded to
        CultureInfo.InvariantCulture with an "N0" format (not modifying
        SimpleBarChart to change that), so whole numbers keep its
        auto-generated labels clean instead of printing a 7-digit raw
        amount.
    -->
    <dashboardControls:DashboardCard>
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{StaticResource Rojan.Icon.Services}"
                           FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                           FontSize="14"
                           Foreground="{StaticResource Rojan.Brush.Accent}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Static loc:Strings.Dashboard_Analytics_TopServicesTitle}"
                           Style="{StaticResource Rojan.TextStyle.Subtitle}"
                           Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Background="{StaticResource Rojan.Brush.Surface}"
                        BorderBrush="{StaticResource Rojan.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:Strings.Dashboard_Analytics_TodayChip}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{StaticResource Rojan.Icon.ChevronDown}"
                                   FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                   FontSize="9"
                                   Margin="6,0,0,0"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <analytics:SimpleBarChart Chart="{Binding Chart, ElementName=Root}" />

            <Button Content="{x:Static loc:Strings.Dashboard_Analytics_ViewAllServices}"
                    Style="{StaticResource Rojan.Style.ButtonOutlined}"
                    Command="{Binding ViewAllServicesCommand, ElementName=Root}"
                    IsEnabled="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,12,0,0" />
        </StackPanel>
    </dashboardControls:DashboardCard>

</UserControl>
