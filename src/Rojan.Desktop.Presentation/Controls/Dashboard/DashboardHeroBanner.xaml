<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.DashboardHeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Dashboard hero banner - the admin-managed Desktop banner (ROJAN Admin Panel -> Banners ->
        "دسکتاپ"). Content comes only from its own dependency properties (Title/Subtitle/ImageBytes/
        CtaLabel/CtaUri), bound explicitly by DashboardPage, same decoupled shape as AiHeroBanner.

        Height follows width (16:4) and is clamped - see Card_SizeChanged / ComputeHeight in the code-behind - so
        it stays a wide strip at 1366, 1600 and 1920 widths. The image layer is pinned LeftToRight so
        artwork with baked-in text is never mirrored by the app's RightToLeft flow; the text column
        restores RightToLeft. With no (or an undecodable) image, FallbackSurface - a brand gradient -
        shows instead, so a missing image never leaves a broken or blank card.
    -->
    <Border x:Name="Card"
            CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
            Effect="{StaticResource Rojan.Effect.ElevationCard}"
            SizeChanged="Card_SizeChanged">
        <Grid x:Name="ClipHost">
            <Border x:Name="FallbackSurface">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Rojan.Color.Accent}" Offset="0" />
                        <GradientStop Color="{StaticResource Rojan.Color.AccentLavender}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Image x:Name="BannerImage"
                   FlowDirection="LeftToRight"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />

            <!-- Readability scrim behind the text column (physical right side under RTL). -->
            <Border x:Name="TextScrim" FlowDirection="LeftToRight">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#B3000000" Offset="0" />
                        <GradientStop Color="#40000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid FlowDirection="RightToLeft" Margin="32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MaxWidth="620" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title, ElementName=Root}"
                               Style="{StaticResource Rojan.TextStyle.Title}"
                               Foreground="{StaticResource Rojan.Brush.ButtonText}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="76" />
                    <TextBlock x:Name="SubtitleText"
                               Text="{Binding Subtitle, ElementName=Root}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.ButtonText}"
                               Opacity="0.9"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="44"
                               Margin="0,6,0,0" />
                    <Button x:Name="CtaButton"
                            Style="{StaticResource Rojan.Style.ButtonHero}"
                            Content="{Binding CtaLabel, ElementName=Root}"
                            AutomationProperties.Name="{Binding CtaLabel, ElementName=Root}"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            Click="CtaButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
