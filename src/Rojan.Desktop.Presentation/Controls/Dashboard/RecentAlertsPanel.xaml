<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.RecentAlertsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:dashboardVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Dashboard"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization"
             x:Name="Root">

    <UserControl.Resources>
        <converters:ResourceKeyToGlyphConverter x:Key="ResourceKeyToGlyphConverter" />
    </UserControl.Resources>

    <!-- Phase C-2: Recent Alerts Panel - same custom icon+title header technique as every other new card this phase, placed below Staff Status Panel in the freed left column. -->
    <dashboardControls:DashboardCard>
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{StaticResource Rojan.Icon.Notification}"
                           FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                           FontSize="14"
                           Foreground="{StaticResource Rojan.Brush.Accent}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Static loc:Strings.Dashboard_Alerts_Title}"
                           Style="{StaticResource Rojan.TextStyle.Subtitle}"
                           Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{x:Static loc:Strings.Notification_Filter_All}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Items, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dashboardVm:AlertItem}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Icon, Converter={StaticResource ResourceKeyToGlyphConverter}}"
                                       FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                       FontSize="13"
                                       Foreground="{StaticResource Rojan.Brush.Accent}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}"
                                       Style="{StaticResource Rojan.TextStyle.Body}"
                                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                       TextWrapping="Wrap"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </dashboardControls:DashboardCard>

</UserControl>
