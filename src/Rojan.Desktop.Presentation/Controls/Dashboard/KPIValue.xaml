<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.KPIValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization"
             x:Name="Root">

    <!--
        Fluent 2 Premium Theme pass: the Value text's Foreground was
        Rojan.Brush.ButtonText (white, meant for text drawn on a filled
        Accent surface) even though this renders directly on the Card
        background - the same WCAG-failing bug WidgetHeader.xaml had.
        Fixed to TextPrimary. Also no longer self-merges its own
        RojanTheme.xaml copy - see Shell/App.xaml.cs's ThemeResources.Apply.

        Dashboard Modernization Sprint: added an icon badge (Icon DP, see
        code-behind's KpiIconConverter usage in DashboardPage.xaml) and
        switched the Value display to DisplayText, which the code-behind
        drives with a count-up reveal of the same real Value - see
        KPIValue.xaml.cs for the parse/animate/fallback logic.

        Phase 35 (Secure Amount Display): when IsMonetary is set, the
        rendered text (RenderedText, NOT DisplayText - the count-up keeps
        running underneath, unseen) is masked until the user clicks the
        eye toggle - see KPIValue.xaml.cs for the reveal/auto-hide timer
        logic. Non-monetary KPIs (counts) never set IsMonetary, so
        RevealToggle stays collapsed and RenderedText always equals
        DisplayText - zero behavior change for them.
    -->
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Border Width="30"
                    Height="30"
                    CornerRadius="{StaticResource Rojan.CornerRadius.Medium}"
                    Background="{StaticResource Rojan.Brush.AccentSubtle}"
                    Margin="0,0,10,0">
                <TextBlock Text="{Binding Icon, ElementName=Root}"
                           FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                           FontSize="15"
                           Foreground="{StaticResource Rojan.Brush.Accent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValueText"
                       Grid.Column="0"
                       Text="{Binding RenderedText, ElementName=Root}"
                       Style="{StaticResource Rojan.TextStyle.Display}"
                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                       RenderTransformOrigin="0.5,0.5"
                       VerticalAlignment="Bottom">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="ValueScale" ScaleX="1" ScaleY="1" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <Button x:Name="RevealToggle"
                    Grid.Column="1"
                    Click="RevealToggle_Click"
                    Cursor="Hand"
                    Focusable="True"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    Margin="6,0,0,3"
                    Padding="0"
                    ToolTip="{x:Static loc:Strings.Dashboard_ToggleAmountVisibility}"
                    AutomationProperties.Name="{x:Static loc:Strings.Dashboard_ToggleAmountVisibility}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleChrome"
                                Width="26"
                                Height="26"
                                CornerRadius="{StaticResource Rojan.CornerRadius.Pill}">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>
                            <TextBlock x:Name="EyeGlyph"
                                       FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                       FontSize="13"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{StaticResource Rojan.Icon.EyeHide}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRevealed, ElementName=Root}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Rojan.Icon.EyeShow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource Rojan.Color.SurfaceHover}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </StackPanel>

</UserControl>
