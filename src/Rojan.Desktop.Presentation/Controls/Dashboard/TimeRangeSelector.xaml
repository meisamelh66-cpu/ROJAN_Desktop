<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.TimeRangeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization"
             x:Name="Root">

    <!--
        Phase 35 (Interactive Dashboard Filters): a five-option segmented
        time-range control for each KPI card. Fully interactive (mutual
        exclusion via a per-instance RadioButton GroupName generated in
        code-behind, since WPF's GroupName-based exclusivity is scoped by
        string across the whole window, not by parent container - without
        a unique name every card's selector would fight over one shared
        selection) and exposes SelectedRange for any future consumer.
        DashboardPageViewModel has no historical time-series data to filter
        by yet (see KpiChart's own doc comment), so - per this sprint's own
        explicit fallback instruction - the chart underneath is left
        unchanged; this control is the fully-functional selector "ready for
        future data binding," not a filter that fabricates different data
        per range.
    -->
    <WrapPanel Orientation="Horizontal">
        <RadioButton x:Name="DayOption" Style="{StaticResource Rojan.Style.TimeRangeOption}" Content="{x:Static loc:Strings.Dashboard_TimeRange_Day}" Tag="Day" Checked="Option_Checked" />
        <RadioButton x:Name="WeekOption" Style="{StaticResource Rojan.Style.TimeRangeOption}" Content="{x:Static loc:Strings.Dashboard_TimeRange_Week}" Tag="Week" Checked="Option_Checked" Margin="4,0,0,0" />
        <RadioButton x:Name="MonthOption" Style="{StaticResource Rojan.Style.TimeRangeOption}" Content="{x:Static loc:Strings.Dashboard_TimeRange_Month}" Tag="Month" Checked="Option_Checked" Margin="4,0,0,0" IsChecked="True" />
        <RadioButton x:Name="YearOption" Style="{StaticResource Rojan.Style.TimeRangeOption}" Content="{x:Static loc:Strings.Dashboard_TimeRange_Year}" Tag="Year" Checked="Option_Checked" Margin="4,0,0,0" />
        <RadioButton x:Name="AllOption" Style="{StaticResource Rojan.Style.TimeRangeOption}" Content="{x:Static loc:Strings.Dashboard_TimeRange_All}" Tag="All" Checked="Option_Checked" Margin="4,0,0,0" />
    </WrapPanel>

</UserControl>
