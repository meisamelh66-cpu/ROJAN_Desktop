<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.WidgetHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Compact per-widget title - distinct from the page-level
        SectionHeader (which carries the rose-gold accent underline).

        Fluent 2 Premium Theme pass: the title's Foreground was
        Rojan.Brush.ButtonText (white, meant for text drawn on a filled
        Accent surface) even though this renders directly on the Card
        background - harmless on the old dark theme, a real WCAG failure
        on Light.xaml's near-white Card. Fixed to TextPrimary. Also no
        longer self-merges its own RojanTheme.xaml copy - every View/
        control now consumes the single app-level design-system resources
        (see Shell/App.xaml.cs's ThemeResources.Apply).
    -->
    <TextBlock Text="{Binding Title, ElementName=Root}"
               Style="{StaticResource Rojan.TextStyle.SectionHeader}"
               Foreground="{StaticResource Rojan.Brush.TextPrimary}" />

</UserControl>
