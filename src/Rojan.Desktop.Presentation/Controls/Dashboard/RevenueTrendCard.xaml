<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Dashboard.RevenueTrendCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:analytics="clr-namespace:Rojan.Desktop.Presentation.Controls.Analytics"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization"
             x:Name="Root">

    <!--
        Phase C-1 (Analytics Row): DashboardCard's Title is left unset (null
        by default - see DashboardCard.cs) since the reference needs an
        icon next to the title, which the shared WidgetHeader template
        doesn't support; this builds its own header instead, the same
        technique the AI Assistant panel already uses, so DashboardCard's
        shared template itself is never touched.

        Chart is SimpleBarChart (Controls/Analytics) reused as-is in
        ChartType.Area mode - its Rebuild()/RebuildLine draws only the
        polyline/area/dots, no axis labels or peak callout (not modifying
        SimpleBarChart to add them), so the weekday labels below are this
        control's own addition, built from the same Categories list the
        chart itself renders from - never a second, disconnected data
        source.
    -->
    <dashboardControls:DashboardCard>
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{StaticResource Rojan.Icon.TrendUp}"
                           FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                           FontSize="14"
                           Foreground="{StaticResource Rojan.Brush.Accent}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Static loc:Strings.Dashboard_Analytics_RevenueTrendTitle}"
                           Style="{StaticResource Rojan.TextStyle.Subtitle}"
                           Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Background="{StaticResource Rojan.Brush.Surface}"
                        BorderBrush="{StaticResource Rojan.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:Strings.Dashboard_Analytics_WeekChip}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{StaticResource Rojan.Icon.ChevronDown}"
                                   FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                   FontSize="9"
                                   Margin="6,0,0,0"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <analytics:SimpleBarChart Chart="{Binding Chart, ElementName=Root}" Height="140" />

            <!--
                Deliberately a Canvas with each label placed at an absolute
                Canvas.Left (computed in code-behind, see PositionDayLabels),
                not an ItemsControl/UniformGrid - a mirroring-aware panel
                would auto-flip under this app's RTL, but SimpleBarChart's
                line-chart Canvas above positions its points via absolute,
                non-mirroring Canvas.Left too (RebuildLine). Using the exact
                same coordinate formula (width=320, padding=8) in a sibling
                Canvas with no FlowDirection override guarantees this stays
                pixel-aligned with the real data points regardless of
                whichever way FlowDirection ends up affecting either one -
                both inherit identically since neither sets it explicitly.
            -->
            <Canvas x:Name="DayLabelsCanvas" Height="20" Margin="0,8,0,0" />
        </StackPanel>
    </dashboardControls:DashboardCard>

</UserControl>
