<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Analytics.SimpleBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Rojan.Desktop.Presentation.Controls.Analytics"
             x:Name="Root">
    <StackPanel>
        <TextBlock Text="{Binding Chart.Title, ElementName=Root}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,0,0,8" />
        <!--
            ItemsSource is set directly in code-behind (SimpleBarChart's
            constructor), not via "{Binding Bars, ElementName=Root}" - Bars
            is a plain CLR property (not a DependencyProperty), and an
            ElementName binding to it proved unreliable once SimpleBarChart
            is itself hosted inside an outer ItemsControl's own DataTemplate
            (AnalyticsPage's Chart Area): Rebuild() populated Bars correctly
            every time (confirmed via trace during Phase 20's runtime
            verification), but the bars never rendered. Assigning
            ItemsSource once, directly, sidesteps ElementName resolution
            entirely - WPF still tracks future Add/Clear calls via the
            ObservableCollection's own INotifyCollectionChanged.
        -->
        <ItemsControl x:Name="BarsItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChartBarItem}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1"
                                Background="{StaticResource Rojan.Brush.Accent}"
                                CornerRadius="{StaticResource Rojan.CornerRadius.Small}"
                                Height="14"
                                Width="{Binding BarWidth}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DisplayValue}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            Phase 33: Enterprise Reporting & Business Intelligence Platform.
            Pie/Donut render as real wedges (native Path/ArcSegment, still no
            external charting library) instead of degrading to bars;
            Line/Area/Trend render as a real Polyline. Both built entirely in
            code-behind (Rebuild()) since the geometry depends on the whole
            series, same reasoning BarWidth is pre-computed there instead of
            via a converter. Bar/Column/HeatMap keep the existing bar
            rendering above (HeatMap has no dedicated renderer yet - Domain's
            own doc comment documents it as architecture-ready only).
        -->
        <Canvas x:Name="PieCanvas" Width="180" Height="180" Margin="0,4,0,4" HorizontalAlignment="Left" Visibility="Collapsed" />
        <ItemsControl x:Name="PieLegendItemsControl" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChartBarItem}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding SliceBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DisplayValue}" Style="{StaticResource Rojan.TextStyle.Caption}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas x:Name="LineCanvas" Height="140" Margin="0,4,0,4" Visibility="Collapsed" />
    </StackPanel>

</UserControl>
