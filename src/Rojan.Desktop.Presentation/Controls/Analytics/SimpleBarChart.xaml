<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Analytics.SimpleBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Rojan.Desktop.Presentation.Controls.Analytics"
             x:Name="Root">
    <StackPanel>
        <TextBlock Text="{Binding Chart.Title, ElementName=Root}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,0,0,8" />
        <!--
            ItemsSource is set directly in code-behind (SimpleBarChart's
            constructor), not via "{Binding Bars, ElementName=Root}" - Bars
            is a plain CLR property (not a DependencyProperty), and an
            ElementName binding to it proved unreliable once SimpleBarChart
            is itself hosted inside an outer ItemsControl's own DataTemplate
            (AnalyticsPage's Chart Area): Rebuild() populated Bars correctly
            every time (confirmed via trace during Phase 20's runtime
            verification), but the bars never rendered. Assigning
            ItemsSource once, directly, sidesteps ElementName resolution
            entirely - WPF still tracks future Add/Clear calls via the
            ObservableCollection's own INotifyCollectionChanged.
        -->
        <ItemsControl x:Name="BarsItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChartBarItem}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1"
                                Background="{StaticResource Rojan.Brush.Accent}"
                                CornerRadius="{StaticResource Rojan.CornerRadius.Small}"
                                Height="14"
                                Width="{Binding BarWidth}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DisplayValue}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

</UserControl>
