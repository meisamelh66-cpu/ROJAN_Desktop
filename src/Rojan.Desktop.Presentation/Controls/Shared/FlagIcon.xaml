<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Shared.FlagIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Language Selector: small hand-authored vector flag chips - same
        "no external asset file, no icon-font dependency" convention
        Themes/Icons.xaml's own Rojan.Icon.Crown.Geometry doc comment
        already establishes for a glyph this app's icon font doesn't have.
        All four flags live in this one native 30x20 Grid, each wrapped in
        its own Visibility-by-LanguageCode trigger (so nothing swaps in
        code-behind), wrapped once in a Viewbox so the whole thing is pure
        vector - correct at any DPI/size, never a raster image. Deliberately
        simplified (no emblem/stars/script) - the honest, standard
        treatment for a compact flag chip this small, not a fidelity gap:
        Iran's central emblem and Saudi Arabia's Shahada script are both
        illegible at this size and risk misrepresenting the latter if
        hand-approximated, so both render as their field colors only.
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="30" Height="20" ClipToBounds="True">

            <!-- fa-IR: Iran - green/white/red horizontal tricolor -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LanguageCode, ElementName=Root}" Value="fa-IR">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <Rectangle Height="6.6667" Fill="#239F40" />
                    <Rectangle Height="6.6667" Fill="#FFFFFF" />
                    <Rectangle Height="6.6667" Fill="#DA0000" />
                </StackPanel>
            </Grid>

            <!-- en-US: United States - 13 stripes + navy canton -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LanguageCode, ElementName=Root}" Value="en-US">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <UniformGrid Rows="13">
                    <Rectangle Fill="#B22234" />
                    <Rectangle Fill="#FFFFFF" />
                    <Rectangle Fill="#B22234" />
                    <Rectangle Fill="#FFFFFF" />
                    <Rectangle Fill="#B22234" />
                    <Rectangle Fill="#FFFFFF" />
                    <Rectangle Fill="#B22234" />
                    <Rectangle Fill="#FFFFFF" />
                    <Rectangle Fill="#B22234" />
                    <Rectangle Fill="#FFFFFF" />
                    <Rectangle Fill="#B22234" />
                    <Rectangle Fill="#FFFFFF" />
                    <Rectangle Fill="#B22234" />
                </UniformGrid>
                <Rectangle Width="12" Height="10.7692" Fill="#3C3B6E" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>

            <!-- de-DE: Germany - black/red/gold horizontal tricolor -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LanguageCode, ElementName=Root}" Value="de-DE">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <Rectangle Height="6.6667" Fill="#000000" />
                    <Rectangle Height="6.6667" Fill="#DD0000" />
                    <Rectangle Height="6.6667" Fill="#FFCE00" />
                </StackPanel>
            </Grid>

            <!-- ar-SA: Saudi Arabia - field color only, see this file's own doc comment for why the script/emblem is deliberately omitted -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LanguageCode, ElementName=Root}" Value="ar-SA">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Rectangle Fill="#006C35" />
            </Grid>

        </Grid>
    </Viewbox>
</UserControl>
