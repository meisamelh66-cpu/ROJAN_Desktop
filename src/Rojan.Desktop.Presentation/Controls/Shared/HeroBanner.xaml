<UserControl x:Class="Rojan.Desktop.Presentation.Controls.Shared.HeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Sprint 1 (ROJAN Premium Kit): generic hero banner - see this
        control's own doc comment in HeroBanner.xaml.cs for why it's new
        rather than a move of Controls/Dashboard/AiHeroBanner.xaml.
        Reuses Rojan.Style.ButtonHero/ButtonHeroIcon from
        Themes/DashboardComponents.xaml as-is - both are already globally
        merged (Shell/Theming/ThemeResources.cs merges that file today,
        before this sprint's own later commits), so referencing them here
        is not a forward dependency.

        RTL note (Sprint 1 plan, "High risk"): the text/CTA column is
        declared first (Star width) and the artwork column second (Auto
        width) so Grid's automatic column-order mirroring under
        FlowDirection handles layout correctly; the artwork image itself
        is not expected to mirror (per the Phase D-1 lesson, artwork
        should never bake in directional text in the first place).
    -->
    <Border CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Rojan.Color.Accent}" Offset="0" />
                <GradientStop Color="{StaticResource Rojan.Color.AccentPressed}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline, ElementName=Root}"
                           Style="{StaticResource Rojan.TextStyle.Title}"
                           Foreground="{StaticResource Rojan.Brush.ButtonText}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.ButtonText}"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="{Binding PrimaryButtonText, ElementName=Root}"
                            Command="{Binding PrimaryButtonCommand, ElementName=Root}"
                            CommandParameter="{Binding PrimaryButtonCommandParameter, ElementName=Root}"
                            Style="{StaticResource Rojan.Style.ButtonHero}" />

                    <Button Command="{Binding SecondaryButtonCommand, ElementName=Root}"
                            Margin="8,0,0,0"
                            ToolTip="{Binding SecondaryButtonTooltip, ElementName=Root}"
                            AutomationProperties.Name="{Binding SecondaryButtonTooltip, ElementName=Root}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonHeroIcon}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SecondaryIcon, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding SecondaryIcon, ElementName=Root}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="15" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Width="110" Height="110" Margin="20,0,0,0" CornerRadius="{StaticResource Rojan.CornerRadius.Large}" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Artwork, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding Artwork, ElementName=Root}" Stretch="UniformToFill" />
            </Border>
        </Grid>
    </Border>

</UserControl>
