<UserControl x:Class="Rojan.Desktop.Presentation.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Foundation-only composite component: a section title plus a short
        accent underline. The one design-system component implemented as a
        UserControl rather than a bare Style (see Themes/Controls.xaml) -
        genuinely composite content, not just a re-skinned standard control.
        Merges its own resource dependencies locally so it renders
        correctly regardless of what the consuming Application has merged
        (same self-sufficiency rule already applied to Gradients.xaml/
        Shadows.xaml/Controls.xaml).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml" />
                <ResourceDictionary Source="../Themes/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource Rojan.TextStyle.Title}"
                   Foreground="{StaticResource Rojan.Brush.ButtonText}" />
        <Border Height="2"
                Width="48"
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                Background="{StaticResource Rojan.Brush.RoseGoldHighlight}" />
    </StackPanel>

</UserControl>
