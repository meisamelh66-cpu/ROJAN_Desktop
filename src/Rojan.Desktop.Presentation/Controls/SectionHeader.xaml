<UserControl x:Class="Rojan.Desktop.Presentation.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        Foundation-only composite component: a section title plus a short
        accent underline. The one design-system component implemented as a
        UserControl rather than a bare Style (see Themes/Controls.xaml) -
        genuinely composite content, not just a re-skinned standard control.

        Fluent 2 Premium Theme pass: the title's Foreground was
        Rojan.Brush.ButtonText (white, meant for text drawn on a filled
        Accent surface) even though this renders directly on the page
        background - harmless on the old dark theme (white reads fine on
        navy) but a real WCAG failure once Light.xaml became the shipped
        default (white-on-near-white). Fixed to TextPrimary, the correct
        token for page-level text. Also no longer self-merges its own
        Colors.xaml/Typography.xaml - every View now consumes the single
        app-level design-system resources ThemeResources.Apply assembles
        (see Shell/App.xaml.cs), rather than each merging its own copy.
    -->
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource Rojan.TextStyle.Title}"
                   Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
        <Border Height="2"
                Width="48"
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                Background="{StaticResource Rojan.Brush.RoseGoldHighlight}" />
    </StackPanel>

</UserControl>
