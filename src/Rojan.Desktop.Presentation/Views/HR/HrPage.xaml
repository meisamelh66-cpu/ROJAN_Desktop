<UserControl x:Class="Rojan.Desktop.Presentation.Views.HR.HrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:hrVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.HR"
             xmlns:appHr="clr-namespace:Rojan.Desktop.Application.HR;assembly=Rojan.Desktop.Application">

    <!--
        Phase 19: Enterprise Staff, HR & Commission Management. Same
        master-detail shape as every other module: HR Dashboard KPI cards
        always visible at the top of the left column, a local section
        switcher (Employees/Attendance/Shifts/Leave/Commission/Payroll -
        no new navigation surface, no new Design System components) below
        it, and the selected employee's EmployeeProfileViewModel on the
        right - visible regardless of which section is active, since
        Employee is this module's central entity.

        Every card/widget/value here is DashboardCard/DashboardWidget/
        KPIValue, the same components every other module reuses; every
        form control (TextBox/ComboBox/DatePicker) picks up its Fluent
        styling from Themes/Controls.xaml automatically (Phase 16) - no
        per-page styling needed here.

    -->
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, KPI cards, section switcher, active section content -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="Staff &amp; HR" />
            <TextBlock Grid.Row="0"
                       Text="Employees, attendance, shifts, leave, commission, and payroll."
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <!-- HR Dashboard KPI cards -->
            <dashboardControls:DashboardCard Grid.Row="1" Margin="0,24,0,0">
                <WrapPanel DataContext="{Binding Summary}">
                    <dashboardControls:KPIValue Label="Employees" Value="{Binding EmployeeCount}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="Present Today" Value="{Binding PresentToday}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="Late Today" Value="{Binding LateToday}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="On Leave" Value="{Binding OnLeaveCount}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="Payroll This Month" Value="{Binding PayrollThisMonth, StringFormat={}{0:C}}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="Commission This Month" Value="{Binding CommissionThisMonth, StringFormat={}{0:C}}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="Avg. Attendance" Value="{Binding AverageAttendancePercent, StringFormat={}{0}%}" Margin="0,0,0,12" />
                </WrapPanel>
            </dashboardControls:DashboardCard>

            <!-- Section switcher: same base ButtonSecondary style always, with
                 a DataTrigger overriding just Background/Foreground/
                 BorderThickness to read as "selected" - a DataTrigger
                 cannot legally set a Style's own Style property (WPF:
                 "Style object is not allowed to affect the Style property
                 of the object to which it applies"), so this sets the
                 individual visual properties Rojan.Style.ButtonPrimary
                 itself sets, rather than swapping styles wholesale. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Employees" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Employees}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Employees">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Attendance" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Attendance}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Attendance">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Shifts" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Shifts}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Shifts">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Leave" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Leave}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Leave">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Commission" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Commission}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Commission">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Payroll" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Payroll}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Payroll">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <Grid>

                    <!-- Section: Employees -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Employees">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="Add Employee">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Full name" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeeFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Email" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeeEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Text="Phone" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeePhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Text="Base salary" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeeBaseSalary, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Text="Role" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewEmployeeRole, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Text="Department" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableDepartments}" SelectedItem="{Binding NewEmployeeDepartment, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Employment type" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <ComboBox ItemsSource="{Binding AvailableEmploymentTypes}" SelectedItem="{Binding NewEmployeeEmploymentType, Mode=TwoWay}" Margin="0,4,0,0" HorizontalAlignment="Left" Width="200" />
                                </StackPanel>
                                <Button Content="Add Employee" Command="{Binding CreateEmployeeCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,10" Margin="0,16,0,0">
                            <Grid>
                                <TextBlock Text="Search by name, email, role, or department..."
                                           Foreground="{StaticResource Rojan.Brush.HintText}"
                                           FontFamily="{StaticResource Rojan.FontFamily.Default}"
                                           FontSize="15"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                         CaretBrush="{StaticResource Rojan.Brush.Accent}"
                                         FontFamily="{StaticResource Rojan.FontFamily.Default}" FontSize="15" />
                            </Grid>
                        </Border>

                        <dashboardControls:DashboardWidget Title="All Employees"
                                                            State="{Binding State}"
                                                            ErrorMessage="{Binding ErrorMessage}"
                                                            RetryCommand="{Binding LoadCommand}"
                                                            Margin="0,16,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <ListBox ItemsSource="{Binding Employees}"
                                         SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type appHr:EmployeeDto}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                    <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                        <Run Text="{Binding Role, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Department, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </dashboardControls:DashboardWidget>
                    </StackPanel>

                    <!-- Section: Attendance -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Attendance">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="Record Attendance (Today)">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Employee" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding AttendanceSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Check-in (HH:mm)" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding AttendanceCheckInTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Notes" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding AttendanceNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Record Attendance" Command="{Binding RecordAttendanceCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Today's Attendance" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding TodayAttendance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:AttendanceDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Shifts -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Shifts">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="Create Shift">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Label" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewShiftLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Department" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableDepartments}" SelectedItem="{Binding NewShiftDepartment, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start (HH:mm)" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewShiftStartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="End (HH:mm)" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewShiftEndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Create Shift" Command="{Binding CreateShiftCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Assign Shift" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Shift" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding AssignShiftSelectedShift, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Employee" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding AssignShiftSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Date" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <DatePicker SelectedDate="{Binding AssignShiftDate, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Assign Shift" Command="{Binding AssignShiftCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Shift Assignments" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding ShiftAssignments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:ShiftAssignmentDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding EmployeeName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AssignedDate, StringFormat={}{0:MMM d, yyyy}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Leave -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Leave">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="Request Leave">
                            <StackPanel>
                                <TextBlock Text="Employee" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding LeaveSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start date" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <DatePicker SelectedDate="{Binding LeaveStartDate, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="End date" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <DatePicker SelectedDate="{Binding LeaveEndDate, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Reason" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Request Leave" Command="{Binding RequestLeaveCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Leave Requests" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding LeaveRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:LeaveRequestDto}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Status, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{Binding StartDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                                    <Run Text=" - " />
                                                    <Run Text="{Binding EndDate, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Approve"
                                                        Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ApproveLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Reject"
                                                        Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                        Command="{Binding DataContext.RejectLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Commission -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Commission">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="Commission Engine">
                            <StackPanel>
                                <TextBlock Text="Generate commission transactions from paid Accounting invoices that have a booking behind them."
                                           Style="{StaticResource Rojan.TextStyle.Body}"
                                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                                           TextWrapping="Wrap" />
                                <Button Content="Generate Commissions from Accounting" Command="{Binding GenerateCommissionsCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.Success}" Margin="0,8,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Add Commission Rule" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Employee" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding NewRuleSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Type" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableCommissionTypes}" SelectedItem="{Binding NewRuleType, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Value (0.10 = 10%, or flat $)" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewRuleValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Description" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewRuleDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Add Rule" Command="{Binding CreateCommissionRuleCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Commission Rules" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding CommissionRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:CommissionRuleDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center">
                                                <Run Text="{Binding Type, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Value, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Commission History" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding CommissionTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:CommissionTransactionDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="Invoice " /><Run Text="{Binding InvoiceId, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding EarnedAt, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CommissionAmount, StringFormat={}{0:C}}" Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Payroll -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Payroll">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="Generate Payroll Summary">
                            <StackPanel>
                                <TextBlock Text="Employee" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding PayrollSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Month" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollMonth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Year" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bonus" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollBonus, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Deduction" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollDeduction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Generate Payroll" Command="{Binding GeneratePayrollCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="Payroll Summaries" Margin="0,16,0,32">
                            <ItemsControl ItemsSource="{Binding PayrollSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:PayrollSummaryDto}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Month, Mode=OneWay}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding Year, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="Base " /><Run Text="{Binding BaseSalary, StringFormat={}{0:C}, Mode=OneWay}" />
                                                    <Run Text=" + Commission " /><Run Text="{Binding CommissionTotal, StringFormat={}{0:C}, Mode=OneWay}" />
                                                    <Run Text=" + Bonus " /><Run Text="{Binding Bonus, StringFormat={}{0:C}, Mode=OneWay}" />
                                                    <Run Text=" - Deduction " /><Run Text="{Binding Deduction, StringFormat={}{0:C}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding NetSalary, StringFormat={}{0:C}}" Style="{StaticResource Rojan.TextStyle.Subtitle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Right: selected employee's profile -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="Select an employee to view their profile."
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding Profile}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardWidget Title="{Binding Profile.Employee.FullName}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}">
                        <StackPanel DataContext="{Binding Profile}">
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                <Run Text="{Binding Employee.Role, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Employee.Department, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Employee.Status, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Employee.Email}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Employee.Phone}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                <Run Text="Base salary: " /><Run Text="{Binding Employee.BaseSalary, StringFormat={}{0:C}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detail.Bio}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Activate" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=dashboardControls:DashboardWidget}}" />
                                <Button Content="Deactivate" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=dashboardControls:DashboardWidget}}" />
                                <Button Content="Suspend" Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                        Command="{Binding DataContext.SuspendCommand, RelativeSource={RelativeSource AncestorType=dashboardControls:DashboardWidget}}" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <dashboardControls:DashboardCard Title="Recent Attendance" Margin="0,16,0,0" DataContext="{Binding Profile}">
                        <ItemsControl ItemsSource="{Binding RecentAttendance}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHr:AttendanceDto}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat={}{0:MMM d}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Rojan.TextStyle.Caption}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="Upcoming Shifts" Margin="0,16,0,0" DataContext="{Binding Profile}">
                        <ItemsControl ItemsSource="{Binding UpcomingShifts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHr:ShiftAssignmentDto}">
                                    <TextBlock Text="{Binding AssignedDate, StringFormat={}{0:MMM d, yyyy}}" Style="{StaticResource Rojan.TextStyle.Caption}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="Recent Commissions" Margin="0,16,0,32" DataContext="{Binding Profile}">
                        <ItemsControl ItemsSource="{Binding RecentCommissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHr:CommissionTransactionDto}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ServiceName}" Style="{StaticResource Rojan.TextStyle.Caption}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CommissionAmount, StringFormat={}{0:C}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
