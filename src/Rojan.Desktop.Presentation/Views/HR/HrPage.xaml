<UserControl x:Class="Rojan.Desktop.Presentation.Views.HR.HrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:hrVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.HR"
             xmlns:appHr="clr-namespace:Rojan.Desktop.Application.HR;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 19: Enterprise Staff, HR & Commission Management. Same
        master-detail shape as every other module: HR Dashboard KPI cards
        always visible at the top of the left column, a local section
        switcher (Employees/Attendance/Shifts/Leave/Commission/Payroll -
        no new navigation surface, no new Design System components) below
        it, and the selected employee's EmployeeProfileViewModel on the
        right - visible regardless of which section is active, since
        Employee is this module's central entity.

        Every card/widget/value here is DashboardCard/DashboardWidget/
        KPIValue, the same components every other module reuses; every
        form control (TextBox/ComboBox/DatePicker) picks up its Fluent
        styling from Themes/Controls.xaml automatically (Phase 16) - no
        per-page styling needed here.

        Localization Audit completion pass: fully localized (Strings.*
        for every literal, Rojan.Converter.EnumLabel for every enum
        display) - previously deferred as this app's largest
        hardcoded-string surface alongside AiCenterPage.xaml; see
        docs/phases/phase-24-localization-audit-completion.md.
    -->
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, KPI cards, section switcher, active section content -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Hr_Title}" />
            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Hr_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <!-- HR Dashboard KPI cards -->
            <dashboardControls:DashboardCard Grid.Row="1" Margin="0,24,0,0">
                <WrapPanel DataContext="{Binding Summary}">
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_Employees}" Value="{Binding EmployeeCount}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_PresentToday}" Value="{Binding PresentToday}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_LateToday}" Value="{Binding LateToday}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_OnLeave}" Value="{Binding OnLeaveCount}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_PayrollThisMonth}" Value="{Binding PayrollThisMonth, StringFormat={}{0:C}}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_CommissionThisMonth}" Value="{Binding CommissionThisMonth, StringFormat={}{0:C}}" Margin="0,0,24,12" />
                    <dashboardControls:KPIValue Label="{x:Static loc:Strings.Hr_AvgAttendance}" Value="{Binding AverageAttendancePercent, StringFormat={}{0}%}" Margin="0,0,0,12" />
                </WrapPanel>
            </dashboardControls:DashboardCard>

            <!-- Section switcher: same base ButtonSecondary style always, with
                 a DataTrigger overriding just Background/Foreground/
                 BorderThickness to read as "selected" - a DataTrigger
                 cannot legally set a Style's own Style property (WPF:
                 "Style object is not allowed to affect the Style property
                 of the object to which it applies"), so this sets the
                 individual visual properties Rojan.Style.ButtonPrimary
                 itself sets, rather than swapping styles wholesale. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{x:Static loc:Strings.Hr_Employees}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Employees}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Employees">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Hr_Attendance}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Attendance}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Attendance">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Hr_Shifts}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Shifts}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Shifts">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Hr_Leave}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Leave}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Leave">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Hr_Commission}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Commission}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Commission">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Hr_Payroll}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static hrVm:HrSection.Payroll}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Payroll">
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <Grid>

                    <!-- Section: Employees -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Employees">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_AddEmployee}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Common_FullName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeeFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Common_Email}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeeEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.Common_Phone}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeePhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_BaseSalary}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewEmployeeBaseSalary, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Role}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewEmployeeRole, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Department}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableDepartments}" SelectedItem="{Binding NewEmployeeDepartment, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{x:Static loc:Strings.Hr_EmploymentType}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <ComboBox ItemsSource="{Binding AvailableEmploymentTypes}" SelectedItem="{Binding NewEmployeeEmploymentType, Mode=TwoWay}" Margin="0,4,0,0" HorizontalAlignment="Left" Width="200" />
                                </StackPanel>
                                <Button Content="{x:Static loc:Strings.Hr_AddEmployee}" Command="{Binding CreateEmployeeCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,10" Margin="0,16,0,0">
                            <Grid>
                                <TextBlock Text="{x:Static loc:Strings.Hr_SearchPlaceholder}"
                                           Foreground="{StaticResource Rojan.Brush.HintText}"
                                           FontFamily="{StaticResource Rojan.FontFamily.Default}"
                                           FontSize="15"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                         CaretBrush="{StaticResource Rojan.Brush.Accent}"
                                         FontFamily="{StaticResource Rojan.FontFamily.Default}" FontSize="15" />
                            </Grid>
                        </Border>

                        <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Hr_AllEmployees}"
                                                            State="{Binding State}"
                                                            ErrorMessage="{Binding ErrorMessage}"
                                                            RetryCommand="{Binding LoadCommand}"
                                                            Margin="0,16,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <ListBox ItemsSource="{Binding Employees}"
                                         SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type appHr:EmployeeDto}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                    <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                        <Run Text="{Binding Role, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Department, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </dashboardControls:DashboardWidget>
                    </StackPanel>

                    <!-- Section: Attendance -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Attendance">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_RecordAttendanceToday}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Employee}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding AttendanceSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_CheckInTime}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding AttendanceCheckInTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{x:Static loc:Strings.Common_Notes}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding AttendanceNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="{x:Static loc:Strings.Hr_RecordAttendance}" Command="{Binding RecordAttendanceCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_TodayAttendance}" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding TodayAttendance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:AttendanceDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Shifts -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Shifts">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_CreateShift}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Label}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewShiftLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Department}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableDepartments}" SelectedItem="{Binding NewShiftDepartment, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_StartTime}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewShiftStartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_EndTime}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewShiftEndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="{x:Static loc:Strings.Hr_CreateShift}" Command="{Binding CreateShiftCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_AssignShift}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Shift}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding AssignShiftSelectedShift, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Employee}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding AssignShiftSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{x:Static loc:Strings.Common_Date}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <DatePicker SelectedDate="{Binding AssignShiftDate, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="{x:Static loc:Strings.Hr_AssignShift}" Command="{Binding AssignShiftCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_ShiftAssignments}" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding ShiftAssignments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:ShiftAssignmentDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding EmployeeName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AssignedDate, StringFormat={}{0:MMM d, yyyy}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Leave -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Leave">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_RequestLeave}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Hr_Employee}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding LeaveSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_StartDate}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <DatePicker SelectedDate="{Binding LeaveStartDate, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_EndDate}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <DatePicker SelectedDate="{Binding LeaveEndDate, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{x:Static loc:Strings.Hr_Reason}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="{x:Static loc:Strings.Hr_RequestLeave}" Command="{Binding RequestLeaveCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_LeaveRequests}" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding LeaveRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:LeaveRequestDto}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{Binding StartDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                                    <Run Text=" - " />
                                                    <Run Text="{Binding EndDate, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="{x:Static loc:Strings.Hr_Approve}"
                                                        Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ApproveLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{x:Static loc:Strings.Hr_Reject}"
                                                        Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                        Command="{Binding DataContext.RejectLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Commission -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Commission">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_CommissionEngine}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Hr_CommissionEngineDescription}"
                                           Style="{StaticResource Rojan.TextStyle.Body}"
                                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                                           TextWrapping="Wrap" />
                                <Button Content="{x:Static loc:Strings.Hr_GenerateCommissions}" Command="{Binding GenerateCommissionsCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.Success}" Margin="0,8,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_AddCommissionRule}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Employee}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding NewRuleSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Common_Type}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableCommissionTypes}" SelectedItem="{Binding NewRuleType, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_CommissionValueHint}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewRuleValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Common_Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding NewRuleDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="{x:Static loc:Strings.Hr_AddRule}" Command="{Binding CreateCommissionRuleCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_CommissionRules}" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding CommissionRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:CommissionRuleDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center">
                                                <Run Text="{Binding Type, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Value, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_CommissionHistory}" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding CommissionTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:CommissionTransactionDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{x:Static loc:Strings.Hr_Invoice}" /><Run Text=" " /><Run Text="{Binding InvoiceId, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding EarnedAt, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CommissionAmount, StringFormat={}{0:C}}" Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                    <!-- Section: Payroll -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Payroll">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_GeneratePayrollSummary}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Hr_Employee}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding PayrollSelectedEmployee, Mode=TwoWay}" DisplayMemberPath="FullName" Margin="0,4,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Month}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollMonth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Year}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Bonus}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollBonus, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static loc:Strings.Hr_Deduction}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding PayrollDeduction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="{x:Static loc:Strings.Hr_GeneratePayroll}" Command="{Binding GeneratePayrollCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_PayrollSummaries}" Margin="0,16,0,32">
                            <ItemsControl ItemsSource="{Binding PayrollSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appHr:PayrollSummaryDto}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Month, Mode=OneWay}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding Year, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{x:Static loc:Strings.Hr_Base}" /><Run Text=" " /><Run Text="{Binding BaseSalary, StringFormat={}{0:C}, Mode=OneWay}" />
                                                    <Run Text=" + " /><Run Text="{x:Static loc:Strings.Hr_Commission}" /><Run Text=" " /><Run Text="{Binding CommissionTotal, StringFormat={}{0:C}, Mode=OneWay}" />
                                                    <Run Text=" + " /><Run Text="{x:Static loc:Strings.Hr_Bonus}" /><Run Text=" " /><Run Text="{Binding Bonus, StringFormat={}{0:C}, Mode=OneWay}" />
                                                    <Run Text=" - " /><Run Text="{x:Static loc:Strings.Hr_Deduction}" /><Run Text=" " /><Run Text="{Binding Deduction, StringFormat={}{0:C}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding NetSalary, StringFormat={}{0:C}}" Style="{StaticResource Rojan.TextStyle.Subtitle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Right: selected employee's profile -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="{x:Static loc:Strings.Hr_SelectPrompt}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding Profile}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardWidget Title="{Binding Profile.Employee.FullName}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}">
                        <StackPanel DataContext="{Binding Profile}">
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                <Run Text="{Binding Employee.Role, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Employee.Department, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Employee.Status, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Employee.Email}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Employee.Phone}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                <Run Text="{x:Static loc:Strings.Hr_BaseSalary}" /><Run Text=": " /><Run Text="{Binding Employee.BaseSalary, StringFormat={}{0:C}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detail.Bio}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{x:Static loc:Strings.Hr_Activate}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=dashboardControls:DashboardWidget}}" />
                                <Button Content="{x:Static loc:Strings.Hr_Deactivate}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=dashboardControls:DashboardWidget}}" />
                                <Button Content="{x:Static loc:Strings.Hr_Suspend}" Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                        Command="{Binding DataContext.SuspendCommand, RelativeSource={RelativeSource AncestorType=dashboardControls:DashboardWidget}}" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_RecentAttendance}" Margin="0,16,0,0" DataContext="{Binding Profile}">
                        <ItemsControl ItemsSource="{Binding RecentAttendance}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHr:AttendanceDto}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat={}{0:MMM d}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_UpcomingShifts}" Margin="0,16,0,0" DataContext="{Binding Profile}">
                        <ItemsControl ItemsSource="{Binding UpcomingShifts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHr:ShiftAssignmentDto}">
                                    <TextBlock Text="{Binding AssignedDate, StringFormat={}{0:MMM d, yyyy}}" Style="{StaticResource Rojan.TextStyle.Caption}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Hr_RecentCommissions}" Margin="0,16,0,32" DataContext="{Binding Profile}">
                        <ItemsControl ItemsSource="{Binding RecentCommissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHr:CommissionTransactionDto}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ServiceName}" Style="{StaticResource Rojan.TextStyle.Caption}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CommissionAmount, StringFormat={}{0:C}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
