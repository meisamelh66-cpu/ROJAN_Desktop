<UserControl x:Class="Rojan.Desktop.Presentation.Views.Salons.SalonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 1.2 Owner App Create Salon Flow. Not a list-plus-detail page
        like most modules - shows exactly one of two DashboardCard panels
        (read-only salon summary, or the create form), switched by
        HasSalon/NeedsSalon, the same "single boolean-driven content swap"
        shape CalendarPage's Day/Week toggle already establishes.
        DashboardWidget's State only ever reflects the load itself
        (Loading/Loaded/Error) - see SalonPageViewModel's own doc comment
        for why "no salon yet" is still Loaded, not Empty.
    -->
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Salon_Title}" />
        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.Salon_Subtitle}"
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="0,44,0,0" />

        <dashboardControls:DashboardWidget Grid.Row="2"
                                            Title="{x:Static loc:Strings.Salon_Title}"
                                            State="{Binding State}"
                                            ErrorMessage="{Binding ErrorMessage}"
                                            RetryCommand="{Binding LoadCommand}"
                                            Margin="0,24,0,0">
            <Grid>
                <!-- Panel A: the salon already exists - read-only summary. -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Salon_YourSalon}"
                                                  Visibility="{Binding HasSalon, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <shared:EntityAvatar EntityName="{Binding Salon.Name}" Size="40" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Salon.Name}" Style="{StaticResource Rojan.TextStyle.Display}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                                <shared:StatusPill Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <shared:StatusPill.Style>
                                        <Style TargetType="shared:StatusPill">
                                            <Setter Property="Text" Value="{x:Static loc:Strings.Common_Active}" />
                                            <Setter Property="Severity" Value="Success" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Salon.Active}" Value="False">
                                                    <Setter Property="Text" Value="{x:Static loc:Strings.Common_Inactive}" />
                                                    <Setter Property="Severity" Value="Neutral" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </shared:StatusPill.Style>
                                </shared:StatusPill>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBlock Text="{Binding Salon.Description}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Common_Phone}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBlock Text="{Binding Salon.Phone}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Common_Email}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBlock Text="{Binding Salon.Email}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Address}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBlock Text="{Binding Salon.Address}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Panel B: no salon yet - the create form. -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Salon_CreateSalon}"
                                                  Visibility="{Binding NeedsSalon, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Salon_CreatePrompt}"
                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Common_Name}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Common_Phone}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="{x:Static loc:Strings.Common_Email}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="{x:Static loc:Strings.Common_Address}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Text="{x:Static loc:Strings.Common_Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="60" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CreateErrorMessage}"
                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                   Foreground="{StaticResource Rojan.Brush.Error}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding HasCreateError, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="{x:Static loc:Strings.Salon_CreateSalon}"
                                Command="{Binding CreateSalonCommand}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>
            </Grid>
        </dashboardControls:DashboardWidget>
    </Grid>

</UserControl>
