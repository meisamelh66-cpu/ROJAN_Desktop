<UserControl x:Class="Rojan.Desktop.Presentation.Views.QrCodes.QrCodesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        QR Ecosystem (Desktop Productionization Sprint 1). Three QR cards
        side by side (Manager / Customer / Reception invite), same
        "DashboardWidget wraps arbitrary content" shape SalonPage already
        establishes - here the content is a 3-column Grid of DashboardCards
        instead of a single card. The Reception card is the only one with
        its own inner state (nothing generated yet vs. a real QR), same
        "boolean flag picks between two panel states" shape SalonPage's own
        HasSalon/NeedsSalon toggle already establishes.
    -->
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ByteArrayToBitmapImageConverter x:Key="ByteArrayToBitmapImageConverter" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.QrCodes_Title}" />
        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.QrCodes_Subtitle}"
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="0,44,0,0" />

        <dashboardControls:DashboardWidget Grid.Row="2"
                                            Title="{x:Static loc:Strings.QrCodes_Title}"
                                            State="{Binding State}"
                                            ErrorMessage="{Binding ErrorMessage}"
                                            RetryCommand="{Binding LoadCommand}"
                                            Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Manager QR - always available, generated client-side, no backend call. -->
                <dashboardControls:DashboardCard Grid.Column="0" Title="{x:Static loc:Strings.QrCodes_ManagerCardTitle}">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="ManagerQrImage"
                               Source="{Binding ManagerQrBytes, Converter={StaticResource ByteArrayToBitmapImageConverter}}"
                               Width="180" Height="180" Stretch="Uniform" />
                        <TextBlock Text="{x:Static loc:Strings.QrCodes_ManagerCardDescription}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Customer QR - real backend link to this salon's public booking page. -->
                <dashboardControls:DashboardCard Grid.Column="2" Title="{x:Static loc:Strings.QrCodes_CustomerCardTitle}">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="CustomerQrImage"
                               Source="{Binding CustomerQrBytes, Converter={StaticResource ByteArrayToBitmapImageConverter}}"
                               Width="180" Height="180" Stretch="Uniform" />
                        <TextBlock Text="{x:Static loc:Strings.QrCodes_CustomerCardDescription}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Reception invite QR - nothing until explicitly generated (a fresh, single-use backend invite token). -->
                <dashboardControls:DashboardCard Grid.Column="4" Title="{x:Static loc:Strings.QrCodes_ReceptionCardTitle}">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="ReceptionInviteQrImage"
                               Source="{Binding ReceptionInviteQrBytes, Converter={StaticResource ByteArrayToBitmapImageConverter}}"
                               Width="180" Height="180" Stretch="Uniform"
                               Visibility="{Binding HasReceptionInviteQr, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Visibility="{Binding HasReceptionInviteQr, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="{x:Static loc:Strings.QrCodes_NoInviteYet}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                       TextAlignment="Center"
                                       Width="180" Height="180"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding GenerateInviteErrorMessage}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.Error}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasGenerateInviteError, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="{x:Static loc:Strings.QrCodes_ReceptionCardDescription}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />

                        <Button Content="{x:Static loc:Strings.QrCodes_GenerateInvite}"
                                Command="{Binding GenerateReceptionInviteCommand}"
                                Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>
            </Grid>
        </dashboardControls:DashboardWidget>

        <Button Grid.Row="3"
                Content="{x:Static loc:Strings.QrCodes_Print}"
                Click="OnPrintClick"
                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                HorizontalAlignment="Left"
                Margin="0,16,0,0" />
    </Grid>

</UserControl>
