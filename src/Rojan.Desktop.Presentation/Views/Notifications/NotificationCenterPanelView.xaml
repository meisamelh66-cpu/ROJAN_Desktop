<UserControl x:Class="Rojan.Desktop.Presentation.Views.Notifications.NotificationCenterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notificationVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Notifications"
             xmlns:controlsNotifications="clr-namespace:Rojan.Desktop.Presentation.Controls.Notifications"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 27: Enterprise Notification Center panel - fills in the
        Phase 07 placeholder ("No producer exists yet... wired now so the
        panel shows the right thing the moment one does") with the real
        search/filter/group/read-unread/history/Silent-Mode UI the spec
        asks for. Reuses only existing theme tokens (Rojan.Style.Panel,
        Rojan.Style.ToggleSwitch, Rojan.TextStyle.*, severity brushes) -
        no new visual language introduced, per this phase's "match
        existing ROJAN theme" requirement.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter" />
            <converters:NotificationSeverityToIconConverter x:Key="SeverityToIconConverter" />
            <converters:NotificationSeverityToBrushConverter x:Key="SeverityToBrushConverter" />
            <converters:UnreadToFontWeightConverter x:Key="UnreadToFontWeightConverter" />
            <converters:SeverityFilterChipSelectedConverter x:Key="SeverityFilterChipSelectedConverter" />

            <Style x:Key="SeverityFilterChip" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextSecondary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="True">
                        <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                        <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: title + badge count + Silent Mode toggle -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Static loc:Strings.Common_Notifications}"
                       Style="{StaticResource Rojan.TextStyle.SectionHeader}"
                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static loc:Strings.Notification_SilentMode}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           ToolTip="{x:Static loc:Strings.Notification_SilentMode_Description}" />
                <ToggleButton Style="{StaticResource Rojan.Style.ToggleSwitch}"
                              IsChecked="{Binding IsSilentModeEnabled, Mode=TwoWay}"
                              ToolTip="{x:Static loc:Strings.Notification_SilentMode_Description}"
                              AutomationProperties.Name="{x:Static loc:Strings.Notification_SilentMode}" />
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Border Style="{StaticResource Rojan.Style.Panel}" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{StaticResource Rojan.Icon.Search}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" Foreground="{StaticResource Rojan.Brush.TextSecondary}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                         CaretBrush="{StaticResource Rojan.Brush.Accent}"
                         FontSize="12"
                         Margin="6,0,0,0"
                         Tag="{x:Static loc:Strings.Notification_Search_Placeholder}"
                         AutomationProperties.Name="{x:Static loc:Strings.Notification_Search_Placeholder}" />
            </Grid>
        </Border>

        <!-- Severity filter chips -->
        <ItemsControl ItemsSource="{Binding SeverityFilterOptions}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type notificationVm:NotificationSeverityFilterOption}">
                    <Button Content="{Binding Label}"
                            Style="{StaticResource SeverityFilterChip}"
                            Command="{Binding DataContext.SelectSeverityFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource SeverityFilterChipSelectedConverter}">
                                <Binding Path="." />
                                <Binding Path="DataContext.SelectedSeverityFilter" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Unread-only toggle + actions -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      Content="{x:Static loc:Strings.Notification_Filter_Unread}"
                      IsChecked="{Binding IsShowingUnreadOnly, Mode=TwoWay}"
                      VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Content="{x:Static loc:Strings.Notification_MarkAllRead}"
                    Command="{Binding MarkAllReadCommand}"
                    Style="{StaticResource Rojan.Style.ButtonOutlined}"
                    Padding="8,4"
                    FontSize="11"
                    Margin="0,0,6,0" />
            <Button Grid.Column="3"
                    Content="{x:Static loc:Strings.Notification_ClearAll}"
                    Command="{Binding ClearAllCommand}"
                    Style="{StaticResource Rojan.Style.ButtonOutlined}"
                    Padding="8,4"
                    FontSize="11" />
        </Grid>

        <!-- Grouped, filtered, searched list -->
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type notificationVm:NotificationGroupViewModel}">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding GroupLabel}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type notificationVm:NotificationRowViewModel}">
                                            <Border Style="{StaticResource Rojan.Style.Panel}" Padding="10" Margin="0,0,0,6" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding MarkAsReadCommand}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Severity, Converter={StaticResource SeverityToIconConverter}}"
                                                               FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"
                                                               FontSize="14"
                                                               VerticalAlignment="Top"
                                                               Margin="0,2,8,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock controlsNotifications:NotificationHighlightText.Text="{Binding Title}"
                                                                   controlsNotifications:NotificationHighlightText.Highlights="{Binding TitleHighlights}"
                                                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                                                   Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="{Binding IsRead, Converter={StaticResource UnreadToFontWeightConverter}}" />
                                                        <TextBlock controlsNotifications:NotificationHighlightText.Text="{Binding Message}"
                                                                   controlsNotifications:NotificationHighlightText.Highlights="{Binding MessageHighlights}"
                                                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding TimeAgoText}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.HintText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DismissCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Top"
                                                            ToolTip="{x:Static loc:Strings.Notification_Dismiss}"
                                                            AutomationProperties.Name="{x:Static loc:Strings.Notification_Dismiss}">
                                                        <TextBlock Text="{StaticResource Rojan.Icon.Close}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="9" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static loc:Strings.Notification_NoResults}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
