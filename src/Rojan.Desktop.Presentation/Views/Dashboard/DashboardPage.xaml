<UserControl x:Class="Rojan.Desktop.Presentation.Views.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboard="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Dashboard">

    <!--
        Phase 06A: layout/architecture only - built exclusively from the
        Design System's reusable components (GlassCard, GlassPanel,
        GlassButton, SectionHeader). No business logic, no backend, no
        persistence - every bound collection is static placeholder data
        from DashboardPageViewModel.

        Merges its own Theme.xaml dependency locally (same self-
        sufficiency rule as SectionHeader.xaml) so this page renders
        correctly regardless of what the consuming Application merged.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: welcome header, KPI cards, quick actions, recent activity -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">

                <!-- Welcome / header section -->
                <controls:SectionHeader Title="Dashboard" />
                <TextBlock Text="Here's what's happening today."
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Margin="0,4,0,0" />

                <!-- KPI cards region -->
                <ItemsControl ItemsSource="{Binding KpiCards}" Margin="0,24,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dashboard:KpiCardItem}">
                            <Border Style="{StaticResource Rojan.Style.GlassCard}"
                                    Width="220"
                                    Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBlock Text="{Binding Value}"
                                               Style="{StaticResource Rojan.TextStyle.HeroTitle}"
                                               Foreground="{StaticResource Rojan.Brush.ButtonText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Quick Actions region -->
                <Border Style="{StaticResource Rojan.Style.GlassPanel}"
                        Padding="24"
                        Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   Style="{StaticResource Rojan.TextStyle.CardTitle}"
                                   Foreground="{StaticResource Rojan.Brush.ButtonText}" />
                        <ItemsControl ItemsSource="{Binding QuickActions}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dashboard:QuickActionItem}">
                                    <Button Content="{Binding Label}"
                                            Style="{StaticResource Rojan.Style.GlassButton}"
                                            Command="{Binding DataContext.QuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,12,12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent Activity region -->
                <Border Style="{StaticResource Rojan.Style.GlassPanel}"
                        Padding="24"
                        Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Recent Activity"
                                   Style="{StaticResource Rojan.TextStyle.CardTitle}"
                                   Foreground="{StaticResource Rojan.Brush.ButtonText}" />
                        <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dashboard:ActivityItem}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Description}"
                                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                                   Foreground="{StaticResource Rojan.Brush.ButtonText}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Timestamp}"
                                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                                   Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Right: AI Assistant panel placeholder -->
            <Border Grid.Column="1"
                    Style="{StaticResource Rojan.Style.GlassCard}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="AI Assistant"
                               Style="{StaticResource Rojan.TextStyle.CardTitle}"
                               Foreground="{StaticResource Rojan.Brush.ButtonText}" />
                    <TextBlock Text="Coming soon."
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,16" />
                    <Button Content="Ask AI"
                            Style="{StaticResource Rojan.Style.GlassButton}"
                            IsEnabled="False"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>

</UserControl>
