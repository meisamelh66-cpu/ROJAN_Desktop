<UserControl x:Class="Rojan.Desktop.Presentation.Views.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:dashboardVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Dashboard"
             xmlns:appDashboard="clr-namespace:Rojan.Desktop.Application.Dashboard;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 06B: every placeholder Border/Style block from Phase 06A is
        replaced by the reusable Dashboard components (DashboardCard,
        DashboardWidget, WidgetHeader, KPIValue, TrendIndicator) built from
        the Design System. KpiMetrics/RecentActivity are real
        (fake-repository-backed) data flowing through
        IDashboardQueryService, not static placeholder collections -
        DashboardWidget reflects the ViewModel's DashboardState
        (Loading/Loaded/Empty/Error) for both. Quick Actions and the AI
        Assistant panel remain static (no repository data), so they use the
        state-less DashboardCard.

        Merges its own RojanTheme.xaml dependency locally (same self-sufficiency
        rule as every other Design System component).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/RojanTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: welcome header, KPI widget, quick actions, recent activity widget -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">

                <!-- Welcome / header section -->
                <controls:SectionHeader Title="{x:Static loc:Strings.Dashboard_Title}" />
                <TextBlock Text="{x:Static loc:Strings.Dashboard_Subtitle}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Margin="0,4,0,0" />

                <!-- KPI cards region -->
                <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Dashboard_KeyMetrics}"
                                                    State="{Binding State}"
                                                    ErrorMessage="{Binding ErrorMessage}"
                                                    RetryCommand="{Binding LoadCommand}"
                                                    Margin="0,24,0,0">
                    <ItemsControl ItemsSource="{Binding KpiMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appDashboard:KpiMetricDto}">
                                <dashboardControls:DashboardCard Width="200" Margin="0,0,16,16">
                                    <StackPanel>
                                        <dashboardControls:KPIValue Label="{Binding Label}" Value="{Binding Value}" />
                                        <dashboardControls:TrendIndicator Direction="{Binding TrendDirection}"
                                                                           Percentage="{Binding TrendPercentage}"
                                                                           Margin="0,8,0,0" />
                                    </StackPanel>
                                </dashboardControls:DashboardCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </dashboardControls:DashboardWidget>

                <!-- Quick Actions region: static, no repository data -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Dashboard_QuickActions}" Margin="0,24,0,0">
                    <ItemsControl ItemsSource="{Binding QuickActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dashboardVm:QuickActionItem}">
                                <Button Content="{Binding Label}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Command="{Binding DataContext.QuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,12,12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </dashboardControls:DashboardCard>

                <!-- Recent Activity region -->
                <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Dashboard_RecentActivity}"
                                                    State="{Binding State}"
                                                    ErrorMessage="{Binding ErrorMessage}"
                                                    RetryCommand="{Binding LoadCommand}"
                                                    Margin="0,24,0,0">
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appDashboard:ActivityEntryDto}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Description}"
                                               Style="{StaticResource Rojan.TextStyle.Body}"
                                               Foreground="{StaticResource Rojan.Brush.ButtonText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OccurredAt, StringFormat={}{0:t}}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </dashboardControls:DashboardWidget>

            </StackPanel>

            <!-- Right: AI Assistant panel placeholder - static, no repository data -->
            <dashboardControls:DashboardCard Grid.Column="1" Title="{x:Static loc:Strings.Dashboard_AiAssistant}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Dashboard_ComingSoon}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="{x:Static loc:Strings.Dashboard_AskAi}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            IsEnabled="False"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </dashboardControls:DashboardCard>

        </Grid>
    </ScrollViewer>

</UserControl>
