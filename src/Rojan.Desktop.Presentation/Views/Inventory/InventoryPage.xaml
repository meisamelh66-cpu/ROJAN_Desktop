<UserControl x:Class="Rojan.Desktop.Presentation.Views.Inventory.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:appInventory="clr-namespace:Rojan.Desktop.Application.Inventory;assembly=Rojan.Desktop.Application">

    <!--
        Phase 17: Enterprise Inventory & Product Management. Same
        master-detail shape as CustomerPage/SpecialistPage/ServicePage: a
        searchable product catalog plus a quick-add form (product,
        category, supplier) on the left, and the selected product's
        profile (details, stock level, transaction history, linked
        services) on the right, bound to
        InventoryPageViewModel.Profile (InventoryProfileViewModel), null
        when nothing is selected.

        Every card/widget here is DashboardCard/DashboardWidget/KPIValue -
        no new Design System components needed, same as every other
        module; every form control (TextBox/ComboBox) picks up its Fluent
        styling from Themes/Controls.xaml automatically (Phase 16), no
        per-page styling needed here.

        Merges its own RojanTheme.xaml dependency locally (same
        self-sufficiency rule as every other Design System component).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/RojanTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, low-stock summary, search, quick-add forms, product catalog -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:SectionHeader Grid.Row="0" Title="Inventory" />
                <TextBlock Grid.Row="0"
                           Text="Track products, stock levels, and supplier sourcing."
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Margin="0,44,0,0" />

                <!-- Low-stock monitoring summary -->
                <dashboardControls:DashboardCard Grid.Row="1" Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal">
                        <dashboardControls:KPIValue Label="Total Products" Value="{Binding Products.Count}" Margin="0,0,32,0" />
                        <dashboardControls:KPIValue Label="Low Stock Items" Value="{Binding LowStockCount}" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Quick-add: Category / Supplier -->
                <dashboardControls:DashboardCard Grid.Row="2" Title="Categories &amp; Suppliers" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                <Button Content="Add Category" Command="{Binding AddCategoryCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                <Button Content="Add Supplier" Command="{Binding AddSupplierCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- New Product -->
                <dashboardControls:DashboardCard Grid.Row="3" Title="New Product" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="SKU" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding NewProductSku, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Name" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="Category" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedNewProductCategory, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="Supplier" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <ComboBox ItemsSource="{Binding Suppliers}"
                                          SelectedItem="{Binding SelectedNewProductSupplier, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="Unit Price" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding NewProductUnitPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="Description" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding NewProductDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Initial Quantity" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding NewProductInitialQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reorder Threshold" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding NewProductReorderThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Add Product"
                                Command="{Binding CreateProductCommand}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Search + product list -->
                <Border Grid.Row="4"
                        Style="{StaticResource Rojan.Style.Panel}"
                        Padding="16,10"
                        Margin="0,16,0,0">
                    <Grid>
                        <TextBlock Text="Search by name, SKU, category, or description..."
                                   Foreground="{StaticResource Rojan.Brush.HintText}"
                                   FontFamily="{StaticResource Rojan.FontFamily.Default}"
                                   FontSize="15"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                 CaretBrush="{StaticResource Rojan.Brush.Accent}"
                                 FontFamily="{StaticResource Rojan.FontFamily.Default}"
                                 FontSize="15" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Right: product catalog list + selected product's profile -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock Text="Select a product to view its profile."
                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel DataContext="{Binding Profile}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Identity + category/supplier/status -->
                        <dashboardControls:DashboardCard Title="{Binding Product.Name}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                    <Run Text="{Binding Product.Sku, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Product.CategoryName, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Product.Status, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Product.Description}"
                                           Style="{StaticResource Rojan.TextStyle.Body}"
                                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,12,0,0">
                                    <Run Text="Supplier: " /><Run Text="{Binding Product.SupplierName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                    <Run Text="Unit Price: " /><Run Text="{Binding Product.UnitPrice, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                        <!-- Stock level + record a transaction -->
                        <dashboardControls:DashboardWidget Title="Stock"
                                                            State="{Binding State}"
                                                            ErrorMessage="{Binding ErrorMessage}"
                                                            RetryCommand="{Binding LoadCommand}"
                                                            Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <dashboardControls:KPIValue Label="On Hand" Value="{Binding Stock.QuantityOnHand}" Margin="0,0,32,0" />
                                    <dashboardControls:KPIValue Label="Reorder At" Value="{Binding Stock.ReorderThreshold}" />
                                </StackPanel>
                                <TextBlock Text="Stock is at or below its reorder threshold."
                                           Foreground="{StaticResource Rojan.Brush.Warning}"
                                           Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stock.IsLowStock}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Type" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <ComboBox ItemsSource="{Binding AvailableTransactionTypes}"
                                                  SelectedItem="{Binding SelectedTransactionType, Mode=TwoWay}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quantity" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        <TextBox Text="{Binding TransactionQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Notes" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding TransactionNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Record Transaction"
                                        Command="{Binding RecordTransactionCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />
                            </StackPanel>
                        </dashboardControls:DashboardWidget>

                        <!-- Recent transactions -->
                        <dashboardControls:DashboardCard Title="Recent Transactions" Margin="0,16,0,0">
                            <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appInventory:StockTransactionDto}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                                    <Run Text="{Binding Type, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Quantity, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Notes}"
                                                           Style="{StaticResource Rojan.TextStyle.Caption}"
                                                           Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding OccurredAt, StringFormat={}{0:MMM d}}"
                                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dashboardControls:DashboardCard>

                        <!-- Linked services (service-to-product mapping) -->
                        <dashboardControls:DashboardCard Title="Linked Services" Margin="0,16,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ServiceMappings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type appInventory:ServiceProductMappingDto}">
                                            <Border Background="{StaticResource Rojan.Brush.SurfaceHover}"
                                                    BorderBrush="{StaticResource Rojan.Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                                                    Padding="10,4"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.TextPrimary}">
                                                        <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                                        <Run Text=" ×" />
                                                        <Run Text="{Binding QuantityPerService, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Button Content="&#10005;"
                                                            Margin="8,0,0,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            FontSize="11"
                                                            Command="{Binding DataContext.UnmapServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewMappingServiceName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Text="{Binding NewMappingQuantityPerService, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                                    <Button Grid.Column="4"
                                            Content="Map"
                                            Command="{Binding MapServiceCommand}"
                                            Style="{StaticResource Rojan.Style.ButtonPrimary}" />
                                </Grid>
                            </StackPanel>
                        </dashboardControls:DashboardCard>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Product catalog list -->
            <dashboardControls:DashboardWidget Grid.Row="1"
                                                Title="All Products"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,16,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <ListBox ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appInventory:ProductDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding Sku, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding UnitPrice, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

    </Grid>

</UserControl>
