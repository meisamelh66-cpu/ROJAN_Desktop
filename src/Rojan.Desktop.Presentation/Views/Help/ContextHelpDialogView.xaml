<UserControl x:Class="Rojan.Desktop.Presentation.Views.Help.ContextHelpDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appHelp="clr-namespace:Rojan.Desktop.Application.Help;assembly=Rojan.Desktop.Application"
             xmlns:controlsHelp="clr-namespace:Rojan.Desktop.Presentation.Controls.Help"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 26.4/26.5: Context Help Dialog. Shown in Shell's existing
        dialog region (MainWindow.xaml's Dialog Grid + IDialogService),
        same rounded-corner/blur-scrim/soft-shadow chrome every other
        dialog in this app already gets for free from that region - see
        Views.Accounting.PosCheckoutView for the identical outer Border
        pattern this mirrors (Rojan.Brush.SurfaceElevated +
        Rojan.CornerRadius.Large + Rojan.Effect.ElevationDialog). ESC and
        outside-click-to-close are wired in Shell/MainWindow, scoped to
        this dialog only (see MainWindowViewModel.OpenHelpCommand's doc
        comment) so no other dialog's behavior changes. Focus trapping
        (Tab/Shift+Tab cycling, initial focus on open) is self-contained
        in this View's own code-behind - see ContextHelpDialogView.xaml.cs.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BreadcrumbJoinConverter x:Key="BreadcrumbJoinConverter" />
            <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="HelpSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.SectionHeader}">
                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
                <Setter Property="Margin" Value="0,16,0,4" />
            </Style>

            <Style x:Key="HelpBodyText" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HelpBulletItem" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- Small ghost icon button (Close/Back/Forward/Favorite) - same 28x28 circular chrome as Controls.Help.HelpButton, just with a swappable glyph. -->
            <Style x:Key="HelpIconButton" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Rojan.CornerRadius.Pill}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Rojan.Brush.SurfaceHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Rojan.Brush.SurfacePressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource Rojan.Brush.SurfaceElevated}"
            BorderBrush="{StaticResource Rojan.Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Rojan.CornerRadius.Large}"
            Effect="{StaticResource Rojan.Effect.ElevationDialog}"
            Width="680"
            MaxHeight="760"
            Padding="24"
            FocusVisualStyle="{x:Null}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header: back/forward, title, favorite, close -->
                <RowDefinition Height="Auto" />
                <!-- Breadcrumb -->
                <RowDefinition Height="Auto" />
                <!-- Search box -->
                <RowDefinition Height="*" />
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource HelpIconButton}"
                        Command="{Binding BackCommand}"
                        ToolTip="{x:Static loc:Strings.Help_Nav_Back}"
                        AutomationProperties.Name="{x:Static loc:Strings.Help_Nav_Back}">
                    <TextBlock Text="{StaticResource Rojan.Icon.Back}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="13" Foreground="{StaticResource Rojan.Brush.TextSecondary}" />
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource HelpIconButton}"
                        Command="{Binding ForwardCommand}"
                        Margin="4,0,0,0"
                        ToolTip="{x:Static loc:Strings.Help_Nav_Forward}"
                        AutomationProperties.Name="{x:Static loc:Strings.Help_Nav_Forward}">
                    <TextBlock Text="{StaticResource Rojan.Icon.Forward}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="13" Foreground="{StaticResource Rojan.Brush.TextSecondary}" />
                </Button>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentContent.Title}"
                           Style="{StaticResource Rojan.TextStyle.Title}"
                           Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="3"
                        Style="{StaticResource HelpIconButton}"
                        Command="{Binding ToggleFavoriteCommand}"
                        ToolTip="{x:Static loc:Strings.Help_Nav_AddFavorite}"
                        AutomationProperties.Name="{x:Static loc:Strings.Help_Nav_AddFavorite}">
                    <TextBlock FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{StaticResource Rojan.Icon.FavoriteOutline}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextSecondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Text" Value="{StaticResource Rojan.Icon.FavoriteFilled}" />
                                        <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Grid.Column="4"
                        x:Name="CloseButton"
                        Style="{StaticResource HelpIconButton}"
                        Command="{Binding CloseCommand}"
                        Margin="4,0,0,0"
                        ToolTip="{x:Static loc:Strings.Common_Close}"
                        AutomationProperties.Name="{x:Static loc:Strings.Common_Close}">
                    <TextBlock Text="{StaticResource Rojan.Icon.Close}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" Foreground="{StaticResource Rojan.Brush.TextSecondary}" />
                </Button>
            </Grid>

            <!-- Breadcrumb -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Breadcrumbs, Converter={StaticResource BreadcrumbJoinConverter}}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,8,0,0" />

            <!-- Search box -->
            <Border Grid.Row="2"
                    Style="{StaticResource Rojan.Style.Panel}"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{StaticResource Rojan.Icon.Search}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="14" Foreground="{StaticResource Rojan.Brush.TextSecondary}" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                             CaretBrush="{StaticResource Rojan.Brush.Accent}"
                             FontFamily="{StaticResource Rojan.FontFamily.Default}"
                             FontSize="14"
                             Margin="8,0,0,0"
                             Tag="{x:Static loc:Strings.Help_Search_Placeholder}"
                             AutomationProperties.Name="{x:Static loc:Strings.Help_Search_Placeholder}" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="3" Margin="0,8,0,0">

                <!-- Search results -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Help_Search_NoResults}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HelpBodyText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appHelp:HelpSearchResultDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="12" Margin="0,0,0,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Rojan.TextStyle.SectionHeader}" Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                                       controlsHelp:HighlightText.Text="{Binding Title}"
                                                       controlsHelp:HighlightText.Highlights="{Binding TitleHighlights}" />
                                            <TextBlock Style="{StaticResource HelpBodyText}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,4,0,0"
                                                       controlsHelp:HighlightText.Text="{Binding Snippet}"
                                                       controlsHelp:HighlightText.Highlights="{Binding SnippetHighlights}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Topic content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{Binding CurrentContent.Subtitle}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentContent.Description}" Style="{StaticResource HelpBodyText}" Margin="0,8,0,0" />

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Purpose}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.Purpose, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <TextBlock Text="{Binding CurrentContent.Purpose}" Style="{StaticResource HelpBodyText}" Visibility="{Binding CurrentContent.Purpose, Converter={StaticResource CollectionToVisibilityConverter}}" />

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Overview}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.Overview, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <TextBlock Text="{Binding CurrentContent.Overview}" Style="{StaticResource HelpBodyText}" Visibility="{Binding CurrentContent.Overview, Converter={StaticResource CollectionToVisibilityConverter}}" />

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_WhenToUse}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.WhenToUse, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <TextBlock Text="{Binding CurrentContent.WhenToUse}" Style="{StaticResource HelpBodyText}" Visibility="{Binding CurrentContent.WhenToUse, Converter={StaticResource CollectionToVisibilityConverter}}" />

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Steps}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.Steps, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CurrentContent.Steps}" Visibility="{Binding CurrentContent.Steps, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource HelpBulletItem}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Tips}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.Tips, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CurrentContent.Tips}" Visibility="{Binding CurrentContent.Tips, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource HelpBulletItem}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Warnings}" Style="{StaticResource HelpSectionHeader}" Foreground="{StaticResource Rojan.Brush.Warning}" Visibility="{Binding CurrentContent.Warnings, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CurrentContent.Warnings}" Visibility="{Binding CurrentContent.Warnings, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource HelpBulletItem}" Foreground="{StaticResource Rojan.Brush.Warning}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_BestPractices}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.BestPractices, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CurrentContent.BestPractices}" Visibility="{Binding CurrentContent.BestPractices, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource HelpBulletItem}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Notes}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.Notes, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CurrentContent.Notes}" Visibility="{Binding CurrentContent.Notes, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource HelpBulletItem}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_Shortcuts}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding CurrentContent.Shortcuts, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CurrentContent.Shortcuts}" Visibility="{Binding CurrentContent.Shortcuts, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="{StaticResource Rojan.Brush.SurfaceHover}" CornerRadius="{StaticResource Rojan.CornerRadius.Small}" Padding="6,2">
                                            <TextBlock Text="{Binding KeysDisplay}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                                        </Border>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource HelpBodyText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.Help_Section_RelatedTopics}" Style="{StaticResource HelpSectionHeader}" Visibility="{Binding RelatedTopics, Converter={StaticResource CollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding RelatedTopics}" Visibility="{Binding RelatedTopics, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource Rojan.TextStyle.Hyperlink}"
                                               Cursor="Hand"
                                               Margin="0,0,0,4">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.NavigateToTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TopicId}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Phase 26.9 AI-Ready Architecture: extension-point placeholder only, no AI implementation. -->
                        <TextBlock Text="{x:Static loc:Strings.Help_Section_AiSuggestions}" Style="{StaticResource HelpSectionHeader}" />
                        <TextBlock Text="{x:Static loc:Strings.Help_AiSuggestions_ComingSoon}" Style="{StaticResource HelpBodyText}" Foreground="{StaticResource Rojan.Brush.MutedText}" FontStyle="Italic" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Loading overlay -->
                <Border Background="{StaticResource Rojan.Brush.SurfaceElevated}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Static loc:Strings.Common_Loading}" Style="{StaticResource HelpBodyText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
