<UserControl x:Class="Rojan.Desktop.Presentation.Views.Accounting.PosCheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accountingVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Accounting"
             xmlns:appAccounting="clr-namespace:Rojan.Desktop.Application.Accounting;assembly=Rojan.Desktop.Application"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters">

    <!--
        Phase 18: Enterprise POS & Accounting Foundation. Shown in Shell's
        dialog region (see MainWindow.xaml's Dialog region + IDialogService),
        same wizard-dialog shape as BookingWorkflow.BookingWizardView: a
        linear, step-by-step flow - Cart -> Payment -> Receipt. Fulfils both
        the "POS checkout page" and "Payment dialog" deliverables in one
        dialog surface (see PosCheckoutStep's own doc comment). Forward-only
        (no Back button): once the cart becomes an invoice at the Payment
        step, going back would mean un-creating it, so the flow does not
        offer that - same reasoning BookingWizardView disables Back once at
        Confirmation.

        Merges its own RojanTheme.xaml dependency locally (same
        self-sufficiency rule as every other Design System component).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/RojanTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumAtLeastConverter x:Key="EnumAtLeastConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Rojan.Brush.SurfaceElevated}"
            BorderBrush="{StaticResource Rojan.Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Rojan.CornerRadius.Large}"
            Effect="{StaticResource Rojan.Effect.ElevationDialog}"
            Width="560"
            MaxHeight="680"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Title -->
                <RowDefinition Height="Auto" />
                <!-- Step indicator -->
                <RowDefinition Height="Auto" />
                <!-- Step label / error -->
                <RowDefinition Height="*" />
                <!-- Step content -->
                <RowDefinition Height="Auto" />
                <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="New Sale" Style="{StaticResource Rojan.TextStyle.SectionHeader}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />

            <!-- Step indicator: 3 segments, accent-filled up to and including the current step. -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{StaticResource Rojan.Brush.Accent}" />
                <Border Grid.Column="2" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Payment" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="4" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Receipt" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Rojan.Brush.Error}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="440" Margin="0,16,0,0">
                <Grid>

                    <!-- Step: Cart -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Cart">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Customer" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <ComboBox ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  DisplayMemberPath="FullName"
                                  Margin="0,4,0,0" />

                        <TextBlock Text="Booking (optional)" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding Bookings}"
                                  SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                                  DisplayMemberPath="Reference"
                                  Margin="0,4,0,0" />

                        <TextBlock Text="Add a product" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,16,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProductToAdd, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />
                            <TextBox Grid.Column="2" Text="{Binding ProductQuantityToAdd, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4" Content="Add" Command="{Binding AddProductCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" />
                        </Grid>

                        <TextBlock Text="Add a service" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,16,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Services}"
                                      SelectedItem="{Binding SelectedServiceToAdd, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />
                            <TextBox Grid.Column="2" Text="{Binding ServiceQuantityToAdd, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4" Content="Add" Command="{Binding AddServiceCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" />
                        </Grid>

                        <TextBlock Text="Cart" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type accountingVm:PosCartLine}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                            <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                <Run Text="{Binding Quantity, Mode=OneWay}" />
                                                <Run Text=" × " />
                                                <Run Text="{Binding UnitPrice, StringFormat={}{0:C}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LineTotal, StringFormat={}{0:C}}"
                                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Button Grid.Column="2"
                                                Content="&#10005;"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                <Run Text="Subtotal: " /><Run Text="{Binding Subtotal, StringFormat={}{0:C}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                <Run Text="Tax: " /><Run Text="{Binding TaxAmount, StringFormat={}{0:C}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Subtitle}" Margin="0,4,0,0">
                                <Run Text="Total: " /><Run Text="{Binding Total, StringFormat={}{0:C}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step: Payment -->
                    <StackPanel DataContext="{Binding}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Payment">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8">
                            <Run Text="Amount due: " /><Run Text="{Binding CreatedInvoice.Total, StringFormat={}{0:C}, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="Payment method" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding AvailablePaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                  Margin="0,4,0,0" />

                        <TextBlock Text="Amount tendered" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,12,0,0">
                            <Run Text="Change due: " /><Run Text="{Binding ChangeDue, StringFormat={}{0:C}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Step: Receipt -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Receipt">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{StaticResource Rojan.Icon.CheckCircle}"
                                       FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                       FontSize="20"
                                       Foreground="{StaticResource Rojan.Brush.Success}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Payment recorded" Style="{StaticResource Rojan.TextStyle.SectionHeader}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                            <Run Text="Customer: " /><Run Text="{Binding CreatedInvoice.CustomerName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="Paid: " /><Run Text="{Binding RecordedPayment.Amount, StringFormat={}{0:C}, Mode=OneWay}" />
                            <Run Text=" via " /><Run Text="{Binding RecordedPayment.Method, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="Invoice total: " /><Run Text="{Binding CreatedInvoice.Total, StringFormat={}{0:C}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="Change due: " /><Run Text="{Binding ChangeDue, StringFormat={}{0:C}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Payment">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Receipt">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Proceed to Payment" Command="{Binding ProceedToPaymentCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonPrimary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Cart">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Charge" Command="{Binding ChargeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonPrimary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Payment">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Done" Command="{Binding DoneCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonPrimary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Receipt">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
