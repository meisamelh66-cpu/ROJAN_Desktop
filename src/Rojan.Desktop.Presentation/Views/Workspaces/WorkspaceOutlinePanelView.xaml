<UserControl x:Class="Rojan.Desktop.Presentation.Views.Workspaces.WorkspaceOutlinePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Workspaces"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!-- Phase 29's flagship dockable panel: every open tab across every secondary pane, plus every floating window - click to focus, click "x" to close. -->
    <UserControl.Resources>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Entries, Converter={StaticResource CollectionToVisibilityConverter}}">
            <ItemsControl Margin="4" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type wsVm:WorkspaceOutlineEntry}">
                        <Border Background="Transparent" Padding="8,6" Cursor="Hand" CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" Foreground="{StaticResource Rojan.Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{StaticResource Rojan.Icon.Workspace}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource Rojan.Icon.FloatOut}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        Cursor="Hand"
                                        ToolTip="{x:Static loc:Strings.Workspace_Outline_CloseTooltip}"
                                        AutomationProperties.Name="{x:Static loc:Strings.Workspace_Outline_CloseTooltip}">
                                    <TextBlock Text="{StaticResource Rojan.Icon.Dismiss}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="10" Foreground="{StaticResource Rojan.Brush.TextSecondary}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{x:Static loc:Strings.Workspace_Outline_Empty}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="12"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
