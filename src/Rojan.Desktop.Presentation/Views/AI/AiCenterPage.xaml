<UserControl x:Class="Rojan.Desktop.Presentation.Views.AI.AiCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:aiVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.AI"
             xmlns:appAi="clr-namespace:Rojan.Desktop.Application.AI;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 21: ROJAN AI Center. Same master-shape as Reporting/Analytics -
        a local section switcher (Home/Chat/Insights/Recommendations/
        History/Settings) with one section visible at a time. Home hosts
        the Business Health Score + Daily Summary + Smart Notifications;
        Insights is the Trend/Risk/Opportunity detection surface across
        every business area; Recommendations hosts the Action Center's
        suggested tasks; History is the Conversation Viewer (search, pin,
        export, clear); Settings hosts the Model Selector, feature toggles,
        Usage Dashboard, and Prompt Templates. Chat never blocks the UI
        thread - IsSending disables Send while the (Mock) provider replies.

        Localization Audit completion pass: fully localized (Strings.*
        for every literal, Rojan.Converter.EnumLabel for every enum
        display) - previously deferred as this app's largest
        hardcoded-string surface alongside HrPage.xaml; see
        docs/phases/phase-24-localization-audit-completion.md.
    -->
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Ai_Title}" />
        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.Ai_Subtitle}"
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="0,44,0,0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{x:Static loc:Strings.Ai_Section_Home}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static aiVm:AiCenterSection.Home}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Home">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static loc:Strings.Ai_Section_Chat}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static aiVm:AiCenterSection.Chat}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Chat">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static loc:Strings.Ai_Section_Insights}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static aiVm:AiCenterSection.Insights}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Insights">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static loc:Strings.Ai_Section_Recommendations}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static aiVm:AiCenterSection.Recommendations}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Recommendations">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static loc:Strings.Ai_Section_History}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static aiVm:AiCenterSection.History}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="History">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static loc:Strings.Ai_Section_Settings}" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static aiVm:AiCenterSection.Settings}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Settings">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <Grid>

                <!-- Section: Home -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Home">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Ai_BusinessHealthScore}" State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}">
                        <StackPanel DataContext="{Binding HealthScore}">
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Display}">
                                <Run Text="{Binding OverallScore, Mode=OneWay, StringFormat='{}{0:N1}'}" />
                                <Run Text=" / 100" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding Components}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appAi:BusinessHealthComponentDto}">
                                        <Border Style="{StaticResource Rojan.Style.Panel}" Padding="12,8" Margin="0,0,8,8">
                                            <TextBlock>
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                <Run Text=": " Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                <Run Text="{Binding Score, Mode=OneWay, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_DailySummary}" Margin="0,16,0,0">
                        <StackPanel DataContext="{Binding DailySummary}">
                            <TextBlock Text="{Binding NarrativeText}" Style="{StaticResource Rojan.TextStyle.Caption}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Highlights}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_SmartNotifications}" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:SmartNotificationDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Message}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Severity, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>
                </StackPanel>

                <!-- Section: Chat -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Chat">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_BusinessAssistant}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CurrentSessionTitle}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{x:Static loc:Strings.Ai_NewConversation}" Command="{Binding NewConversationCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" />
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Messages}" MaxHeight="420">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appAi:ConversationMessageDto}">
                                        <Border Style="{StaticResource Rojan.Style.Panel}" Padding="12,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Role, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                <TextBlock Text="{Binding Content}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Send}" Command="{Binding SendMessageCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </dashboardControls:DashboardCard>
                </StackPanel>

                <!-- Section: Insights -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Insights">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Ai_InsightDashboard}" State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}">
                        <ItemsControl ItemsSource="{Binding Insights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:AIInsightDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Category, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardWidget>
                </StackPanel>

                <!-- Section: Recommendations -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Recommendations">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_RecommendationsPanel}">
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:AIRecommendationDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Priority, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" FontWeight="SemiBold" />
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SuggestedAction}" Style="{StaticResource Rojan.TextStyle.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_ActionCenterSuggestedTasks}" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding SuggestedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:SuggestedTaskDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{Binding Category, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Priority, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SuggestedDueDate, Mode=OneWay, StringFormat='{}{0:d}'}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>
                </StackPanel>

                <!-- Section: History -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="History">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_SearchConversations}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Search}" Command="{Binding SearchHistoryCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0" />
                                <Button Grid.Column="2" Content="{x:Static loc:Strings.Ai_ClearHistory}" Command="{Binding ClearHistoryCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appAi:ConversationSessionDto}">
                                        <Border Style="{StaticResource Rojan.Style.Panel}" Padding="12,8" Margin="0,0,0,8" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_PinnedConversations}" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding PinnedSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:ConversationSessionDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Cursor="Hand">
                                                <StackPanel.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </StackPanel.InputBindings>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding UpdatedAt, Mode=OneWay, StringFormat='{}{0:g}'}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Export}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ExportSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Reporting_Unpin}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="{x:Static loc:Strings.Common_Delete}" Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_RecentConversations}" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:ConversationSessionDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Cursor="Hand">
                                                <StackPanel.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </StackPanel.InputBindings>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding UpdatedAt, Mode=OneWay, StringFormat='{}{0:g}'}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Export}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ExportSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Reporting_Pin}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="{x:Static loc:Strings.Common_Delete}" Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_ExportPreview}" Margin="0,16,0,0">
                        <TextBox Text="{Binding ExportPreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="240" VerticalScrollBarVisibility="Auto" />
                    </dashboardControls:DashboardCard>
                </StackPanel>

                <!-- Section: Settings -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_FeatureToggles}">
                        <StackPanel>
                            <CheckBox Content="{x:Static loc:Strings.Ai_Section_Insights}" IsChecked="{Binding InsightsEnabled}" Margin="0,0,0,8" />
                            <CheckBox Content="{x:Static loc:Strings.Ai_SmartNotifications}" IsChecked="{Binding SmartNotificationsEnabled}" Margin="0,0,0,8" />
                            <CheckBox Content="{x:Static loc:Strings.Ai_DailySummary}" IsChecked="{Binding DailySummaryEnabled}" Margin="0,0,0,8" />
                            <CheckBox Content="{x:Static loc:Strings.Ai_AutoGenerateRecommendations}" IsChecked="{Binding AutoGenerateRecommendations}" Margin="0,0,0,8" />
                            <Button Content="{x:Static loc:Strings.Ai_SaveSettings}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_ModelSelector}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Ai_Provider}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding AvailableProviderTypes}" SelectedItem="{Binding SelectedProviderType}" Margin="0,4,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{x:Static loc:Strings.Ai_ModelId}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding ModelIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                            <CheckBox Content="{x:Static loc:Strings.Common_Enabled}" IsChecked="{Binding IsProviderEnabled}" Margin="0,0,0,12" />
                            <Button Content="{x:Static loc:Strings.Ai_SaveModelConfiguration}" Command="{Binding SaveConfigurationCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_UsageDashboard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                <Run Text="{x:Static loc:Strings.Ai_TotalTokensUsed}" />
                                <Run Text=": " />
                                <Run Text="{Binding TotalTokens, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding UsageHistory}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appAi:TokenUsageRecordDto}">
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,0,0,4">
                                            <Run Text="{Binding RecordedAt, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ProviderType, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding TotalTokens, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{x:Static loc:Strings.Ai_Tokens}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Ai_PromptTemplates}" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appAi:PromptTemplateDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="12,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Category, Converter={StaticResource Rojan.Converter.EnumLabel}}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
