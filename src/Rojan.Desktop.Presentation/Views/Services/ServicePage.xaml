<UserControl x:Class="Rojan.Desktop.Presentation.Views.Services.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:appServices="clr-namespace:Rojan.Desktop.Application.Services;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 13: Service Catalog & Availability Foundation. Same
        master-detail shape as CustomerPage/SpecialistPage: a searchable
        catalog on the left, and the selected service's profile (category,
        duration/price, description, assigned specialists) on the right,
        bound to ServicePageViewModel.Profile (ServiceProfileViewModel),
        null when nothing is selected. No "Add Service" form (unlike
        Customers/Bookings/Specialists) - catalog authoring wasn't
        requested for this phase, only browse/search plus specialist
        assignment.

        Every card/widget here is DashboardCard/DashboardWidget/KPIValue -
        no new Design System components needed, same as every other module.

        Sprint 5 Commit 2 (Premium Service Search &amp; Filters): the plain
        search box became a Search &amp; Filter DashboardCard - free text
        plus category/status/duration-range/price-range, combined by the
        ViewModel into one ServiceSearchFilter, same minimal-functional-
        controls-only shape Customers'/Bookings' own Commit 2 passes
        already established (plain TextBox/ComboBox rows, no Premium
        controls, no visual redesign). A ResultCount caption was added
        below the panel; the list/detail layout and the specialist-
        assignment card on the right are otherwise unchanged.

        Sprint 5 Commit 5C: added an Intelligence section below Assigned
        Specialists - Popularity Score/Completed/Upcoming as StatTiles,
        Popularity Level/Recommendation as StatusPills (two local
        *PillStyle resources below, same one-shared-style-per-enum
        reasoning CustomerPage's LoyaltyLevel/EngagementStatus pills
        established), reusing the shared:StatTile/shared:StatusPill
        controls already imported by this file (see the Duration/Price
        KPIValue tiles above). Every value is
        ServiceProfileViewModel.PopularityScore/PopularityLevel/
        RecommendationSignal/CompletedBookingCount/UpcomingBookingCount,
        requested from Application's IIntelligenceEngine and bound as-is -
        no calculation happens in this view or its ViewModel.

        Service Catalog Authoring: added an "Add Service" form (mirroring
        SpecialistPage's own "New Specialist" section - same DashboardCard/
        TextBox/Grid shape, no new control), and made the profile panel's
        Name/Description/Duration/Price editable with a Save button plus a
        Deactivate button (enabled only while the service is Active - the
        one supported transition). Category is shown read-only in both
        places - there is no category picker on Edit, since Backend has no
        contract to change it once a service is created (see
        Domain.Services.Service.CategoryId's own doc comment). Both forms
        share the same inline, non-destructive error-message idiom already
        shipped for Specialists (SaveErrorMessage/HasSaveError).
    -->
    <UserControl.Resources>
        <!-- Sprint 5 Commit 5C: ServicePopularityLevel/ServiceRecommendationSignal severity mapping - a display-only color choice, not a recalculation of the level/signal itself. -->
        <Style x:Key="ServicePopularityLevelPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PopularityLevel}" Value="Standard">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PopularityLevel}" Value="Trending">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PopularityLevel}" Value="Popular">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServiceRecommendationSignalPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Feature">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Maintain">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Monitor">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Reconsider">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, search &amp; filter, service catalog -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Services_Title}" />
            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Services_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <!-- Add Service (Service Catalog Authoring): the Create command's one Presentation entry point - same shape as Specialists' own "Add Specialist" card. -->
            <dashboardControls:DashboardCard Grid.Row="1" Title="{x:Static loc:Strings.Services_AddService}" Margin="0,24,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Services_Category}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <ComboBox ItemsSource="{Binding AvailableCategories}"
                                  SelectedItem="{Binding SelectedCategoryForNewService, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Name}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Common_Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewServiceDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Duration}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewServiceDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Common_Price}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewServicePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="{x:Static loc:Strings.Services_AddService}"
                            Command="{Binding CreateServiceCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />

                    <!-- Inline, non-destructive create-failure message - same idiom as Specialists' SaveErrorMessage/HasSaveError. -->
                    <TextBlock Text="{Binding CreateErrorMessage}"
                               Foreground="{StaticResource Rojan.Brush.Error}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCreateError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </dashboardControls:DashboardCard>

            <!-- Search & Filter: free text plus category/status/duration/price, combined by the ViewModel into one ServiceSearchFilter -->
            <dashboardControls:DashboardCard Grid.Row="2" Title="{x:Static loc:Strings.Services_SearchAndFilter}" Margin="0,24,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Common_Search}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Category}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding AvailableCategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="0,4,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{x:Static loc:Strings.Services_AllCategories}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Common_Status}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding AvailableStatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" Margin="0,4,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{x:Static loc:Strings.Services_AllStatuses}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Services_MinDuration}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding MinDuration, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Services_MaxDuration}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding MaxDuration, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Services_MinPrice}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Services_MaxPrice}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center">
                            <Run Text="{x:Static loc:Strings.Services_ResultsCount}" />
                            <Run Text=": " />
                            <Run Text="{Binding ResultCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="{x:Static loc:Strings.Services_ClearFilters}"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource Rojan.Style.ButtonSecondary}" />
                    </Grid>
                </StackPanel>
            </dashboardControls:DashboardCard>

            <dashboardControls:DashboardWidget Grid.Row="3"
                                                Title="{x:Static loc:Strings.Services_AllServices}"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,24,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                    <ListBox ItemsSource="{Binding Services}"
                             SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appServices:ServiceDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding Category, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding DurationMinutes, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{x:Static loc:Strings.Common_MinutesShort}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Price, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

        <!-- Right: selected service's profile - category, duration/price, description, assigned specialists -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <shared:EmptyStateCard Icon="{StaticResource Rojan.Icon.Services}"
                                        Message="{x:Static loc:Strings.Services_SelectPrompt}"
                                        VerticalAlignment="Center">
                    <shared:EmptyStateCard.Style>
                        <Style TargetType="{x:Type shared:EmptyStateCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </shared:EmptyStateCard.Style>
                </shared:EmptyStateCard>

                <StackPanel DataContext="{Binding Profile}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Identity + category/status -->
                    <dashboardControls:DashboardCard Title="{Binding Service.Name}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                <Run Text="{Binding Service.Category, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Service.Status, Mode=OneWay, Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Service.Description}"
                                       Style="{StaticResource Rojan.TextStyle.Body}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Editable details (Service Catalog Authoring): Name/Description/Duration/Price, committed by
                         SaveChangesCommand; category is read-only (Service.Category above) - there is no picker
                         here, Backend's update contract has no field to change it once a service is created. -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Services_Details}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Common_Name}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{x:Static loc:Strings.Common_Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding EditableDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.Common_Duration}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding EditableDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static loc:Strings.Common_Price}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <TextBox Text="{Binding EditablePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{x:Static loc:Strings.Common_SaveChanges}"
                                        Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}" />
                                <Button Content="{x:Static loc:Strings.Services_Deactivate}"
                                        Command="{Binding DeactivateCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                        Margin="12,0,0,0" />
                            </StackPanel>

                            <!-- Inline, non-destructive Save/Deactivate-failure message - shared by both actions,
                                 same idiom as Specialists' own SaveErrorMessage/HasSaveError. -->
                            <TextBlock Text="{Binding SaveErrorMessage}"
                                       Foreground="{StaticResource Rojan.Brush.Error}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <!-- Assigned specialists -->
                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Services_AssignedSpecialists}" Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding AssignedSpecialists}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appServices:AssignedSpecialistDto}">
                                        <Border Background="{StaticResource Rojan.Brush.SurfaceHover}"
                                                BorderBrush="{StaticResource Rojan.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                                                Padding="10,4"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SpecialistName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                                                <Button Content="&#10005;"
                                                        Margin="8,0,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="11"
                                                        Command="{Binding DataContext.UnassignSpecialistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Text="{Binding NewSpecialistName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                <Button Content="{x:Static loc:Strings.Services_Assign}"
                                        Command="{Binding AssignSpecialistCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Intelligence (Sprint 5 Commit 5C): calculated popularity score/level/recommendation, composed by Application's IntelligenceEngine from booking data already queried elsewhere in the app - no new query added here, only display. -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Services_Intelligence}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.Sparkle}"
                                                      Label="{x:Static loc:Strings.Services_PopularityScore}"
                                                      Value="{Binding PopularityScore}" />
                                </Border>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.CheckCircle}"
                                                      Label="{x:Static loc:Strings.Services_CompletedBookings}"
                                                      Value="{Binding CompletedBookingCount}" />
                                </Border>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.TrendUp}"
                                                      Label="{x:Static loc:Strings.Services_UpcomingBookings}"
                                                      Value="{Binding UpcomingBookingCount}" />
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.Services_PopularityLevel}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <shared:StatusPill Text="{Binding PopularityLevel, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource ServicePopularityLevelPillStyle}"
                                                        Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static loc:Strings.Services_RecommendationSignal}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <shared:StatusPill Text="{Binding RecommendationSignal, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource ServiceRecommendationSignalPillStyle}"
                                                        Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
