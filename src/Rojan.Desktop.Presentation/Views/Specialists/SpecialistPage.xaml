<UserControl x:Class="Rojan.Desktop.Presentation.Views.Specialists.SpecialistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:appSpecialists="clr-namespace:Rojan.Desktop.Application.Specialists;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 12: Specialist Management Foundation. Same master-detail
        shape as CustomerPage: a searchable specialist directory plus a
        new-specialist form on the left, and the selected specialist's
        profile (status editor + skills) on the right, bound to
        SpecialistPageViewModel.Profile (SpecialistProfileViewModel), null
        when nothing is selected. No notes/timeline (unlike Customer 360) -
        not requested for Specialists, keeping this foundation-scoped.

        Every card/widget here is DashboardCard/DashboardWidget/KPIValue -
        no new Design System components needed, same as every other module.

        Sprint 5 Commit 4 (Premium Specialist Search &amp; Profile
        foundation): the plain search box became a Search &amp; Filter
        DashboardCard - free text plus status/skill, combined by the
        ViewModel into one SpecialistSearchFilter, same minimal-functional-
        controls-only shape Customers'/Bookings'/Services' own search
        commits already established (plain TextBox/ComboBox rows, no
        Premium controls, no visual redesign - that belongs to a later
        pass). The list/detail layout and the skills card on the right are
        otherwise unchanged.

        Sprint 5 Commit 5C: added an Intelligence section below Skills -
        Performance Score/Completed/Cancelled/No-Show as StatTiles,
        Performance Level/Recommendation as StatusPills (two local
        *PillStyle resources below, same one-shared-style-per-enum
        reasoning CustomerPage's LoyaltyLevel/EngagementStatus pills
        established), reusing the Sprint 1 Shared Premium controls
        (shared:StatTile/shared:StatusPill) the same way CustomerPage's own
        Insights section does. Every value is
        SpecialistProfileViewModel.PerformanceScore/PerformanceLevel/
        RecommendationSignal/CompletedBookingCount/CancelledBookingCount/
        NoShowBookingCount, requested from Application's IIntelligenceEngine
        and bound as-is - no calculation happens in this view or its
        ViewModel.
    -->
    <UserControl.Resources>
        <!-- Sprint 5 Commit 5C: SpecialistPerformanceLevel/SpecialistRecommendationSignal severity mapping - a display-only color choice, not a recalculation of the level/signal itself. -->
        <Style x:Key="SpecialistPerformanceLevelPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PerformanceLevel}" Value="Good">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PerformanceLevel}" Value="Excellent">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PerformanceLevel}" Value="NeedsImprovement">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PerformanceLevel}" Value="Underperforming">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SpecialistRecommendationSignalPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Promote">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Maintain">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Monitor">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RecommendationSignal}" Value="Attention">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, add-specialist form, search & filter, specialist list -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Specialists_Title}" />
            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Specialists_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <!-- Add Specialist: the Create command's one Presentation entry point -->
            <dashboardControls:DashboardCard Grid.Row="1" Title="{x:Static loc:Strings.Specialists_AddSpecialist}" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_FullName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewSpecialistFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Specialists_JobTitle}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewSpecialistTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Email}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewSpecialistEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Phone}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewSpecialistPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="{x:Static loc:Strings.Specialists_AddSpecialist}"
                            Command="{Binding CreateSpecialistCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <!-- Search & Filter: free text plus status/skill, combined by the ViewModel into one SpecialistSearchFilter -->
            <dashboardControls:DashboardCard Grid.Row="2" Title="{x:Static loc:Strings.Specialists_SearchAndFilter}" Margin="0,24,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Common_Search}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Status}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding AvailableStatusOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" Margin="0,4,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{x:Static loc:Strings.Specialists_AllStatuses}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Specialists_Skill}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding SelectedSkill, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="{x:Static loc:Strings.Specialists_ClearFilters}"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource Rojan.Style.ButtonSecondary}"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <dashboardControls:DashboardWidget Grid.Row="3"
                                                Title="{x:Static loc:Strings.Specialists_AllSpecialists}"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,24,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <ListBox ItemsSource="{Binding Specialists}"
                             SelectedItem="{Binding SelectedSpecialist, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appSpecialists:SpecialistDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Email, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

        <!-- Right: selected specialist's profile - status + skills -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="{x:Static loc:Strings.Specialists_SelectPrompt}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding Profile}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Identity + editable status -->
                    <dashboardControls:DashboardCard Title="{Binding Specialist.FullName}">
                        <StackPanel>
                            <TextBlock Text="{Binding Specialist.Title}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBlock Text="{Binding Specialist.Email}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Specialist.Phone}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Specialist.Bio}"
                                       Style="{StaticResource Rojan.TextStyle.Body}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                          SelectedItem="{Binding EditableStatus, Mode=TwoWay}"
                                          Width="150">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                       Style="{StaticResource Rojan.TextStyle.Body}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="{x:Static loc:Strings.Common_SaveChanges}"
                                        Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Skills -->
                    <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Specialists_Skills}" Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appSpecialists:SpecialistSkillDto}">
                                        <Border Background="{StaticResource Rojan.Brush.SurfaceHover}"
                                                BorderBrush="{StaticResource Rojan.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                                                Padding="10,4"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                                                <Button Content="&#10005;"
                                                        Margin="8,0,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="11"
                                                        Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Text="{Binding NewSkillText, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                <Button Content="{x:Static loc:Strings.Specialists_AddSkill}"
                                        Command="{Binding AddSkillCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Intelligence (Sprint 5 Commit 5C): calculated performance score/level/recommendation, composed by Application's IntelligenceEngine from booking data already queried elsewhere in the app - no new query added here, only display. -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Specialists_Intelligence}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.Sparkle}"
                                                      Label="{x:Static loc:Strings.Specialists_PerformanceScore}"
                                                      Value="{Binding PerformanceScore}" />
                                </Border>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.CheckCircle}"
                                                      Label="{x:Static loc:Strings.Specialists_CompletedBookings}"
                                                      Value="{Binding CompletedBookingCount}" />
                                </Border>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.Warning}"
                                                      Label="{x:Static loc:Strings.Specialists_CancelledBookings}"
                                                      Value="{Binding CancelledBookingCount}" />
                                </Border>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="150" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.Warning}"
                                                      Label="{x:Static loc:Strings.Specialists_NoShowBookings}"
                                                      Value="{Binding NoShowBookingCount}" />
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.Specialists_PerformanceLevel}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <shared:StatusPill Text="{Binding PerformanceLevel, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource SpecialistPerformanceLevelPillStyle}"
                                                        Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static loc:Strings.Specialists_RecommendationSignal}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <shared:StatusPill Text="{Binding RecommendationSignal, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource SpecialistRecommendationSignalPillStyle}"
                                                        Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
