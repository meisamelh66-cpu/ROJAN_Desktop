<UserControl x:Class="Rojan.Desktop.Presentation.Views.Modules.PlaceholderModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard">

    <!--
        Shared by every module registered via PlaceholderModule - Phase 07
        is architecture-first, so the nine not-yet-implemented sections
        (Customers, Appointments, Services, Inventory, Accounting,
        Employees, Reports, AI Center, Settings) get this single honest
        "not built yet" page rather than nine near-duplicate stand-ins.
    -->
    <Grid Margin="32">
        <controls:SectionHeader Title="{Binding Title}" VerticalAlignment="Top" HorizontalAlignment="Left" />

        <dashboardControls:DashboardCard MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="This module hasn't been implemented yet."
                       Style="{StaticResource Rojan.TextStyle.Body}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </dashboardControls:DashboardCard>
    </Grid>

</UserControl>
