<UserControl x:Class="Rojan.Desktop.Presentation.Views.Customers.CustomerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:appCustomers="clr-namespace:Rojan.Desktop.Application.Customers;assembly=Rojan.Desktop.Application"
             xmlns:appBookings="clr-namespace:Rojan.Desktop.Application.Bookings;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 09/10: Customer CRM -> Customer 360. Master-detail layout:
        a searchable customer list plus a "New Customer" form on the left,
        and the selected customer's full 360 profile on the right - bound to
        CustomerPageViewModel.Profile (CustomerProfileViewModel), null when
        nothing is selected.

        Sprint 4 Commit 2: added a Search & Filter card - free text plus
        company/tag/status, combined by the ViewModel into one
        CustomerSearchFilter.

        Sprint 4 Commit 3: added Upcoming Appointments/Booking History
        sections, composed from Bookings' own query service via
        CustomerBookingSummaryDto.

        Sprint 4 Commit 4 (Premium Customer 360 UI): adopted the Sprint 1
        Shared Premium controls throughout - EntityAvatar (customer identity
        in the list and the profile header, specialist identity in
        appointment rows), StatusPill (customer/booking status everywhere it
        appears, via the two local *StatusPillStyle resources below, same
        "one shared style instead of a per-usage DataTrigger chain" reasoning
        Bookings' Sprint 3 Commit 4 pass already established), EmptyStateCard
        (appointment sections' empty state), and the Timeline control (the
        activity feed, fed by CustomerProfileViewModel.ActivityTimeline - see
        that property's own doc comment for why the DTO-to-TimelineEntry
        mapping lives on the ViewModel rather than in this XAML). The
        Statistics section now uses StatTile instead of KPIValue, showing
        Lifetime Value/Total Bookings/Completed Bookings/Tags/Notes - the
        booking counts come straight from CustomerProfileViewModel's
        already-existing TotalBookingCount/CompletedBookingCount properties
        (Sprint 4 Commit 3), so no Application-layer change was needed for
        this. DashboardWidget is kept everywhere a section reflects
        Profile.State (Loading/Error/Empty chrome); the identity header and
        Tags/Notes cards - which have no load state of their own - moved from
        DashboardCard to a plain Rojan.Style.Card Border, matching Calendar's
        Sprint 2 Commit 5 "lighter chrome for a non-stateful card" precedent.
        No ViewModel command/filtering behavior changed; StatusFilter/
        CompanyFilter/TagFilter/SearchText bindings and the Add/Search/Load
        commands are all untouched.

        Sprint 4 Commit 5 (Customer Intelligence): added an Insights section
        between Statistics and Upcoming Appointments - Customer Score/Days
        Since Last Visit as StatTiles, Loyalty Level/Engagement Status as
        StatusPills (two more local *PillStyle resources below, same
        reasoning as the Customer/Booking status ones). Every value is
        calculated by Application's CustomerInsightsCalculator from data
        already fetched for Statistics/Appointments - no new query, no new
        storage, no ViewModel command changes.
    -->
    <UserControl.Resources>
        <Style x:Key="CustomerStatusPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Vip">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Churned">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CustomerBookingStatusPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoShow">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Sprint 4 Commit 5 (Customer Intelligence): LoyaltyLevel/EngagementStatus severity mapping, same one-shared-style-per-enum reasoning as the two StatusPill styles above. -->
        <Style x:Key="LoyaltyLevelPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LoyaltyLevel}" Value="Loyal">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LoyaltyLevel}" Value="Vip">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EngagementStatusPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EngagementStatus}" Value="Active">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EngagementStatus}" Value="AtRisk">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EngagementStatus}" Value="Inactive">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, add-customer form, search box, customer list -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Customers_Title}" />
            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Customers_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <!-- Add Customer: the Create command's one Presentation entry point -->
            <dashboardControls:DashboardCard Grid.Row="1" Title="{x:Static loc:Strings.Customers_AddCustomer}" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_FullName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Customers_Company}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerCompany, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Email}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Phone}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="{x:Static loc:Strings.Customers_AddCustomer}"
                            Command="{Binding CreateCustomerCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <!-- Search & Filter (Sprint 4 Commit 2): free text plus company/tag/status, combined by the ViewModel into one CustomerSearchFilter -->
            <dashboardControls:DashboardCard Grid.Row="2" Title="{x:Static loc:Strings.Customers_SearchAndFilter}" Margin="0,24,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Common_Search}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Customers_Company}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Customers_Tag}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{x:Static loc:Strings.Common_Status}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <ComboBox ItemsSource="{Binding AvailableStatusOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" Margin="0,4,0,0" HorizontalAlignment="Left" MinWidth="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{x:Static loc:Strings.Customers_AllStatuses}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </dashboardControls:DashboardCard>

            <dashboardControls:DashboardWidget Grid.Row="3"
                                                Title="{x:Static loc:Strings.Customers_AllCustomers}"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,24,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <ListBox ItemsSource="{Binding Customers}"
                             SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appCustomers:CustomerDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <shared:EntityAvatar Grid.Column="0" EntityName="{Binding FullName}" Size="32" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding Company, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Email, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <shared:StatusPill Grid.Column="2"
                                                        Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource CustomerStatusPillStyle}"
                                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

        <!-- Right: Customer 360 profile for the selected customer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <shared:EmptyStateCard Icon="{StaticResource Rojan.Icon.Customers}"
                                        Message="{x:Static loc:Strings.Customers_SelectPrompt}"
                                        VerticalAlignment="Center">
                    <shared:EmptyStateCard.Style>
                        <Style TargetType="{x:Type shared:EmptyStateCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </shared:EmptyStateCard.Style>
                </shared:EmptyStateCard>

                <StackPanel DataContext="{Binding Profile}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Identity header: avatar, name, company, status pill, editable status -->
                    <Border Style="{StaticResource Rojan.Style.Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <shared:EntityAvatar Grid.Column="0" EntityName="{Binding Customer.FullName}" Size="56" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Customer.FullName}" Style="{StaticResource Rojan.TextStyle.SectionHeader}" />
                                    <TextBlock Text="{Binding Customer.Company}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                                               Margin="0,2,0,0" />
                                    <shared:StatusPill DataContext="{Binding Customer}"
                                                        Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource CustomerStatusPillStyle}"
                                                        Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Customer.Email}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding Customer.Phone}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                          SelectedItem="{Binding EditableStatus, Mode=TwoWay}"
                                          Width="150">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                       Style="{StaticResource Rojan.TextStyle.Body}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="{x:Static loc:Strings.Common_SaveChanges}"
                                        Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Statistics: Lifetime Value, Total/Completed bookings, Tags, Notes - StatTile instead of the old KPIValue-in-DashboardCard grid -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Customers_Statistics}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <WrapPanel>
                            <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                <shared:StatTile Icon="{StaticResource Rojan.Icon.Accounting}"
                                                  Label="{x:Static loc:Strings.Customers_LifetimeValue}"
                                                  Value="{Binding Customer.LifetimeValue}" />
                            </Border>
                            <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                <shared:StatTile Icon="{StaticResource Rojan.Icon.Bookings}"
                                                  Label="{x:Static loc:Strings.Customers_TotalBookings}"
                                                  Value="{Binding TotalBookingCount}" />
                            </Border>
                            <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                <shared:StatTile Icon="{StaticResource Rojan.Icon.CheckCircle}"
                                                  Label="{x:Static loc:Strings.Customers_CompletedBookings}"
                                                  Value="{Binding CompletedBookingCount}" />
                            </Border>
                            <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                <shared:StatTile Label="{x:Static loc:Strings.Customers_Tags}"
                                                  Value="{Binding Tags.Count}" />
                            </Border>
                            <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                <shared:StatTile Label="{x:Static loc:Strings.Common_Notes}"
                                                  Value="{Binding Notes.Count}" />
                            </Border>
                        </WrapPanel>
                    </dashboardControls:DashboardWidget>

                    <!-- Customer Intelligence (Sprint 4 Commit 5): calculated score/loyalty/engagement, composed by CustomerInsightsCalculator from the same booking/activity data the Statistics and Appointments sections already use - no new query, no new storage. -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Customers_Insights}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.Sparkle}"
                                                      Label="{x:Static loc:Strings.Customers_CustomerScore}"
                                                      Value="{Binding CustomerScore}" />
                                </Border>
                                <Border Style="{StaticResource Rojan.Style.Card}" Width="170" Margin="0,0,12,12">
                                    <shared:StatTile Icon="{StaticResource Rojan.Icon.Calendar}"
                                                      Label="{x:Static loc:Strings.Customers_DaysSinceLastVisit}"
                                                      Value="{Binding DaysSinceLastVisit}" />
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.Customers_LoyaltyLevel}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <shared:StatusPill Text="{Binding LoyaltyLevel, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource LoyaltyLevelPillStyle}"
                                                        Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static loc:Strings.Customers_EngagementStatus}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <shared:StatusPill Text="{Binding EngagementStatus, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource EngagementStatusPillStyle}"
                                                        Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <!-- Upcoming Appointments (Sprint 4 Commit 3, Premium pass Commit 4): composed from Bookings' own query service via CustomerBookingSummaryDto -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Customers_UpcomingAppointments}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding UpcomingAppointments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appBookings:BookingDto}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <shared:EntityAvatar Grid.Column="0" EntityName="{Binding SpecialistName}" Size="28" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ServiceName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding SpecialistName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, yyyy t}}"
                                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <shared:EmptyStateCard Icon="{StaticResource Rojan.Icon.Calendar}"
                                                    Message="{x:Static loc:Strings.Customers_NoAppointments}">
                                <shared:EmptyStateCard.Style>
                                    <Style TargetType="{x:Type shared:EmptyStateCard}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpcomingAppointments.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </shared:EmptyStateCard.Style>
                            </shared:EmptyStateCard>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <!-- Booking History: recent past appointments -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Customers_BookingHistory}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding PastAppointments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appBookings:BookingDto}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <shared:EntityAvatar Grid.Column="0" EntityName="{Binding SpecialistName}" Size="28" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ServiceName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding SpecialistName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, yyyy}}"
                                                           Style="{StaticResource Rojan.TextStyle.Caption}"
                                                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                                                           HorizontalAlignment="Right" />
                                                <shared:StatusPill Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                                    Style="{StaticResource CustomerBookingStatusPillStyle}"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <shared:EmptyStateCard Icon="{StaticResource Rojan.Icon.Bookings}"
                                                    Message="{x:Static loc:Strings.Customers_NoAppointments}">
                                <shared:EmptyStateCard.Style>
                                    <Style TargetType="{x:Type shared:EmptyStateCard}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PastAppointments.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </shared:EmptyStateCard.Style>
                            </shared:EmptyStateCard>
                        </StackPanel>
                    </dashboardControls:DashboardWidget>

                    <!-- Tags -->
                    <Border Style="{StaticResource Rojan.Style.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <shared:PremiumCardHeader Title="{x:Static loc:Strings.Customers_Tags}" Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appCustomers:CustomerTagDto}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                            <shared:StatusPill Text="{Binding Label}" Severity="Neutral" />
                                            <Button Content="&#10005;"
                                                    Margin="4,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="11"
                                                    Foreground="{StaticResource Rojan.Brush.MutedText}"
                                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                <Button Content="{x:Static loc:Strings.Customers_AddTag}"
                                        Command="{Binding AddTagCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <Border Style="{StaticResource Rojan.Style.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <shared:PremiumCardHeader Title="{x:Static loc:Strings.Common_Notes}" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}" Width="230" />
                                <Button Content="{x:Static loc:Strings.Customers_AddNote}"
                                        Command="{Binding AddNoteCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="8,0,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appCustomers:CustomerNoteDto}">
                                        <Border BorderBrush="{StaticResource Rojan.Brush.Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,0,0,10"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d, yyyy}}"
                                                           Style="{StaticResource Rojan.TextStyle.Caption}"
                                                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Timeline -->
                    <dashboardControls:DashboardWidget Title="{x:Static loc:Strings.Customers_Timeline}"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,32">
                        <shared:Timeline ItemsSource="{Binding ActivityTimeline}" />
                    </dashboardControls:DashboardWidget>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
