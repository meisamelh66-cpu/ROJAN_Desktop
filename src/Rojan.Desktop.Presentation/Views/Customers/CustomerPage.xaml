<UserControl x:Class="Rojan.Desktop.Presentation.Views.Customers.CustomerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:appCustomers="clr-namespace:Rojan.Desktop.Application.Customers;assembly=Rojan.Desktop.Application">

    <!--
        Phase 09/10: Customer CRM -> Customer 360. Master-detail layout:
        a searchable customer list plus a "New Customer" form on the left
        (both wrapped in the existing state-aware DashboardWidget/
        DashboardCard, reused unchanged from the Dashboard vertical slice),
        and the selected customer's full 360 profile on the right -
        statistics cards, an editable status, tags, notes, and the activity
        timeline - bound to CustomerPageViewModel.Profile
        (CustomerProfileViewModel), null when nothing is selected.

        No new Design System components: every card/widget/value here is
        DashboardCard/DashboardWidget/KPIValue, the same three components
        Phase 06B built for Dashboard.

    -->
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, add-customer form, search box, customer list -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="Customers" />
            <TextBlock Grid.Row="0"
                       Text="Search, review, and stay on top of every client relationship."
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <!-- Add Customer: the Create command's one Presentation entry point -->
            <dashboardControls:DashboardCard Grid.Row="1" Title="Add Customer" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Full name" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Company" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerCompany, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="Email" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="Phone" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Add Customer"
                            Command="{Binding CreateCustomerCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <Border Grid.Row="2"
                    Style="{StaticResource Rojan.Style.Panel}"
                    Padding="16,10"
                    Margin="0,24,0,0">
                <Grid>
                    <TextBlock Text="Search by name, company, or email..."
                               Foreground="{StaticResource Rojan.Brush.HintText}"
                               FontFamily="{StaticResource Rojan.FontFamily.Default}"
                               FontSize="15"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                             CaretBrush="{StaticResource Rojan.Brush.Accent}"
                             FontFamily="{StaticResource Rojan.FontFamily.Default}"
                             FontSize="15" />
                </Grid>
            </Border>

            <dashboardControls:DashboardWidget Grid.Row="3"
                                                Title="All Customers"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,24,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <ListBox ItemsSource="{Binding Customers}"
                             SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appCustomers:CustomerDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding Company, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Email, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

        <!-- Right: Customer 360 profile for the selected customer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="Select a customer to view their 360 profile."
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding Profile}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Identity + editable status -->
                    <dashboardControls:DashboardCard Title="{Binding Customer.FullName}">
                        <StackPanel>
                            <TextBlock Text="{Binding Customer.Company}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBlock Text="{Binding Customer.Email}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Customer.Phone}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                          SelectedItem="{Binding EditableStatus, Mode=TwoWay}"
                                          Width="150" />
                                <Button Content="Save Changes"
                                        Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Statistics cards -->
                    <dashboardControls:DashboardWidget Title="Statistics"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Statistics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appCustomers:CustomerStatDto}">
                                    <dashboardControls:DashboardCard Width="170" Margin="0,0,12,12">
                                        <dashboardControls:KPIValue Label="{Binding Label}" Value="{Binding Value}" />
                                    </dashboardControls:DashboardCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardWidget>

                    <!-- Tags -->
                    <dashboardControls:DashboardCard Title="Tags" Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appCustomers:CustomerTagDto}">
                                        <Border Background="{StaticResource Rojan.Brush.SurfaceHover}"
                                                BorderBrush="{StaticResource Rojan.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                                                Padding="10,4"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                                                <Button Content="&#10005;"
                                                        Margin="8,0,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="11"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                <Button Content="Add Tag"
                                        Command="{Binding AddTagCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Notes -->
                    <dashboardControls:DashboardCard Title="Notes" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}" Width="230" />
                                <Button Content="Add Note"
                                        Command="{Binding AddNoteCommand}"
                                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                        Margin="8,0,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appCustomers:CustomerNoteDto}">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d, yyyy}}"
                                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                                       Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <!-- Timeline -->
                    <dashboardControls:DashboardWidget Title="Timeline"
                                                        State="{Binding State}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        RetryCommand="{Binding LoadCommand}"
                                                        Margin="0,16,0,32">
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appCustomers:CustomerActivityDto}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Description}"
                                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                                   Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OccurredAt, StringFormat={}{0:MMM d, t}}"
                                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                                   Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardWidget>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
