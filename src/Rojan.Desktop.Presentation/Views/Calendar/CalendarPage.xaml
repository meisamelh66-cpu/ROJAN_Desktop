<UserControl x:Class="Rojan.Desktop.Presentation.Views.Calendar.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:appCalendar="clr-namespace:Rojan.Desktop.Application.Calendar;assembly=Rojan.Desktop.Application"
             xmlns:calendarVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Calendar"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 14: Calendar & Availability Engine Foundation. Unlike every
        other module, this page is not a list-plus-detail split - a day's
        availability grid *is* the page. Top: specialist + date picker and
        the resolved working-hours caption.

        Sprint 2 Commit 4: added a Day/Week view-mode toggle (two
        RadioButtons reusing Rojan.Style.TimeRangeOption, the same
        segmented-pill style RangeSelector already uses - no new Design
        System style). IsDayView/IsWeekView pick which of the two
        ItemsControls below is visible via the existing
        BoolToVisibilityConverter (declared locally, same as every other
        page that uses it).

        Sprint 2 Commit 5 (Premium Calendar visual pass): the Day-view slot
        tile changed from a solid-status-color ButtonPrimary to a neutral
        ButtonSecondary tile with a Shared StatusPill carrying the status
        color instead - avoids double-encoding color (a colored pill on an
        already-colored button reads poorly). The specialist ComboBox
        gained a per-item EntityAvatar. WorkingHoursText is now a
        StatusPill instead of plain caption text. Week view's per-day tile
        dropped DashboardCard for a plain Rojan.Style.Card Border plus an
        explicit PremiumCardHeader (lighter chrome, more fitting for seven
        small tiles in a row) and three status-count StatusPills (via the
        new local AvailabilitySlotStatusCountConverter). Still no
        drag-and-drop, no Month view, no appointment-card redesign beyond
        what is described here.

        Calendar/Availability Integration Phase 3 (Service-driven Calendar
        flow, product decision): added a Service picker alongside
        Specialist/Date - the backend availability engine requires one to
        compute slot length. The Day-view slot tile is no longer a Button -
        the manual "toggle a slot to Booked" feature is gone (a slot's
        Booked state now comes from real Booking data only, never a local
        reservation this page wrote itself), so each slot is now a plain,
        non-interactive Border. Every slot this page can show is Available
        (see BackendCalendarAvailabilityRepository's own doc comment for
        why) - the StatusPill's Booked/Unavailable trigger branches stay
        harmlessly unreachable rather than being stripped out, so this
        template still renders correctly against
        Application.Calendar.CalendarQueryService's local/EF data too
        (which can still produce those statuses).
    -->
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:AvailabilitySlotStatusCountConverter x:Key="AvailabilitySlotStatusCountConverter" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Calendar_Title}" />
        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.Calendar_Subtitle}"
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="0,44,0,0" />

        <!-- Specialist + date picker -->
        <dashboardControls:DashboardCard Grid.Row="1" Title="{x:Static loc:Strings.Calendar_SpecialistAndDate}" Margin="0,24,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{x:Static loc:Strings.Common_Specialist}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <ComboBox ItemsSource="{Binding Specialists}"
                                  SelectedItem="{Binding SelectedSpecialist, Mode=TwoWay}"
                                  Width="220"
                                  Margin="0,4,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type appCalendar:ScheduledSpecialistDto}">
                                    <StackPanel Orientation="Horizontal">
                                        <shared:EntityAvatar EntityName="{Binding Name}" Size="24" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                                   Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{x:Static loc:Strings.Common_Service}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <ComboBox ItemsSource="{Binding Services}"
                                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="200"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{x:Static loc:Strings.Common_Date}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="160" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Calendar_ViewMode}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton Style="{StaticResource Rojan.Style.TimeRangeOption}"
                                         GroupName="CalendarViewMode"
                                         Content="{x:Static loc:Strings.Dashboard_TimeRange_Day}"
                                         IsChecked="{Binding IsDayView, Mode=OneWay}"
                                         Command="{Binding SetViewModeCommand}"
                                         CommandParameter="{x:Static calendarVm:CalendarViewMode.Day}" />
                            <RadioButton Style="{StaticResource Rojan.Style.TimeRangeOption}"
                                         GroupName="CalendarViewMode"
                                         Content="{x:Static loc:Strings.Dashboard_TimeRange_Week}"
                                         IsChecked="{Binding IsWeekView, Mode=OneWay}"
                                         Command="{Binding SetViewModeCommand}"
                                         CommandParameter="{x:Static calendarVm:CalendarViewMode.Week}"
                                         Margin="4,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <shared:StatusPill Text="{Binding WorkingHoursText}"
                                    Severity="Info"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </dashboardControls:DashboardCard>

        <!-- Availability grid -->
        <dashboardControls:DashboardWidget Grid.Row="2"
                                            Title="{x:Static loc:Strings.Calendar_Availability}"
                                            State="{Binding State}"
                                            ErrorMessage="{Binding ErrorMessage}"
                                            RetryCommand="{Binding LoadCommand}"
                                            Margin="0,24,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                <Grid>
                    <!-- Day view: per-slot grid, restyled in Sprint 2 Commit 5 (see file header). -->
                    <ItemsControl ItemsSource="{Binding Slots}"
                                  Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appCalendar:AvailabilitySlotDto}">
                                <!-- Read-only display, not a Button - the manual toggle-to-Booked feature
                                     is gone (Calendar/Availability Integration Phase 3, product decision:
                                     a slot's Booked state comes from real Booking data only). -->
                                <Border Style="{StaticResource Rojan.Style.Card}"
                                        MinWidth="120"
                                        Padding="12,8"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Start, StringFormat={}{0:h:mm tt}}"
                                                   Style="{StaticResource Rojan.TextStyle.Body}"
                                                   Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <shared:StatusPill Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,4,0,0">
                                            <shared:StatusPill.Style>
                                                <Style TargetType="shared:StatusPill">
                                                    <Setter Property="Severity" Value="Success" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Booked">
                                                            <Setter Property="Severity" Value="Info" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unavailable">
                                                            <Setter Property="Severity" Value="Neutral" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </shared:StatusPill.Style>
                                        </shared:StatusPill>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Week view: a per-day summary grid. Each tile is a
                        plain Rojan.Style.Card Border (lighter than
                        DashboardCard's gradient/hover chrome, a better fit
                        for seven small tiles in a row) with an explicit
                        PremiumCardHeader for the date and three status-
                        count StatusPills. Still a summary, not the
                        redesigned appointment-card layout with real
                        per-slot detail - that stays out of this commit's
                        scope (no Booking integration, no drag-and-drop).
                    -->
                    <ItemsControl ItemsSource="{Binding WeekDays}"
                                  Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appCalendar:DailyAvailabilityDto}">
                                <Border Style="{StaticResource Rojan.Style.Card}" Padding="12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <shared:PremiumCardHeader Title="{Binding Date, StringFormat={}{0:ddd, MMM d}}" Margin="0,0,0,8" />
                                        <shared:StatusPill Text="{Binding Slots, Converter={StaticResource AvailabilitySlotStatusCountConverter}, ConverterParameter=Available, StringFormat={}{0} available}"
                                                            Severity="Success"
                                                            Margin="0,0,0,4" />
                                        <shared:StatusPill Text="{Binding Slots, Converter={StaticResource AvailabilitySlotStatusCountConverter}, ConverterParameter=Booked, StringFormat={}{0} booked}"
                                                            Severity="Info"
                                                            Margin="0,0,0,4" />
                                        <shared:StatusPill Text="{Binding Slots, Converter={StaticResource AvailabilitySlotStatusCountConverter}, ConverterParameter=Unavailable, StringFormat={}{0} blocked}"
                                                            Severity="Neutral" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </dashboardControls:DashboardWidget>

    </Grid>

</UserControl>
