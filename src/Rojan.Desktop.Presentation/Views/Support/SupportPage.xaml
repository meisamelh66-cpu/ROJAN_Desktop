<UserControl x:Class="Rojan.Desktop.Presentation.Views.Support.SupportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        UI Polish Sprint: the permanent "پشتیبانی" (Support Center) sidebar
        entry - About/Contact/Send Message/Send Email/Development
        Participation/FAQ/User Guide/Terms & Privacy/Version Info, all on
        one scrollable page (the same "one page, several stacked
        DashboardCard sections" shape Settings.SettingsPage already
        establishes). Every string comes from Strings.* - no hardcoded UI
        text, consistent with every other page in this app.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Support_Title}" />
            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Support_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />

            <StackPanel Grid.Row="1" Margin="0,24,0,0">

                <!-- About -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_About_Title}">
                    <TextBlock Text="{x:Static loc:Strings.Support_About_Body}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                </dashboardControls:DashboardCard>

                <!-- Contact Us -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Contact_Title}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Support_Contact_Phone}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBlock Text="{Binding PhoneNumber}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static loc:Strings.Support_Contact_Website}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBlock Text="{Binding WebsiteUrl}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Button Content="{x:Static loc:Strings.Support_Contact_OpenWebsite}" Command="{Binding OpenWebsiteCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Send Email -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_SendEmail_Title}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Support_SendEmail_Description}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SupportEmail}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <Button Content="{x:Static loc:Strings.Support_SendEmail_Compose}" Command="{Binding ComposeEmailCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Send Message / Contact Super Admin / Report a Bug / Suggestions -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Message_Title}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Support_Message_TypeHint}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" />

                        <TextBlock Text="{x:Static loc:Strings.Support_Message_Type}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,16,0,0" />
                        <ComboBox ItemsSource="{Binding AvailableMessageTypes}" SelectedItem="{Binding MessageType}" Margin="0,4,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{x:Static loc:Strings.Support_Message_Subject}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding MessageSubject, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                        <TextBlock Text="{x:Static loc:Strings.Support_Message_Body}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding MessageBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,4,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Support_Message_SenderName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding MessageSenderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Support_Message_SenderEmail}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding MessageSenderEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button Content="{x:Static loc:Strings.Support_Message_Submit}" Command="{Binding SubmitMessageCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />

                        <TextBlock Text="{Binding MessageStatus}" Foreground="{StaticResource Rojan.Brush.Success}" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MessageError}" Foreground="{StaticResource Rojan.Brush.Error}" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- Development Participation -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Participation_Title}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_FirstName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding ApplicantFirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_LastName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding ApplicantLastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_Mobile}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding ApplicantMobile, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_Email}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding ApplicantEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Support_Participation_City}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding ApplicantCity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Support_Participation_CollaborationArea}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding CollaborationArea, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_GitHub}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding GitHubUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_LinkedIn}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding LinkedInUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_Portfolio}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding PortfolioUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static loc:Strings.Support_Participation_Resume}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                <TextBox Text="{Binding ResumeUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Support_Participation_Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding ApplicationDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Content="{x:Static loc:Strings.Support_Participation_Submit}" Command="{Binding SubmitApplicationCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" HorizontalAlignment="Left" Margin="0,16,0,0" />

                        <TextBlock Text="{Binding ApplicationStatus}" Foreground="{StaticResource Rojan.Brush.Success}" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplicationStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ApplicationError}" Foreground="{StaticResource Rojan.Brush.Error}" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplicationError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- FAQ -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Faq_Title}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Support_Faq_Q1}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static loc:Strings.Support_Faq_A1}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="{x:Static loc:Strings.Support_Faq_Q2}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="{x:Static loc:Strings.Support_Faq_A2}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="{x:Static loc:Strings.Support_Faq_Q3}" Style="{StaticResource Rojan.TextStyle.Body}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="{x:Static loc:Strings.Support_Faq_A3}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </dashboardControls:DashboardCard>

                <!-- User Guide -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Guide_Title}" Margin="0,16,0,0">
                    <TextBlock Text="{x:Static loc:Strings.Support_Guide_Body}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                </dashboardControls:DashboardCard>

                <!-- Terms & Privacy -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Terms_Title}" Margin="0,16,0,0">
                    <TextBlock Text="{x:Static loc:Strings.Support_Terms_Body}" Style="{StaticResource Rojan.TextStyle.Body}" TextWrapping="Wrap" />
                </dashboardControls:DashboardCard>

                <!-- Version Info -->
                <dashboardControls:DashboardCard Title="{x:Static loc:Strings.Support_Version_Title}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Support_Version_AppVersion}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Static loc:Strings.Support_Version_Api}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBlock Text="{Binding ApiBaseUrl}" Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </dashboardControls:DashboardCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
