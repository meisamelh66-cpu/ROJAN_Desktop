<UserControl x:Class="Rojan.Desktop.Presentation.Views.Reporting.ReportingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:reportingVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Reporting"
             xmlns:appReporting="clr-namespace:Rojan.Desktop.Application.Reporting;assembly=Rojan.Desktop.Application">

    <!--
        Phase 20: Enterprise Reporting & Analytics Platform. Same
        master-shape as every other multi-section module page: a local
        section switcher (Catalog/Viewer/Saved/Recent) with one
        DashboardWidget-hosted section visible at a time. The Report
        Viewer's Filter Panel is generic (FilterType + Value pairs) so the
        same UI works for every report's own DateRange plus whichever of
        the eight FilterTypes it supports - see
        Application.Reporting.ReportFilterSet for how these get parsed
        back out. Run is cancellable (CancelCommand) and never blocks the
        UI thread (AsyncRelayCommand). Export opens ExportDialogViewModel
        through the existing dialog framework, same as Accounting's POS
        checkout dialog.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/RojanTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="Reporting" />
        <TextBlock Grid.Row="0"
                   Text="Run, filter, save, and export reports aggregated across every module."
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="0,44,0,0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Catalog" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static reportingVm:ReportingSection.Catalog}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Catalog">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Report Viewer" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static reportingVm:ReportingSection.Viewer}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Viewer">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Saved Reports" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static reportingVm:ReportingSection.Saved}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Saved">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Recent Reports" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static reportingVm:ReportingSection.Recent}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Recent">
                                <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <Grid>

                <!-- Section: Catalog -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Catalog">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardWidget Title="Report Catalog" State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}">
                        <ItemsControl ItemsSource="{Binding ReportDefinitions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appReporting:ReportDefinitionDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardWidget>
                </StackPanel>

                <!-- Section: Report Viewer -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Viewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="Filter Panel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                <Run Text="Report: " />
                                <Run Text="{Binding SelectedReport.Name, Mode=OneWay, FallbackValue='(none selected - pick one from Catalog)'}" FontWeight="SemiBold" />
                            </TextBlock>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date range start" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Date range end" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                    <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AdditionalFilters}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type reportingVm:FilterEntryViewModel}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.SelectedReport.SupportedFilters, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding FilterType, Mode=TwoWay}" />
                                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Add Filter" Command="{Binding AddFilterCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0" />
                                <Button Content="Run Report" Command="{Binding RunReportCommand}" Style="{StaticResource Rojan.Style.ButtonPrimary}" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0" />
                                <Button Content="Export" Command="{Binding OpenExportDialogCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </dashboardControls:DashboardCard>

                    <dashboardControls:DashboardCard Title="Results" Margin="0,16,0,0">
                        <Grid>
                            <TextBlock Text="Run a report to see results here." Foreground="{StaticResource Rojan.Brush.MutedText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentResult}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel DataContext="{Binding CurrentResult}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                    <!--
                                        Columns are report-specific (different reports have entirely
                                        different Column sets) so they can't be declared statically here -
                                        ReportingPage.xaml.cs rebuilds ResultsDataGrid.Columns whenever
                                        CurrentResult changes, one DataGridTextColumn per ReportColumnDto
                                        bound to Values[key] via that column's key - a standard WPF
                                        dynamic-column pattern, no external grid library involved.
                                    -->
                                    <DataGrid x:Name="ResultsDataGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.MutedText}" />
                                            </Style>
                                        </DataGrid.Resources>
                                    </DataGrid>
                                </ScrollViewer>

                                <ItemsControl ItemsSource="{Binding Summary}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Rojan.Style.Panel}" Padding="12,8" Margin="0,0,8,8">
                                                <TextBlock>
                                                    <Run Text="{Binding Key, Mode=OneWay}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                    <Run Text=": " Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                                    <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </dashboardControls:DashboardCard>
                </StackPanel>

                <!-- Section: Saved Reports -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Saved">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="Saved Reports">
                        <ItemsControl ItemsSource="{Binding SavedSnapshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appReporting:ReportSnapshotDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ReportName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{Binding GeneratedAt, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding RowCount, Mode=OneWay}" />
                                                    <Run Text=" rows" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Re-run"
                                                    Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.RerunSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2"
                                                    Content="Unpin"
                                                    Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Command="{Binding DataContext.ToggleSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>
                </StackPanel>

                <!-- Section: Recent Reports -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Recent">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <dashboardControls:DashboardCard Title="Recent Reports">
                        <ItemsControl ItemsSource="{Binding RecentSnapshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type appReporting:ReportSnapshotDto}">
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ReportName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                                <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                    <Run Text="{Binding GeneratedAt, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding RowCount, Mode=OneWay}" />
                                                    <Run Text=" rows" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Re-run"
                                                    Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.RerunSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2"
                                                    Content="Pin"
                                                    Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                    Command="{Binding DataContext.ToggleSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </dashboardControls:DashboardCard>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
