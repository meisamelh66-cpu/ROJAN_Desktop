<UserControl x:Class="Rojan.Desktop.Presentation.Views.Bookings.BookingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:appBookings="clr-namespace:Rojan.Desktop.Application.Bookings;assembly=Rojan.Desktop.Application">

    <!--
        Phase 11: Booking Module Foundation. Same master-detail shape as
        CustomerPage/DashboardPage: a new-booking form plus a searchless
        booking list on the left (foundation scope - no calendar view, no
        conflict detection yet), and the selected booking's details plus
        status-transition actions (Confirm/Complete/Cancel) on the right.
        Every card/widget here is DashboardCard/DashboardWidget, the same
        Design System components every other module reuses unchanged.

        Merges its own Theme.xaml dependency locally (same self-sufficiency
        rule as every other Design System component).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, new-booking form, booking list -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="Bookings" />
            <TextBlock Grid.Row="0"
                       Text="Schedule and track every appointment."
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />
            <Button Grid.Row="0"
                    Content="New Booking (Wizard)"
                    Command="{Binding OpenWizardCommand}"
                    Style="{StaticResource Rojan.Style.GlassButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />

            <!-- New Booking: the Create command's one Presentation entry point -->
            <dashboardControls:DashboardCard Grid.Row="1" Title="New Booking" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Customer" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewBookingCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Service" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewBookingServiceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="Specialist" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewBookingSpecialistName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="Duration (min)" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding AvailableDurations}"
                                      SelectedItem="{Binding NewBookingDurationMinutes, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Date" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <DatePicker SelectedDate="{Binding NewBookingDate, Mode=TwoWay}" Margin="0,4,0,0" HorizontalAlignment="Left" Width="160" />
                    </StackPanel>

                    <Button Content="Add Booking"
                            Command="{Binding CreateBookingCommand}"
                            Style="{StaticResource Rojan.Style.GlassButton}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <dashboardControls:DashboardWidget Grid.Row="2"
                                                Title="All Bookings"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,24,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <ListBox ItemsSource="{Binding Bookings}"
                             SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.GlassNavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appBookings:BookingDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, t}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Style="{StaticResource Rojan.TextStyle.Caption}"
                                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

        <!-- Right: selected booking's details + status actions -->
        <dashboardControls:DashboardCard Grid.Column="1" Title="Booking Details" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Select a booking to view details."
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBooking}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding SelectedBooking}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Rojan.TextStyle.CardTitle}" />
                    <TextBlock Text="{Binding ServiceName}"
                               Style="{StaticResource Rojan.TextStyle.Caption}"
                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                               Margin="0,2,0,0" />

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                            <Run Text="Specialist: " />
                            <Run Text="{Binding SpecialistName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="When: " />
                            <Run Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, yyyy t}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="Duration: " />
                            <Run Text="{Binding DurationMinutes, Mode=OneWay}" />
                            <Run Text=" min" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   Margin="0,4,0,0">
                            <Run Text="Status: " />
                            <Run Text="{Binding Status, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding Notes}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Confirm"
                                Command="{Binding DataContext.ConfirmBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.GlassButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Complete"
                                Command="{Binding DataContext.CompleteBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.GlassButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel"
                                Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.GlassButton}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </dashboardControls:DashboardCard>

    </Grid>

</UserControl>
