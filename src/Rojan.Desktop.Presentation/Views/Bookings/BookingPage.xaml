<UserControl x:Class="Rojan.Desktop.Presentation.Views.Bookings.BookingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:appBookings="clr-namespace:Rojan.Desktop.Application.Bookings;assembly=Rojan.Desktop.Application"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 11: Booking Module Foundation. Same master-detail shape as
        CustomerPage/DashboardPage: a new-booking form plus a booking list
        on the left, and the selected booking's details plus
        status-transition actions (Confirm/Complete/Cancel/Start/No Show) on
        the right. Every card/widget here is DashboardCard/DashboardWidget,
        the same Design System components every other module reuses
        unchanged.

        Sprint 3 Commit 2: added a Search &amp; Filter card between the
        new-booking form and the list - free-text search plus
        customer/service/status/date-range filters, all combined into one
        BookingSearchFilter and run through
        IBookingQueryService.SearchBookingsAsync (BookingPageViewModel owns
        the filter-combination logic; this page only binds to it, no
        filtering logic lives here).

        Sprint 3 Commit 4 (Premium Booking UI): adopted the Sprint 1/2
        Shared Premium controls - EntityAvatar (customer avatar in the list
        and detail header, specialist avatar in the detail panel) and
        StatusPill (replacing plain status text everywhere it appeared,
        one shared local BookingStatusPillStyle mapping each of the 6
        BookingStatus values to a severity, rather than duplicating the
        DataTrigger chain per usage). No new custom control was written -
        every visual here is an existing Shared control or existing Theme
        resource, same reasoning as Calendar's Sprint 2 Commit 5 pass. No
        ViewModel or command behavior changed.
    -->
    <UserControl.Resources>
        <Style x:Key="BookingStatusPillStyle" TargetType="{x:Type shared:StatusPill}">
            <Setter Property="Severity" Value="Neutral" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                    <Setter Property="Severity" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Severity" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Severity" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoShow">
                    <Setter Property="Severity" Value="Error" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, new-booking form, search/filter, booking list -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.Bookings_Title}" />
            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Bookings_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       Margin="0,44,0,0" />
            <Button Grid.Row="0"
                    Content="{x:Static loc:Strings.Bookings_NewBookingWizard}"
                    Command="{Binding OpenWizardCommand}"
                    Style="{StaticResource Rojan.Style.ButtonPrimary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />

            <!-- New Booking: the Create command's one Presentation entry point -->
            <dashboardControls:DashboardCard Grid.Row="1" Title="{x:Static loc:Strings.Bookings_NewBooking}" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Customer}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewBookingCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Common_Service}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewBookingServiceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Specialist}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding NewBookingSpecialistName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Bookings_DurationMin}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding AvailableDurations}"
                                      SelectedItem="{Binding NewBookingDurationMinutes, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{x:Static loc:Strings.Common_Date}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <DatePicker SelectedDate="{Binding NewBookingDate, Mode=TwoWay}" Margin="0,4,0,0" HorizontalAlignment="Left" Width="160" />
                    </StackPanel>

                    <Button Content="{x:Static loc:Strings.Bookings_AddBooking}"
                            Command="{Binding CreateBookingCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <!-- Search & Filter: free text plus customer/service/status/date-range, combined by the ViewModel into one BookingSearchFilter -->
            <dashboardControls:DashboardCard Grid.Row="2" Title="{x:Static loc:Strings.Bookings_SearchAndFilter}" Margin="0,24,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Common_Search}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Customer}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding CustomerNameFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Common_Service}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding ServiceNameFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Status}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" Margin="0,4,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Rojan.Converter.EnumLabel}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{x:Static loc:Strings.Bookings_AllStatuses}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Common_From}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <DatePicker SelectedDate="{Binding DateFromFilter, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{x:Static loc:Strings.Common_To}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <DatePicker SelectedDate="{Binding DateToFilter, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </dashboardControls:DashboardCard>

            <dashboardControls:DashboardWidget Grid.Row="3"
                                                Title="{x:Static loc:Strings.Bookings_AllBookings}"
                                                State="{Binding State}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                RetryCommand="{Binding LoadCommand}"
                                                Margin="0,24,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <ListBox ItemsSource="{Binding Bookings}"
                             SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type appBookings:BookingDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <shared:EntityAvatar Grid.Column="0" EntityName="{Binding CustomerName}" Size="32" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                        <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                            <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, t}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <shared:StatusPill Grid.Column="2"
                                                        Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                                        Style="{StaticResource BookingStatusPillStyle}"
                                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </dashboardControls:DashboardWidget>
        </Grid>

        <!-- Right: selected booking's details + status actions -->
        <dashboardControls:DashboardCard Grid.Column="1" Title="{x:Static loc:Strings.Bookings_Details}" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="{x:Static loc:Strings.Bookings_SelectPrompt}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBooking}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding SelectedBooking}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <shared:EntityAvatar Grid.Column="0" EntityName="{Binding CustomerName}" Size="48" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Rojan.TextStyle.SectionHeader}" />
                            <TextBlock Text="{Binding ServiceName}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <shared:StatusPill Text="{Binding Status, Converter={StaticResource Rojan.Converter.EnumLabel}}"
                                        Style="{StaticResource BookingStatusPillStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />

                    <StackPanel Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <shared:EntityAvatar EntityName="{Binding SpecialistName}" Size="20" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center">
                                <Run Text="{x:Static loc:Strings.Common_Specialist}" />
                                <Run Text=": " />
                                <Run Text="{Binding SpecialistName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,8,0,0">
                            <Run Text="{x:Static loc:Strings.Bookings_When}" />
                            <Run Text=": " />
                            <Run Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, yyyy t}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="{x:Static loc:Strings.Common_Duration}" />
                            <Run Text=": " />
                            <Run Text="{Binding DurationMinutes, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{x:Static loc:Strings.Common_MinutesShort}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding Notes}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0" />

                    <!-- Sprint 3 Commit 3: added Start (Pending/Confirmed -> InProgress) and No Show (Confirmed -> NoShow) - a WrapPanel instead of the prior horizontal StackPanel, since five buttons no longer fit one row in this 380px column; same Button/ButtonPrimary style as every other action here, no visual redesign. -->
                    <WrapPanel Margin="0,20,0,0">
                        <Button Content="{x:Static loc:Strings.Common_Confirm}"
                                Command="{Binding DataContext.ConfirmBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                Margin="0,0,8,8" />
                        <Button Content="{x:Static loc:Strings.Bookings_Start}"
                                Command="{Binding DataContext.StartBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                Margin="0,0,8,8" />
                        <Button Content="{x:Static loc:Strings.Bookings_Complete}"
                                Command="{Binding DataContext.CompleteBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                Margin="0,0,8,8" />
                        <Button Content="{x:Static loc:Strings.Bookings_NoShow}"
                                Command="{Binding DataContext.NoShowBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                Margin="0,0,8,8" />
                        <Button Content="{x:Static loc:Strings.Common_Cancel}"
                                Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                Margin="0,0,0,8" />
                    </WrapPanel>

                    <!-- Sprint 3 Commit 6: reschedule - a date picker (same-time-of-day, same specialist) plus one button, reusing the exact DatePicker/ButtonSecondary components already used elsewhere on this page. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <DatePicker SelectedDate="{Binding DataContext.RescheduleDate, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                    Width="160"
                                    Margin="0,0,8,0" />
                        <Button Content="{x:Static loc:Strings.Bookings_Reschedule}"
                                Command="{Binding DataContext.RescheduleBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Rojan.Style.ButtonSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </dashboardControls:DashboardCard>

    </Grid>

</UserControl>
