<UserControl x:Class="Rojan.Desktop.Presentation.Views.BookingWorkflow.BookingWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workflow="clr-namespace:Rojan.Desktop.Application.BookingWorkflow;assembly=Rojan.Desktop.Application"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Phase 15: Enterprise Booking Workflow & Reservation Flow. Shown in
        Shell's dialog region (see MainWindow.xaml's Dialog region +
        IDialogService) - a linear, step-by-step flow: Customer -> Service
        -> Specialist -> Date -> TimeSlot -> Review -> Confirmation. Each
        step is a StackPanel whose Visibility is DataTrigger-driven off
        CurrentStep, the same show/hide-by-DataTrigger idiom used
        throughout this app.

        Phase 16: Microsoft Fluent 2 Design System Integration - a Fluent
        Wizard dialog: a real step-progress indicator (7 segments, filled
        up to the current step via EnumAtLeastConverter - a pure
        Presentation-layer display helper, no ViewModel/workflow change),
        a tighter/smaller overlay (480 vs. the prior 560, less empty
        chrome), Fluent's Primary/Secondary button hierarchy (Next/Confirm
        Booking/Done are the one primary action per step; Back/Cancel are
        secondary), and corrected error-state coloring (ErrorText, not the
        decorative RoseGoldHighlight token the prior version used here by
        mistake).

        No longer self-merges its own RojanTheme.xaml copy - see
        Shell/App.xaml.cs's ThemeResources.Apply.

        Sprint 3 Commit 4 (Premium Booking UI): Customer/Specialist step
        picker rows gained an EntityAvatar (same Shared control BookingPage
        now uses) instead of plain DisplayMemberPath text - "selection
        cards" per this commit's scope. The TimeSlot step's empty state
        (previously a plain TextBlock behind a State==Empty DataTrigger)
        now uses the Shared EmptyStateCard for the same message, matching
        the standardized empty-state shape Sprint 1 introduced. The 7-step
        workflow itself, its CanExecute rules, and every ViewModel command
        are unchanged - visuals only.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:EnumAtLeastConverter x:Key="EnumAtLeastConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Rojan.Brush.SurfaceElevated}"
            BorderBrush="{StaticResource Rojan.Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Rojan.CornerRadius.Large}"
            Effect="{StaticResource Rojan.Effect.ElevationDialog}"
            Width="480"
            MaxHeight="600"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Title -->
                <RowDefinition Height="Auto" />
                <!-- Step indicator -->
                <RowDefinition Height="Auto" />
                <!-- Step label / error -->
                <RowDefinition Height="*" />
                <!-- Step content -->
                <RowDefinition Height="Auto" />
                <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.BookingWizard_Title}" Style="{StaticResource Rojan.TextStyle.SectionHeader}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" />

            <!-- Step indicator: 7 segments, accent-filled up to and including the current step. -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{StaticResource Rojan.Brush.Accent}" />
                <Border Grid.Column="2" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Service" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="4" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Specialist" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="6" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Date" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="8" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="TimeSlot" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="10" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Review" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="12" Height="4" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Rojan.Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="CurrentStep" Converter="{StaticResource EnumAtLeastConverter}" ConverterParameter="Confirmation" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Rojan.Brush.Error}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="360" Margin="0,16,0,0">
                <Grid>

                    <!-- Step: Customer -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Customer">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_StepWhoFor}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding Customers}"
                                 SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="320"
                                 ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type workflow:WorkflowCustomerOptionDto}">
                                    <StackPanel Orientation="Horizontal">
                                        <shared:EntityAvatar EntityName="{Binding FullName}" Size="28" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center" />
                                        <!-- Reception Stabilization Sprint: flags a walk-in/guest customer as not yet bookable, before Reception reaches the last step. -->
                                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_UnlinkedCustomerBadge}"
                                                   Foreground="{StaticResource Rojan.Brush.Error}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLinkedToAccount}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Reception Stabilization Sprint: the Walk-in entry point - creates a guest CRM customer inline instead of requiring Reception to leave the wizard for the separate Customer page. -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.BookingWizard_AddGuestCustomer}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="0,0,0,4" />
                            <TextBlock Text="{x:Static loc:Strings.BookingWizard_GuestFullNameLabel}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding GuestFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="{x:Static loc:Strings.BookingWizard_GuestPhoneLabel}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding GuestPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <Button Content="{x:Static loc:Strings.BookingWizard_AddGuestCustomer}"
                                    Command="{Binding AddGuestCustomerCommand}"
                                    Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step: Service -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Service">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_StepChooseService}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding Services}"
                                 SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="320"
                                 ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type workflow:WorkflowServiceOptionDto}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                            <TextBlock Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}">
                                                <Run Text="{Binding DurationMinutes, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{x:Static loc:Strings.Common_MinutesShort}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Price}" Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Step: Specialist -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Specialist">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_StepChooseSpecialist}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8" />
                        <!-- Booking Eligibility Filter: EligibleSpecialists, not Specialists - every specialist
                             eligible for the already-selected service, per ROJAN_Backend's own eligibility rule
                             (see BookingWizardViewModel.RefreshEligibleSpecialists' own doc comment). A UX filter
                             only - ROJAN_Backend's own check inside available-slots/booking-creation remains the
                             sole authority, unaffected by this. -->
                        <shared:EmptyStateCard Icon="{StaticResource Rojan.Icon.Calendar}"
                                                Message="{Binding NoEligibleSpecialistsMessage}"
                                                Margin="0,0,0,8">
                            <shared:EmptyStateCard.Style>
                                <Style TargetType="{x:Type shared:EmptyStateCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoEligibleSpecialists}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </shared:EmptyStateCard.Style>
                        </shared:EmptyStateCard>
                        <ListBox ItemsSource="{Binding EligibleSpecialists}"
                                 SelectedItem="{Binding SelectedSpecialist, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="320"
                                 ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type workflow:WorkflowSpecialistOptionDto}">
                                    <StackPanel Orientation="Horizontal">
                                        <shared:EntityAvatar EntityName="{Binding FullName}" Size="28" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Step: Date -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Date">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_StepChooseDate}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8" />
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" />
                    </StackPanel>

                    <!-- Step: TimeSlot -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="TimeSlot">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_StepChooseTime}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8" />
                        <shared:EmptyStateCard Icon="{StaticResource Rojan.Icon.Calendar}"
                                                Message="{x:Static loc:Strings.BookingWizard_NoSlots}"
                                                Margin="0,0,0,8">
                            <shared:EmptyStateCard.Style>
                                <Style TargetType="{x:Type shared:EmptyStateCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Empty">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </shared:EmptyStateCard.Style>
                        </shared:EmptyStateCard>
                        <ListBox ItemsSource="{Binding AvailableSlots}"
                                 SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="320"
                                 ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type workflow:WorkflowSlotDto}">
                                    <TextBlock Text="{Binding Start, StringFormat={}{0:t}}" Style="{StaticResource Rojan.TextStyle.Body}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Step: Review -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Review">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static loc:Strings.BookingWizard_StepReview}" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="{x:Static loc:Strings.Common_Customer}" /><Run Text=": " /><Run Text="{Binding SelectedCustomer.FullName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="{x:Static loc:Strings.Common_Service}" /><Run Text=": " /><Run Text="{Binding SelectedService.Name, Mode=OneWay}" />
                            <Run Text=" (" /><Run Text="{Binding SelectedService.Price, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="{x:Static loc:Strings.Common_Specialist}" /><Run Text=": " /><Run Text="{Binding SelectedSpecialist.FullName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                            <Run Text="{x:Static loc:Strings.Bookings_When}" /><Run Text=": " /><Run Text="{Binding SelectedSlot.Start, StringFormat={}{0:MMM d, yyyy t}, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Common_Notes}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step: Confirmation -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Confirmation">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{StaticResource Rojan.Icon.CheckCircle}"
                                       FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                       FontSize="20"
                                       Foreground="{StaticResource Rojan.Brush.Success}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static loc:Strings.BookingWizard_Confirmed}" Style="{StaticResource Rojan.TextStyle.SectionHeader}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding Confirmation}">
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}">
                                <Run Text="{x:Static loc:Strings.Common_Customer}" /><Run Text=": " /><Run Text="{Binding CustomerName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                <Run Text="{x:Static loc:Strings.Common_Service}" /><Run Text=": " /><Run Text="{Binding ServiceName, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding Price, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                <Run Text="{x:Static loc:Strings.Common_Specialist}" /><Run Text=": " /><Run Text="{Binding SpecialistName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Rojan.TextStyle.Body}" Margin="0,4,0,0">
                                <Run Text="{x:Static loc:Strings.Bookings_When}" /><Run Text=": " /><Run Text="{Binding ScheduledAt, StringFormat={}{0:MMM d, yyyy t}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Confirmation">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Common_Back}" Command="{Binding BackCommand}" Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:Strings.Common_Next}" Command="{Binding NextCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonPrimary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Review">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Confirmation">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.BookingWizard_ConfirmBooking}" Command="{Binding ConfirmBookingCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonPrimary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Review">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static loc:Strings.Common_Done}" Command="{Binding DoneCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Rojan.Style.ButtonPrimary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Confirmation">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
