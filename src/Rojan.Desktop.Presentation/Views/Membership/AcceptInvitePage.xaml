<UserControl x:Class="Rojan.Desktop.Presentation.Views.Membership.AcceptInvitePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls"
             xmlns:dashboardControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
             xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters"
             xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

    <!--
        Reception Production Integration. Two DashboardCard panels, both
        potentially visible at once (unlike SalonPage's either/or) - the
        token-entry panel stays usable while the confirmation panel shows,
        so a wrong lookup can be corrected without losing the form. No
        DashboardWidget State wrapper - this page never "loads" anything on
        its own, it only reacts to explicit Lookup/Accept commands, same
        reasoning SalonPageViewModel's own doc comment gives for keeping
        load-outcome state and action-outcome state separate.
    -->
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="{x:Static loc:Strings.AcceptInvite_Title}" />
        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.AcceptInvite_Subtitle}"
                   Style="{StaticResource Rojan.TextStyle.Caption}"
                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                   Margin="0,44,0,0" />

        <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <dashboardControls:DashboardCard Title="{x:Static loc:Strings.AcceptInvite_TokenLabel}">
                <StackPanel>
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                    <TextBlock Text="{Binding LookupErrorMessage}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.Error}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasLookupError, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button Content="{x:Static loc:Strings.AcceptInvite_LookupButton}"
                            Command="{Binding LookupCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>

            <dashboardControls:DashboardCard Title="{Binding JoinPrompt}"
                                              Margin="0,16,0,0"
                                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding AcceptErrorMessage}"
                               Style="{StaticResource Rojan.TextStyle.Body}"
                               Foreground="{StaticResource Rojan.Brush.Error}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasAcceptError, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button Content="{x:Static loc:Strings.AcceptInvite_AcceptButton}"
                            Command="{Binding AcceptCommand}"
                            Style="{StaticResource Rojan.Style.ButtonPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0" />
                </StackPanel>
            </dashboardControls:DashboardCard>
        </StackPanel>
    </Grid>

</UserControl>
