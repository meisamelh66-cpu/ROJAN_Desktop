<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Phase 16: Microsoft Fluent 2 Design System Integration.

    Theme-INVARIANT tokens only - the ROJAN accent and status colors stay
    the same regardless of Light.xaml/Dark.xaml being active. Every
    surface/text/stroke token that legitimately differs between light and
    dark now lives in Dark.xaml/Light.xaml instead (each is a fully
    self-contained Color+Brush set for its theme, the standard WPF
    swappable-theme-dictionary pattern - RojanTheme.xaml merges whichever
    one is active).

    This replaces the prior "glass" palette (translucent white fills, a
    purple->magenta gradient on every surface) with Fluent 2's own
    approach: neutral surfaces plus one restrained accent, reserved for
    primary actions, selection, active state, progress, and focus (see
    Controls.xaml/ShellChrome.xaml for where it's actually applied).
  -->

  <!-- ROJAN accent - the one saturated color, used only for primary/selected/active/progress/focus/links -->
  <Color x:Key="Rojan.Color.Accent">#FF8E28E7</Color>
  <Color x:Key="Rojan.Color.AccentHover">#FF9F49EA</Color>
  <Color x:Key="Rojan.Color.AccentPressed">#FF7620BE</Color>
  <Color x:Key="Rojan.Color.AccentSubtle">#1F8E28E7</Color>
  <Color x:Key="Rojan.Color.FocusRing">#FF8E28E7</Color>

  <!-- Kept for the SectionHeader's small decorative underline only - a
       secondary brand hue distinct from the interactive Accent, used in
       exactly one place, not as a second competing accent. -->
  <Color x:Key="Rojan.Color.RoseGoldHighlight">#FFFF8FC8</Color>

  <!-- Text drawn on a filled Accent surface (buttons) - white in both themes. -->
  <Color x:Key="Rojan.Color.ButtonText">#FFFFFFFF</Color>

  <!-- Semantic status - kept invariant across themes for recognizability. -->
  <Color x:Key="Rojan.Color.ErrorText">#FFE5484D</Color>
  <Color x:Key="Rojan.Color.SuccessText">#FF3FB950</Color>
  <Color x:Key="Rojan.Color.WarningText">#FFF2B93D</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="Rojan.Brush.Accent" Color="{StaticResource Rojan.Color.Accent}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentHover" Color="{StaticResource Rojan.Color.AccentHover}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentPressed" Color="{StaticResource Rojan.Color.AccentPressed}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentSubtle" Color="{StaticResource Rojan.Color.AccentSubtle}" />
  <SolidColorBrush x:Key="Rojan.Brush.FocusRing" Color="{StaticResource Rojan.Color.FocusRing}" />
  <SolidColorBrush x:Key="Rojan.Brush.RoseGoldHighlight" Color="{StaticResource Rojan.Color.RoseGoldHighlight}" />

  <SolidColorBrush x:Key="Rojan.Brush.ButtonText" Color="{StaticResource Rojan.Color.ButtonText}" />

  <SolidColorBrush x:Key="Rojan.Brush.ErrorText" Color="{StaticResource Rojan.Color.ErrorText}" />
  <SolidColorBrush x:Key="Rojan.Brush.SuccessText" Color="{StaticResource Rojan.Color.SuccessText}" />
  <SolidColorBrush x:Key="Rojan.Brush.WarningText" Color="{StaticResource Rojan.Color.WarningText}" />

</ResourceDictionary>
