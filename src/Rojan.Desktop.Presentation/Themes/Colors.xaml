<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Phase 16: Microsoft Fluent 2 Design System Integration.
    Fluent 2 Premium Theme pass: ROJAN's four brand accents (Purple/Rose
    Gold/Lavender/Aqua) are now named, documented tokens here - all
    "emphasis only" per that pass's explicit instruction (icons, badges,
    chart series, decorative highlights), never ordinary body/caption
    text color. Purple stays the one INTERACTIVE accent (primary
    actions/selection/focus/links) exactly as before; Rose Gold/Lavender/
    Aqua are additional brand hues available for emphasis moments that
    need to stand apart from the interactive accent (e.g. a status chip,
    a KPI's secondary highlight) without inventing a second competing
    "primary" color.

    Theme-INVARIANT tokens only - every surface/text/border token that
    legitimately differs between light and dark lives in Light.xaml/
    Dark.xaml instead (each is a fully self-contained Color+Brush set for
    its theme, the standard WPF swappable-theme-dictionary pattern).
    Semantic status (Error/Warning/Success) moved to Light.xaml/Dark.xaml
    in this pass too - see Light.xaml's own doc comment for why a single
    invariant status color can't satisfy WCAG AA text contrast on both a
    light and a dark surface at once.

    This replaces the prior "glass" palette (translucent white fills, a
    purple->magenta gradient on every surface) with Fluent 2's own
    approach: neutral surfaces plus one restrained accent, reserved for
    primary actions, selection, active state, progress, and focus (see
    Controls.xaml/ShellChrome.xaml for where it's actually applied).
  -->

  <!--
    Design System Alignment pass: retargeted to the exact rojanai.ir
    product brand purple (#7C3AA6, from the website's `.rojan-theme`
    "brand-primary" token - see ROJAN_Web_Design_System_Audit.md /
    ROJAN_Desktop_Design_Token_Proposal.md §1) - same key names, same
    "one interactive accent" role Phase 16 established, only the hex
    value changes, so every existing consumer (buttons, focus rings,
    selection states) picks up the brand-exact purple automatically with
    no template changes. Hover/Pressed are the same +/-lightness step
    pattern as the prior value, recomputed from the new base.
  -->
  <Color x:Key="Rojan.Color.Accent">#FF7C3AA6</Color>
  <Color x:Key="Rojan.Color.AccentHover">#FF8E4BB8</Color>
  <Color x:Key="Rojan.Color.AccentPressed">#FF692E8E</Color>
  <Color x:Key="Rojan.Color.AccentSubtle">#1F7C3AA6</Color>
  <Color x:Key="Rojan.Color.FocusRing">#FF7C3AA6</Color>

  <!-- The "Rose Gold" brand accent - kept for the SectionHeader's decorative underline, also available generally for emphasis (badges/highlights), never interactive. -->
  <Color x:Key="Rojan.Color.RoseGoldHighlight">#FFFF8FC8</Color>

  <!-- The "Lavender" and "Aqua" brand accents - emphasis-only, same reasoning as Rose Gold above; not used for ordinary text or as a second interactive color. -->
  <Color x:Key="Rojan.Color.AccentLavender">#FFB9A6F0</Color>
  <Color x:Key="Rojan.Color.AccentAqua">#FF2FC6C6</Color>

  <!--
    Design System Alignment pass: the website's exact "brand-secondary"
    (gold) and "brand-rose" tokens, added alongside (not replacing)
    RoseGoldHighlight/AccentLavender/AccentAqua above - emphasis-only,
    same non-interactive reasoning. Recommended use: BrandGold sparingly
    as a tertiary accent (e.g. a premium/VIP badge), BrandRose for a
    purely decorative highlight - neither is a semantic status color and
    neither should replace Rojan.Brush.Error/Warning/Success.
  -->
  <Color x:Key="Rojan.Color.BrandGold">#FFD4AF7A</Color>
  <Color x:Key="Rojan.Color.BrandRose">#FFF5B7D5</Color>

  <!-- Text drawn on a filled Accent surface (buttons) - white in both themes. -->
  <Color x:Key="Rojan.Color.ButtonText">#FFFFFFFF</Color>

  <!-- Modal scrim - a plain black smoke layer behind dialogs, deliberately theme-invariant (it darkens whatever is beneath it, not a themed surface itself), same as Fluent 2's own Smoke token. -->
  <Color x:Key="Rojan.Color.Scrim">#FF000000</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="Rojan.Brush.Accent" Color="{StaticResource Rojan.Color.Accent}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentHover" Color="{StaticResource Rojan.Color.AccentHover}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentPressed" Color="{StaticResource Rojan.Color.AccentPressed}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentSubtle" Color="{StaticResource Rojan.Color.AccentSubtle}" />
  <SolidColorBrush x:Key="Rojan.Brush.FocusRing" Color="{StaticResource Rojan.Color.FocusRing}" />

  <!-- The four ROJAN brand accents, as brushes - "AccentPurple" is a named alias onto the one interactive Accent above (same color, documented under its brand name too); RoseGold/Lavender/Aqua are emphasis-only. -->
  <SolidColorBrush x:Key="Rojan.Brush.AccentPurple" Color="{StaticResource Rojan.Color.Accent}" />
  <SolidColorBrush x:Key="Rojan.Brush.RoseGoldHighlight" Color="{StaticResource Rojan.Color.RoseGoldHighlight}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentRoseGold" Color="{StaticResource Rojan.Color.RoseGoldHighlight}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentLavender" Color="{StaticResource Rojan.Color.AccentLavender}" />
  <SolidColorBrush x:Key="Rojan.Brush.AccentAqua" Color="{StaticResource Rojan.Color.AccentAqua}" />
  <SolidColorBrush x:Key="Rojan.Brush.BrandGold" Color="{StaticResource Rojan.Color.BrandGold}" />
  <SolidColorBrush x:Key="Rojan.Brush.BrandRose" Color="{StaticResource Rojan.Color.BrandRose}" />

  <SolidColorBrush x:Key="Rojan.Brush.ButtonText" Color="{StaticResource Rojan.Color.ButtonText}" />
  <SolidColorBrush x:Key="Rojan.Brush.Scrim" Color="{StaticResource Rojan.Color.Scrim}" />

</ResourceDictionary>
