<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    Phase 16: one icon family - Segoe Fluent Icons, the glyph font Fluent
    2 apps use throughout Windows 11 (Settings, File Explorer, Microsoft
    365). Falls back to "Segoe MDL2 Assets" (present since Windows 10)
    wherever Segoe Fluent Icons isn't installed - both fonts share the
    same glyph codepoints for every icon used below, so the fallback is
    visually identical, not an approximation. No new package/asset
    dependency: both fonts already ship with Windows.

    This replaces the prior sidebar/header glyphs, which were a mix of
    plain Unicode symbols and emoji (☰ 🔔 › ‹) - inconsistent weights and
    styles next to each other. Every icon in this app now comes from this
    one glyph set, referenced by name (Rojan.Icon.X), not by a raw
    Unicode literal scattered through View markup.
  -->
  <FontFamily x:Key="Rojan.FontFamily.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!--
    Reference-parity Phase A follow-up: Segoe Fluent Icons has no crown
    glyph (verified against Microsoft's official glyph list before
    reaching for a substitute - see the Subscription card's prior
    FavoriteFilled placeholder). Rather than fake one with an unrelated
    font glyph, this is a small hand-authored vector silhouette (a
    3-peak crown, drawn directly as WPF path mini-language - no external
    asset file, no icon-font dependency), following the same
    "Rojan.Icon.X, referenced by name" convention as every glyph above,
    just backed by a Geometry instead of a font codepoint. Reusable
    anywhere via <Path Data="{StaticResource Rojan.Icon.Crown.Geometry}"
    Fill="..." Stretch="Uniform" .../>.
  -->
  <Geometry x:Key="Rojan.Icon.Crown.Geometry">M2,18 L22,18 L20,9 L15,13 L12,6 L9,13 L4,9 Z</Geometry>

  <!-- Navigation -->
  <sys:String x:Key="Rojan.Icon.Menu">&#xE700;</sys:String>
  <sys:String x:Key="Rojan.Icon.Back">&#xE72B;</sys:String>
  <sys:String x:Key="Rojan.Icon.Forward">&#xE72A;</sys:String>
  <sys:String x:Key="Rojan.Icon.Search">&#xE721;</sys:String>
  <sys:String x:Key="Rojan.Icon.ChevronDown">&#xE70D;</sys:String>
  <sys:String x:Key="Rojan.Icon.Calendar2">&#xE787;</sys:String>
  <sys:String x:Key="Rojan.Icon.Notification">&#xEA8F;</sys:String>
  <sys:String x:Key="Rojan.Icon.Person">&#xE77B;</sys:String>
  <!-- Reference-parity Phase A: header theme toggle - Brightness/QuietHours are Segoe Fluent Icons' documented sun/moon-equivalent glyphs. -->
  <sys:String x:Key="Rojan.Icon.ThemeLight">&#xE706;</sys:String>
  <sys:String x:Key="Rojan.Icon.ThemeDark">&#xE708;</sys:String>
  <!-- Phase B-1 (AI Hero Banner): ChatSparkle - verified against Microsoft's official Segoe Fluent Icons glyph list, same verification discipline as ThemeLight/ThemeDark/Crown above. -->
  <sys:String x:Key="Rojan.Icon.Sparkle">&#xEAB7;</sys:String>

  <!-- Window chrome -->
  <sys:String x:Key="Rojan.Icon.Minimize">&#xE921;</sys:String>
  <sys:String x:Key="Rojan.Icon.Maximize">&#xE922;</sys:String>
  <sys:String x:Key="Rojan.Icon.Close">&#xE8BB;</sys:String>

  <!-- Module sidebar icons - one per real module, swapped in for the old mixed glyph set. -->
  <sys:String x:Key="Rojan.Icon.Dashboard">&#xE80F;</sys:String>
  <sys:String x:Key="Rojan.Icon.Customers">&#xE77B;</sys:String>
  <sys:String x:Key="Rojan.Icon.Bookings">&#xE8BF;</sys:String>
  <sys:String x:Key="Rojan.Icon.Calendar">&#xE787;</sys:String>
  <sys:String x:Key="Rojan.Icon.Services">&#xE9D9;</sys:String>
  <sys:String x:Key="Rojan.Icon.Inventory">&#xE71D;</sys:String>
  <sys:String x:Key="Rojan.Icon.Accounting">&#xE8C7;</sys:String>
  <sys:String x:Key="Rojan.Icon.Specialists">&#xE716;</sys:String>
  <sys:String x:Key="Rojan.Icon.Reports">&#xE9D2;</sys:String>
  <sys:String x:Key="Rojan.Icon.AICenter">&#xE945;</sys:String>
  <sys:String x:Key="Rojan.Icon.Settings">&#xE713;</sys:String>

  <!-- Status/trend -->
  <sys:String x:Key="Rojan.Icon.TrendUp">&#xE70E;</sys:String>
  <sys:String x:Key="Rojan.Icon.TrendDown">&#xE70D;</sys:String>
  <sys:String x:Key="Rojan.Icon.TrendFlat">&#xE73D;</sys:String>
  <sys:String x:Key="Rojan.Icon.CheckCircle">&#xE930;</sys:String>
  <sys:String x:Key="Rojan.Icon.ErrorCircle">&#xE783;</sys:String>

  <!-- Phase 22 Branch Switcher: favorite star (outline/filled), reusing the same font family - no new dependency. -->
  <sys:String x:Key="Rojan.Icon.FavoriteOutline">&#xE734;</sys:String>
  <sys:String x:Key="Rojan.Icon.FavoriteFilled">&#xE735;</sys:String>

  <!-- Phase 26: Smart Context Help. -->
  <sys:String x:Key="Rojan.Icon.Help">&#xE897;</sys:String>

  <!-- Phase 27: Enterprise Notification Center - severity icons (Success/Error already covered by CheckCircle/ErrorCircle above). -->
  <sys:String x:Key="Rojan.Icon.Warning">&#xE7BA;</sys:String>
  <sys:String x:Key="Rojan.Icon.Information">&#xE946;</sys:String>

  <!-- Phase 29: Enterprise Workspace & Window Management. -->
  <sys:String x:Key="Rojan.Icon.Add">&#xE710;</sys:String>
  <sys:String x:Key="Rojan.Icon.Dismiss">&#xE711;</sys:String>
  <sys:String x:Key="Rojan.Icon.Edit">&#xE70F;</sys:String>
  <sys:String x:Key="Rojan.Icon.Delete">&#xE74D;</sys:String>
  <sys:String x:Key="Rojan.Icon.Copy">&#xE8C8;</sys:String>
  <sys:String x:Key="Rojan.Icon.Refresh">&#xE72C;</sys:String>
  <sys:String x:Key="Rojan.Icon.FloatOut">&#xE8A7;</sys:String>
  <sys:String x:Key="Rojan.Icon.Workspace">&#xE8A9;</sys:String>
  <sys:String x:Key="Rojan.Icon.Panel">&#xE890;</sys:String>

  <!-- Phase 35: Secure Amount Display - eye toggle for masked monetary KPI values. -->
  <sys:String x:Key="Rojan.Icon.EyeShow">&#xE7B3;</sys:String>
  <sys:String x:Key="Rojan.Icon.EyeHide">&#xED1A;</sys:String>

</ResourceDictionary>
