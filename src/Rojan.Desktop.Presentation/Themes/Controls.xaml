<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters">

  <!--
    Enterprise UX/UI Refinement pass: EnumLabelConverter is declared once
    here (merged app-wide via ThemeResources.Apply) rather than repeated in
    every page's own UserControl.Resources, since every module page that
    displays a Domain status/type/method enum (Customer/Booking/Invoice
    Status, PaymentMethod, StockTransactionType, ...) needs the same one
    instance - see Converters/EnumLabelConverter.cs for why this exists.
  -->
  <converters:EnumLabelConverter x:Key="Rojan.Converter.EnumLabel" />
  <converters:MinutesSuffixConverter x:Key="Rojan.Converter.MinutesSuffix" />

  <!--
    Phase 16: Microsoft Fluent 2 Design System Integration - foundation
    reusable components, rebuilt on neutral surfaces plus one restrained
    accent instead of the prior translucent-glass/gradient look. Key
    key names were "Glass*" through Phase 16 (kept stable then so every
    existing View kept working unchanged while only what they resolved to
    changed); Phase 17A's compliance audit renamed them to their current
    plain Fluent names (Card/Panel/ButtonPrimary/NavigationItem) since a
    style still called "Glass" read as legacy even once fully re-skinned.
    New form-control styles
    (TextBox/ComboBox/DatePicker/CheckBox) are implicit (TargetType, no
    x:Key), so every existing TextBox/ComboBox/DatePicker in every View
    picks them up automatically the moment this dictionary is merged -
    those controls previously had no styling at all (default Windows
    chrome), the single biggest visual inconsistency this phase fixes.

    A shared FocusVisualStyle (accent-colored focus rectangle) is set at
    the bottom of this file so every standard control gets a visible,
    consistent keyboard-focus indicator without each Style needing to
    define its own.

    Fluent 2 Premium Theme pass: no longer self-merges Colors.xaml/
    Dark.xaml/Typography.xaml/etc. - a hardcoded Dark.xaml merge here
    would silently win over whichever theme the user actually chose
    (Rojan.Desktop.Shell.Theming.ThemeResources.Apply merges the correct
    Light.xaml/Dark.xaml once, app-wide, before this file is ever
    consumed - see App.xaml.cs). Every Setter below that references a
    color/brush/spacing/shape/icon key relies on that single app-level
    resource tree already being in scope by the time it's actually
    requested (WPF resolves ResourceDictionary entries lazily, on first
    use - by then the whole tree is assembled, so declaration order
    across files no longer matters the way per-file self-merging used to
    guarantee).
  -->

  <!-- ============================= Accessibility ============================= -->
  <!--
    Shared keyboard-focus indicator - a visible accent-colored rectangle
    around whatever standard control currently has keyboard focus.
    Defined first so every control style below can reference it; applied
    explicitly via each one's FocusVisualStyle setter (WPF resolves a
    control's implicit style by its exact runtime type, so a style
    targeting a common base class like FrameworkElement/Control does not
    cascade into these more specific TextBox/Button/ComboBox styles -
    explicit is the only reliable way).
  -->
  <Style x:Key="Rojan.Style.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2"
                     StrokeThickness="2"
                     Stroke="{StaticResource Rojan.Brush.FocusRing}"
                     SnapsToDevicePixels="True"
                     RadiusX="4"
                     RadiusY="4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================= Surfaces ============================= -->

  <!-- Card: elevated surface for standalone content cards - the default card look used throughout every page. Uses the dedicated Card token (not the more generic Surface, which form controls/panels use) - same value today, but named for its place in the Window -> Navigation -> Page -> Section -> Card -> Content hierarchy. -->
  <Style x:Key="Rojan.Style.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Rojan.CornerRadius.Medium}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Effect" Value="{StaticResource Rojan.Effect.ElevationCard}" />
  </Style>

  <!-- Panel: flat neutral surface for grouping/docked chrome (sidebar, header) - no elevation, sits flush with the canvas. -->
  <Style x:Key="Rojan.Style.Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.SurfaceSecondary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Rojan.CornerRadius.Medium}" />
  </Style>

  <!-- ============================= Buttons ============================= -->

  <!--
    ButtonPrimary: the Fluent "Primary" button - solid accent fill, used
    only for the one primary call-to-action per view/dialog (per Fluent 2
    hierarchy: one Primary, everything else Secondary/Subtle). No pill
    shape, no gradient, no hover glow - a subtle fill-color shift on
    hover/pressed is Fluent's own primary-button feedback.

    Design System Alignment pass: this and the three sibling button
    styles below (Secondary/Outlined/OutlinedDanger), plus the TextBox
    style further down, moved from Rojan.CornerRadius.Small (4px) to
    .Medium (8px) to match rojanai.ir's own button/input radius
    convention (Tailwind's `rounded-md`) - see
    ROJAN_Desktop_Design_Token_Proposal.md §5/§6. Deliberately NOT a
    change to the Small/Medium/Large scale itself (Shapes.xaml
    untouched) and NOT applied to NavigationItem/ComboBoxItem/
    ToggleButton/popup chrome below, which keep their existing 4px -
    still "no pill shape" per Phase 16's own reasoning above, just one
    step rounder than before on the two control families the proposal
    flagged as measurably behind the website.
  -->
  <Style x:Key="Rojan.Style.ButtonPrimary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Medium}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ButtonSecondary: neutral outlined button - every non-primary action (Back, Cancel, Retry). -->
  <Style x:Key="Rojan.Style.ButtonSecondary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.BorderStrong}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Medium}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.SurfacePressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ButtonOutlined: the Fluent "Outline" button - transparent fill,
    accent-colored border/text, one step quieter than ButtonSecondary
    (which has a filled neutral background) - for a tertiary action that
    still needs to read as intentional/accent-adjacent (e.g. "Learn
    more"), not a full secondary action.
  -->
  <Style x:Key="Rojan.Style.ButtonOutlined" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Medium}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentSubtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentSubtle}" />
              <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    UX Stabilization Sprint 1: ButtonOutlinedDanger - same shape/hover/press
    pattern as ButtonOutlined above, but for a destructive secondary action
    (Cancel, No-show) that needs to visually read as different-in-kind from
    a neutral/affirmative action, not just a lower-emphasis one. Reuses the
    existing Rojan.Color.Error/Rojan.Brush.Error tokens already used by
    StatusPill's Error severity (see Controls/Shared/StatusPill.xaml) - no
    new colors introduced.
  -->
  <Style x:Key="Rojan.Style.ButtonOutlinedDanger" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Error}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Error}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Medium}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Rojan.Color.Error}" Opacity="0.14" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Rojan.Color.Error}" Opacity="0.22" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Dashboard Modernization Sprint: Quick Actions button - bigger, rounded
    (Large radius), room for a leading icon in its Content, a soft resting
    shadow, and hover/press feedback as a scale change plus the same
    Accent/AccentHover/AccentPressed fill ButtonPrimary already uses (a
    scale+color pulse is this app's existing "ripple-like" press feedback
    pattern - see Controls/Help/HelpButton.xaml - rather than a literal
    Material ripple, which would need new custom rendering code this
    presentation-only pass doesn't introduce). Local Storyboards, same
    Trigger.EnterActions/ExitActions pattern as HelpButton.xaml/
    DashboardComponents.xaml, using the shared Rojan.Duration.Fast token.
  -->
  <Style x:Key="Rojan.Style.ButtonQuickAction" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,12" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Large}"
                  Padding="{TemplateBinding Padding}"
                  Effect="{StaticResource Rojan.Effect.ElevationCard}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentHover}" />
              <Setter TargetName="ButtonBorder" Property="Effect" Value="{StaticResource Rojan.Effect.ElevationCardHover}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentPressed}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================= Navigation ============================= -->

  <!--
    NavigationItem: sidebar menu entry. Selected state is the
    accent's one real Fluent 2 job here - a soft accent-tinted background
    plus a 3px accent bar on the leading edge (the same "selection
    indicator" shape Fluent's own NavigationView uses), not a solid
    purple fill. Hover is a plain neutral surface tint, not an aqua-mint
    animated overlay - subtler, and consistent with every other hover
    state in this design system now.
  -->
  <Style x:Key="Rojan.Style.NavigationItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    CornerRadius="{StaticResource Rojan.CornerRadius.Small}" />
            <Border x:Name="SelectionBar"
                    Width="3"
                    HorizontalAlignment="Left"
                    Margin="-8,4,0,4"
                    CornerRadius="0,2,2,0"
                    Background="{StaticResource Rojan.Brush.Accent}"
                    Visibility="Collapsed" />
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Rojan.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentSubtle}" />
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================= Tables ============================= -->
  <!--
    Enterprise UX/UI Refinement pass: a premium implicit DataGrid style -
    previously unstyled (default WPF/Aero chrome, the app's one real
    "large white workspace panel" gap since Reporting.ReportingPage is
    the only current DataGrid consumer). Header row uses Workspace's own
    lavender family (reads as "recessed," matching Rojan.Style.Panel),
    alternating rows for scannability, a soft accent-tinted hover/
    selection (same visual language NavigationItem/ComboBoxItem already
    use), and row separators instead of a full grid-line lattice - the
    Fluent 2 "flat table" look, not classic Excel gridlines.
  -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Border}" />
    <Setter Property="RowBackground" Value="{StaticResource Rojan.Brush.Card}" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Rojan.Brush.SurfaceSecondary}" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Rojan.Brush.Border}" />
    <Setter Property="RowHeight" Value="40" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="RowHeaderWidth" Value="0" />
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.SurfaceSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="40" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Rojan.Brush.SurfaceHover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Rojan.Brush.AccentSubtle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================= Form controls ============================= -->
  <!--
    Implicit (TargetType, no x:Key) - every TextBox/ComboBox/DatePicker/
    CheckBox in every existing View picks these up automatically once
    this dictionary is merged. Previously unstyled (default Windows Aero
    chrome), which read as a jarring white box against the dark theme -
    now a consistent Fluent input across the whole app.
  -->

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Rojan.Brush.AccentSubtle}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.BorderStrong}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource Rojan.Brush.Error}" BorderThickness="1" CornerRadius="{StaticResource Rojan.CornerRadius.Medium}">
            <AdornedElementPlaceholder />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Medium}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DatePickerTextBox is the editable surface DatePicker shows in its closed state - styled directly so the date field matches every other input without a full DatePicker retemplate. -->
  <Style TargetType="DatePickerTextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Margin="0" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="CalendarStyle">
      <Setter.Value>
        <Style TargetType="Calendar">
          <Setter Property="Background" Value="{StaticResource Rojan.Brush.SurfaceElevated}" />
          <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
          <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.Border}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Effect" Value="{StaticResource Rojan.Effect.ElevationPopover}" />
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBoxItem - dropdown row, same hover/selected treatment as the sidebar's nav item but without the leading selection bar (a form control, not navigation). -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder"
                  Background="Transparent"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Small}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Rojan.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Rojan.Brush.AccentSubtle}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="1"
                                 Text="{StaticResource Rojan.Icon.ChevronDown}"
                                 FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                 FontSize="10"
                                 Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ToggleButton.Background>
                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
              </ToggleButton.Background>
              <ToggleButton.BorderBrush>
                <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}" />
              </ToggleButton.BorderBrush>
              <ToggleButton.BorderThickness>
                <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}" />
              </ToggleButton.BorderThickness>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                               IsHitTestVisible="False"
                               Content="{TemplateBinding SelectionBoxItem}"
                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
            <Popup x:Name="Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   Focusable="False">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{StaticResource Rojan.Brush.SurfaceElevated}"
                      BorderBrush="{StaticResource Rojan.Brush.Border}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Rojan.CornerRadius.Small}"
                      Margin="0,4,0,0"
                      Padding="4"
                      Effect="{StaticResource Rojan.Effect.ElevationPopover}">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="CheckBoxBorder"
                    Width="18"
                    Height="18"
                    Background="{StaticResource Rojan.Brush.Surface}"
                    BorderBrush="{StaticResource Rojan.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Rojan.CornerRadius.Small}"
                    VerticalAlignment="Center">
              <TextBlock x:Name="CheckGlyph"
                         Text="&#xE73E;"
                         FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                         FontSize="12"
                         Foreground="{StaticResource Rojan.Brush.ButtonText}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
              <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- RadioButton - same circular Fluent shape/feedback as CheckBox's square, for the one existing gap in this form-control set. -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="OuterCircle"
                    Width="18"
                    Height="18"
                    Background="{StaticResource Rojan.Brush.Surface}"
                    BorderBrush="{StaticResource Rojan.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="9"
                    VerticalAlignment="Center">
              <Ellipse x:Name="InnerDot"
                       Width="8"
                       Height="8"
                       Fill="{StaticResource Rojan.Brush.Accent}"
                       Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
              <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ToggleSwitch: the Fluent pill-shaped switch, distinct from CheckBox's
    square glyph - an opt-in style (x:Key, not implicit) for a plain
    ToggleButton, available for feature-toggle-style UI that wants the
    switch affordance specifically rather than a checkbox; existing
    CheckBox-bound toggles elsewhere in the app are unchanged (no layout
    rewiring beyond what this pass's scope calls for).
  -->
  <Style x:Key="Rojan.Style.ToggleSwitch" TargetType="ToggleButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track"
                  Background="{StaticResource Rojan.Brush.SurfacePressed}"
                  BorderBrush="{StaticResource Rojan.Brush.BorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Pill}">
            <Grid>
              <Ellipse x:Name="Thumb"
                       Width="14"
                       Height="14"
                       Fill="{StaticResource Rojan.Brush.TextSecondary}"
                       HorizontalAlignment="Left"
                       Margin="2,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Rojan.Brush.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Rojan.Brush.Accent}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Rojan.Brush.ButtonText}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Phase 27: Enterprise Notification Center's Badge Counter - a small,
    fully-rounded pill (built on the existing Rojan.CornerRadius.Pill
    token, previously unused by any Style) overlaid on the header's bell
    button. Uses Rojan.Brush.Error (a badge count is inherently an
    attention-getting signal, the same reasoning a phone app's unread
    badge is red) rather than the neutral Accent color used elsewhere.
  -->
  <Style x:Key="Rojan.Style.NotificationBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.Error}" />
    <Setter Property="CornerRadius" Value="{StaticResource Rojan.CornerRadius.Pill}" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-4,-4,0" />
  </Style>

</ResourceDictionary>
