<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Gradients.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Shapes.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
    <ResourceDictionary Source="Shadows.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    ROJAN Desktop Design System - foundation reusable components.

    Implemented as named Styles targeting the closest matching standard
    WPF control (Border/Button/ListBoxItem) rather than custom control
    classes - this is the standard WPF pattern for a design-system
    component library and keeps every component purely declarative (no
    code-behind, no logic), consistent with "foundation only". The one
    genuinely composite component (SectionHeader, title + accent
    decoration) is a UserControl instead - see Controls/SectionHeader.xaml.

    Consumers apply these via Style="{StaticResource Rojan.Style.X}" on a
    Border/Button/ListBoxItem - Shell only ever consumes these keys, it
    does not define its own equivalents.
  -->

  <!-- GlassCard: elevated glass surface for standalone content cards. -->
  <Style x:Key="Rojan.Style.GlassCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.GlassWhite}" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Rojan.CornerRadius.GlassCard}" />
    <!-- Literal "24" (matches Rojan.Spacing.Large's value), not a
         StaticResource: Padding is a Thickness, and Spacing tokens are
         plain doubles (reused for FontSize/Width/etc. too) - a boxed
         double assigned directly to a Thickness-typed Setter throws at
         runtime, so the two token kinds can't be interchanged here. -->
    <Setter Property="Padding" Value="24" />
    <Setter Property="Effect" Value="{StaticResource Rojan.Effect.ElevationMedium}" />
  </Style>

  <!-- GlassPanel: flat glass surface for grouping/docked chrome (sidebars, headers) - no elevation. -->
  <Style x:Key="Rojan.Style.GlassPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.GlassWhite}" />
    <Setter Property="BorderBrush" Value="{StaticResource Rojan.Brush.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Rojan.CornerRadius.Small}" />
  </Style>

  <!-- GlassButton: primary call-to-action button, brand purple->magenta gradient, pill shape. -->
  <Style x:Key="Rojan.Style.GlassButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.ButtonGradient}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
    <Setter Property="Padding" Value="24,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.PremiumButton}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextElement.FontFamily="{StaticResource Rojan.FontFamily.Default}"
                               TextElement.FontWeight="SemiBold"
                               TextElement.FontSize="16" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Effect" Value="{StaticResource Rojan.Effect.GlowAccent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    GlassNavigationItem: sidebar menu entry - purple when selected, aqua
    accent on hover. The hover transition is a real animation (Phase 07 -
    "Hover animation" requirement): a dedicated overlay Border
    (HoverOverlay) fades its Opacity in/out via a Storyboard, rather than
    animating the shared Background brush directly - WPF's markup compiler
    (MC4111) rejects a Storyboard targeting a named Freezable nested inside
    a property element; targeting a named FrameworkElement's own Opacity is
    the standard, reliably-supported pattern. The hover MultiTrigger is
    gated on IsSelected="False" so hovering the already-selected item never
    layers the aqua overlay on top of the (intentionally instant, no
    animation needed) selected-state purple.
  -->
  <Style x:Key="Rojan.Style.GlassNavigationItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="Margin" Value="12,2" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.MutedText}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    CornerRadius="{StaticResource Rojan.CornerRadius.Small}" />
            <Border x:Name="HoverOverlay"
                    Background="{StaticResource Rojan.Brush.AquaMint}"
                    CornerRadius="{StaticResource Rojan.CornerRadius.Small}"
                    Opacity="0" />
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                      Storyboard.TargetProperty="Opacity"
                                      To="0.85"
                                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                      Storyboard.TargetProperty="Opacity"
                                      To="0"
                                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Rojan.Brush.VividPurple}" />
              <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
