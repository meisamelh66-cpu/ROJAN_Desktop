<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dashboard="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
                    xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared"
                    xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

  <!--
    Phase 06B: reusable Dashboard widget components. Implicit styles
    (TargetType, no x:Key) - WPF applies these automatically to every
    DashboardCard/DashboardWidget instance once this dictionary is merged,
    no per-instance Style="..." needed. Both are ContentControl-derived
    (see Controls/Dashboard/DashboardCard.cs, DashboardWidget.cs) so they
    get a real Content property for free; visuals live entirely here.

    Fluent 2 Premium Theme pass: no longer self-merges Colors.xaml/
    Typography.xaml/Controls.xaml - see Themes/Controls.xaml's own doc
    comment for why.

    Dashboard Modernization Sprint: premium card shell - a soft diagonal
    gradient (existing Card -> SurfaceSecondary tokens only, both already
    opaque so no alpha-compositing surprises against whatever sits behind
    the card), a larger XLarge corner radius, and a hover state (local
    Storyboards, same Trigger.EnterActions/ExitActions pattern as
    Controls/Help/HelpButton.xaml) that lifts the card a few px, swaps in
    a deeper ElevationCardHover shadow, and fades in an accent-tinted glow
    ring. This chrome lives ONLY here (Rojan.Style.Card itself, used by
    every other page in the app, is untouched) so the premium look is
    scoped to the Dashboard as intended. Every existing named part/trigger
    (Header, LoadingText/EmptyText/ErrorPanel/ContentHost, the State/Title
    triggers) is preserved unchanged - only the outer chrome changed.
  -->

  <!-- DashboardCard: static titled Card wrapper, no load state. -->
  <Style TargetType="{x:Type dashboard:DashboardCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dashboard:DashboardCard}">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="CardLift" Y="0" />
            </Grid.RenderTransform>

            <Border x:Name="CardSurface"
                    Style="{StaticResource Rojan.Style.Card}"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    Effect="{StaticResource Rojan.Effect.ElevationCard}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource Rojan.Color.Card}" Offset="0" />
                  <GradientStop Color="{StaticResource Rojan.Color.SurfaceSecondary}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel>
                <shared:PremiumCardHeader x:Name="Header"
                                           Title="{TemplateBinding Title}"
                                           Margin="0,0,0,16" />
                <ContentPresenter />
              </StackPanel>
            </Border>

            <!-- Drawn on top, transparent interior (no Background) - only its stroke is visible, so it never occludes CardSurface's content, just outlines it on hover. -->
            <Border x:Name="GlowRing"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    BorderBrush="{StaticResource Rojan.Brush.Accent}"
                    BorderThickness="1.5"
                    IsHitTestVisible="False"
                    Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CardSurface" Property="Effect" Value="{StaticResource Rojan.Effect.ElevationCardHover}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DashboardWidget: state-aware Card wrapper for repository-backed content. -->
  <Style TargetType="{x:Type dashboard:DashboardWidget}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dashboard:DashboardWidget}">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="CardLift" Y="0" />
            </Grid.RenderTransform>

            <Border x:Name="CardSurface"
                    Style="{StaticResource Rojan.Style.Card}"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    Effect="{StaticResource Rojan.Effect.ElevationCard}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource Rojan.Color.Card}" Offset="0" />
                  <GradientStop Color="{StaticResource Rojan.Color.SurfaceSecondary}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel>
                <shared:PremiumCardHeader x:Name="Header"
                                           Title="{TemplateBinding Title}"
                                           Margin="0,0,0,16" />

                <TextBlock x:Name="LoadingText"
                           Text="{x:Static loc:Strings.Common_Loading}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Visibility="Collapsed" />

                <TextBlock x:Name="EmptyText"
                           Text="{x:Static loc:Strings.Common_NoDataAvailable}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Visibility="Collapsed" />

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                  <TextBlock Text="{TemplateBinding ErrorMessage}"
                             Style="{StaticResource Rojan.TextStyle.Body}"
                             Foreground="{StaticResource Rojan.Brush.Error}"
                             TextWrapping="Wrap" />
                  <Button Content="{x:Static loc:Strings.Common_Retry}"
                          Style="{StaticResource Rojan.Style.ButtonPrimary}"
                          Command="{TemplateBinding RetryCommand}"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Left" />
                </StackPanel>

                <ContentPresenter x:Name="ContentHost" Visibility="Collapsed" />
              </StackPanel>
            </Border>

            <!-- Drawn on top, transparent interior (no Background) - only its stroke is visible, so it never occludes CardSurface's content, just outlines it on hover. -->
            <Border x:Name="GlowRing"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    BorderBrush="{StaticResource Rojan.Brush.Accent}"
                    BorderThickness="1.5"
                    IsHitTestVisible="False"
                    Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="State" Value="Loading">
              <Setter TargetName="LoadingText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Empty">
              <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Error">
              <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Loaded">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CardSurface" Property="Effect" Value="{StaticResource Rojan.Effect.ElevationCardHover}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Phase 35 (Interactive Dashboard Filters): compact segmented-pill option
    for TimeRangeSelector - a RadioButton (not ToggleButton) so mutual
    exclusivity comes for free from GroupName, with a fully custom template
    since the default RadioButton circle+dot chrome (Themes/Controls.xaml)
    is the wrong shape for a segmented control. Checked state reuses the
    existing Accent brush (the sprint's "Active button must have the
    existing Accent style" requirement) with an animated background
    crossfade (Rojan.Duration.Fast, the same shared token every other
    Dashboard hover/press transition in this app uses) rather than an
    instant Setter swap - "Button transitions must be animated."
  -->
  <Style x:Key="Rojan.Style.TimeRangeOption" TargetType="RadioButton">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.MutedText}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="OptionBorder"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                  Padding="{TemplateBinding Padding}">
            <Border.Background>
              <SolidColorBrush Color="Transparent" />
            </Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="OptionBorder" Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Rojan.Color.SurfaceHover}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="OptionBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="{StaticResource Rojan.Color.Accent}"
                                    Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="OptionBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="Transparent"
                                    Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Phase B-1 (AI Hero Banner): the banner's own gradient background is
    dark enough that the existing ButtonPrimary/ButtonOutlined styles
    (built for light Card surfaces) would low-contrast against it, so
    this is a small, purpose-built pair - still composed entirely from
    existing tokens (AccentPressed, ButtonText, Pill/Medium corner
    radius, Duration.Fast), no new raw colors. ButtonHero: the solid CTA
    pill. ButtonHeroIcon: the secondary glass icon-only square (White-
    at-opacity, the same "reuse a color token's Brush at low Opacity for
    a glass surface" technique NewsTicker/DashboardCard already use with
    Card/SurfaceSecondary).
  -->
  <Style x:Key="Rojan.Style.ButtonHero" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Rojan.Brush.AccentPressed}" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Rojan.Style.ButtonHeroIcon" TargetType="Button">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.ButtonText}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Icons}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" CornerRadius="{StaticResource Rojan.CornerRadius.Medium}">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource Rojan.Color.ButtonText}" Opacity="0.18" />
            </Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Rojan.Color.ButtonText}" Opacity="0.3" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
