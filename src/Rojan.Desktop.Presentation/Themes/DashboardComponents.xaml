<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dashboard="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard"
                    xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization">

  <!--
    Phase 06B: reusable Dashboard widget components. Implicit styles
    (TargetType, no x:Key) - WPF applies these automatically to every
    DashboardCard/DashboardWidget instance once this dictionary is merged,
    no per-instance Style="..." needed. Both are ContentControl-derived
    (see Controls/Dashboard/DashboardCard.cs, DashboardWidget.cs) so they
    get a real Content property for free; visuals live entirely here.

    Fluent 2 Premium Theme pass: no longer self-merges Colors.xaml/
    Typography.xaml/Controls.xaml - see Themes/Controls.xaml's own doc
    comment for why.

    Dashboard Modernization Sprint: premium card shell - a soft diagonal
    gradient (existing Card -> SurfaceSecondary tokens only, both already
    opaque so no alpha-compositing surprises against whatever sits behind
    the card), a larger XLarge corner radius, and a hover state (local
    Storyboards, same Trigger.EnterActions/ExitActions pattern as
    Controls/Help/HelpButton.xaml) that lifts the card a few px, swaps in
    a deeper ElevationCardHover shadow, and fades in an accent-tinted glow
    ring. This chrome lives ONLY here (Rojan.Style.Card itself, used by
    every other page in the app, is untouched) so the premium look is
    scoped to the Dashboard as intended. Every existing named part/trigger
    (Header, LoadingText/EmptyText/ErrorPanel/ContentHost, the State/Title
    triggers) is preserved unchanged - only the outer chrome changed.
  -->

  <!-- DashboardCard: static titled Card wrapper, no load state. -->
  <Style TargetType="{x:Type dashboard:DashboardCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dashboard:DashboardCard}">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="CardLift" Y="0" />
            </Grid.RenderTransform>

            <Border x:Name="CardSurface"
                    Style="{StaticResource Rojan.Style.Card}"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    Effect="{StaticResource Rojan.Effect.ElevationCard}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource Rojan.Color.Card}" Offset="0" />
                  <GradientStop Color="{StaticResource Rojan.Color.SurfaceSecondary}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel>
                <dashboard:WidgetHeader x:Name="Header"
                                         Title="{TemplateBinding Title}"
                                         Margin="0,0,0,16" />
                <ContentPresenter />
              </StackPanel>
            </Border>

            <!-- Drawn on top, transparent interior (no Background) - only its stroke is visible, so it never occludes CardSurface's content, just outlines it on hover. -->
            <Border x:Name="GlowRing"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    BorderBrush="{StaticResource Rojan.Brush.Accent}"
                    BorderThickness="1.5"
                    IsHitTestVisible="False"
                    Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CardSurface" Property="Effect" Value="{StaticResource Rojan.Effect.ElevationCardHover}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DashboardWidget: state-aware Card wrapper for repository-backed content. -->
  <Style TargetType="{x:Type dashboard:DashboardWidget}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dashboard:DashboardWidget}">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="CardLift" Y="0" />
            </Grid.RenderTransform>

            <Border x:Name="CardSurface"
                    Style="{StaticResource Rojan.Style.Card}"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    Effect="{StaticResource Rojan.Effect.ElevationCard}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource Rojan.Color.Card}" Offset="0" />
                  <GradientStop Color="{StaticResource Rojan.Color.SurfaceSecondary}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel>
                <dashboard:WidgetHeader x:Name="Header"
                                         Title="{TemplateBinding Title}"
                                         Margin="0,0,0,16" />

                <TextBlock x:Name="LoadingText"
                           Text="{x:Static loc:Strings.Common_Loading}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Visibility="Collapsed" />

                <TextBlock x:Name="EmptyText"
                           Text="{x:Static loc:Strings.Common_NoDataAvailable}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.MutedText}"
                           Visibility="Collapsed" />

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                  <TextBlock Text="{TemplateBinding ErrorMessage}"
                             Style="{StaticResource Rojan.TextStyle.Body}"
                             Foreground="{StaticResource Rojan.Brush.Error}"
                             TextWrapping="Wrap" />
                  <Button Content="{x:Static loc:Strings.Common_Retry}"
                          Style="{StaticResource Rojan.Style.ButtonPrimary}"
                          Command="{TemplateBinding RetryCommand}"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Left" />
                </StackPanel>

                <ContentPresenter x:Name="ContentHost" Visibility="Collapsed" />
              </StackPanel>
            </Border>

            <!-- Drawn on top, transparent interior (no Background) - only its stroke is visible, so it never occludes CardSurface's content, just outlines it on hover. -->
            <Border x:Name="GlowRing"
                    CornerRadius="{StaticResource Rojan.CornerRadius.XLarge}"
                    BorderBrush="{StaticResource Rojan.Brush.Accent}"
                    BorderThickness="1.5"
                    IsHitTestVisible="False"
                    Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="State" Value="Loading">
              <Setter TargetName="LoadingText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Empty">
              <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Error">
              <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Loaded">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CardSurface" Property="Effect" Value="{StaticResource Rojan.Effect.ElevationCardHover}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Rojan.Duration.Fast}" EasingFunction="{StaticResource Rojan.Easing.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Rojan.Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
