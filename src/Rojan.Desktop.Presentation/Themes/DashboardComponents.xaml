<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dashboard="clr-namespace:Rojan.Desktop.Presentation.Controls.Dashboard">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    Phase 06B: reusable Dashboard widget components. Implicit styles
    (TargetType, no x:Key) - WPF applies these automatically to every
    DashboardCard/DashboardWidget instance once this dictionary is merged,
    no per-instance Style="..." needed. Both are ContentControl-derived
    (see Controls/Dashboard/DashboardCard.cs, DashboardWidget.cs) so they
    get a real Content property for free; visuals live entirely here.
  -->

  <!-- DashboardCard: static titled Card wrapper, no load state. -->
  <Style TargetType="{x:Type dashboard:DashboardCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dashboard:DashboardCard}">
          <Border Style="{StaticResource Rojan.Style.Card}">
            <StackPanel>
              <dashboard:WidgetHeader x:Name="Header"
                                       Title="{TemplateBinding Title}"
                                       Margin="0,0,0,16" />
              <ContentPresenter />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DashboardWidget: state-aware Card wrapper for repository-backed content. -->
  <Style TargetType="{x:Type dashboard:DashboardWidget}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dashboard:DashboardWidget}">
          <Border Style="{StaticResource Rojan.Style.Card}">
            <StackPanel>
              <dashboard:WidgetHeader x:Name="Header"
                                       Title="{TemplateBinding Title}"
                                       Margin="0,0,0,16" />

              <TextBlock x:Name="LoadingText"
                         Text="Loading..."
                         Style="{StaticResource Rojan.TextStyle.Body}"
                         Foreground="{StaticResource Rojan.Brush.MutedText}"
                         Visibility="Collapsed" />

              <TextBlock x:Name="EmptyText"
                         Text="No data available."
                         Style="{StaticResource Rojan.TextStyle.Body}"
                         Foreground="{StaticResource Rojan.Brush.MutedText}"
                         Visibility="Collapsed" />

              <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock Text="{TemplateBinding ErrorMessage}"
                           Style="{StaticResource Rojan.TextStyle.Body}"
                           Foreground="{StaticResource Rojan.Brush.Error}"
                           TextWrapping="Wrap" />
                <Button Content="Retry"
                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                        Command="{TemplateBinding RetryCommand}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left" />
              </StackPanel>

              <ContentPresenter x:Name="ContentHost" Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="State" Value="Loading">
              <Setter TargetName="LoadingText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Empty">
              <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Error">
              <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Loaded">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
