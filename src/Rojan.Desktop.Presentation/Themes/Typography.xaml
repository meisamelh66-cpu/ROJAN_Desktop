<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    ROJAN AI Design System - typography scale, ported from RojanTypography
    (RojanTokens.kt / Type.kt). Sizes are the same numeric scale as the
    source "sp" values, not a pixel-perfect DPI conversion - the two
    platforms are intentionally independent (docs/architecture/00-overview.md
    Goal 1), this only keeps the visual proportions consistent.

    Font family: "Segoe UI" is a placeholder, same reasoning as the Android
    side's FontFamily.Default placeholder - the approved target is
    Vazirmatn, deferred until real font asset integration (out of scope for
    foundation scaffolding). Swapping this is a one-line change per style
    once the font files exist.
  -->
  <FontFamily x:Key="Rojan.FontFamily.Default">Segoe UI</FontFamily>

  <Style x:Key="Rojan.TextStyle.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="LineHeight" Value="42" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.ScreenTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.HeroTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="40" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Button" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

</ResourceDictionary>
