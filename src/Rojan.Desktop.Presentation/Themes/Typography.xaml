<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Phase 16: Fluent 2 type ramp, one consistent scale on one font family.
    "Segoe UI Variable" is Fluent 2's default system font on Windows 11;
    the FontFamily list below falls back to "Segoe UI" (present on every
    Windows 8+ machine) so this renders correctly even where the Variable
    family isn't installed - WPF tries each name in order and uses the
    first one it can resolve.

    Phase 17A: renamed to the exact six-step scale a Fluent 2 compliance
    audit expects - Display / Title / Subtitle / SectionHeader / Body /
    Caption. Two renames map onto how these were actually already being
    used in practice (not new roles, just names that now say what they
    are): SectionTitle -> Title, since the only real consumer
    (Controls/SectionHeader.xaml, the once-per-page heading like
    "Dashboard"/"Inventory") is genuinely the page title, not a
    sub-section one; CardTitle -> SectionHeader, since its real consumer
    (Controls/Dashboard/WidgetHeader.xaml, the heading inside every
    DashboardCard/DashboardWidget) is exactly a "Section" heading in the
    Window -> Navigation -> Page -> Section -> Card -> Content hierarchy.
    The prior "PageTitle" step (28px) is removed - it had no actual
    consumer since Phase 16 introduced it, an orphaned token this audit
    caught rather than a role this app needs a seventh name for.
    HeroTitle -> Display (large KPI numbers, kept beyond the six-step
    body-copy scale for the same "big number display" reasoning as
    before, just renamed to match the requested name).

    Fluent 2 Premium Theme pass: five more roles added below
    (WindowTitle/Disabled/Hyperlink/Error/Warning/Success), each setting
    its own Foreground so a consumer only needs
    `Style="{StaticResource Rojan.TextStyle.X}"` instead of also
    repeating `Foreground="{StaticResource Rojan.Brush.X}"` - the first
    time anything in this file references a color/brush key, so (unlike
    every style above, which is pure type-scale, no color) this file now
    depends on Colors.xaml/{Light,Dark}.xaml already being merged earlier
    in the same parent resource-dictionary list - true wherever this file
    is actually consumed (see App.xaml.cs's ThemeResources.Build, the
    sole place the design system is assembled since the Fluent 2 Premium
    Theme pass removed every other file's redundant self-merge).
  -->
  <FontFamily x:Key="Rojan.FontFamily.Default">Segoe UI Variable, Segoe UI</FontFamily>

  <!-- Large numeric display (KPI values) - deliberately outside the six-step body-copy scale, see note above. -->
  <Style x:Key="Rojan.TextStyle.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- Page title - one per page, via Controls/SectionHeader.xaml. -->
  <Style x:Key="Rojan.TextStyle.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- Section heading - one per Card/Widget, via Controls/Dashboard/WidgetHeader.xaml. -->
  <Style x:Key="Rojan.TextStyle.SectionHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Subtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- Window title - the title-bar brand text (MainWindow's "ROJAN Desktop"), one step down from Title so the title bar doesn't visually compete with a page's own Title. -->
  <Style x:Key="Rojan.TextStyle.WindowTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
  </Style>

  <!-- Disabled body text - same size/weight as Body, muted via the theme's own Disabled brush (deliberately below AA contrast - WCAG does not require disabled, non-interactive text to meet the 4.5:1 minimum, only that it reads as "unavailable"). -->
  <Style x:Key="Rojan.TextStyle.Disabled" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Disabled}" />
  </Style>

  <!-- Hyperlink - Accent-colored and underlined (color alone is not a sufficient link affordance for WCAG 1.4.1 "use of color"), body-text size/weight. -->
  <Style x:Key="Rojan.TextStyle.Hyperlink" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Accent}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Semantic status text - Error/Warning/Success, each theme's own AA-safe shade (see Light.xaml/Dark.xaml doc comments), body-text size/weight. -->
  <Style x:Key="Rojan.TextStyle.Error" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Error}" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Warning" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Warning}" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Success" TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.Success}" />
  </Style>

</ResourceDictionary>
