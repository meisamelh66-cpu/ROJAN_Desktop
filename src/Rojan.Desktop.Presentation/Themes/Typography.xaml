<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Phase 16: Fluent 2 type ramp - one consistent scale, six steps
    (Page Title / Section Title / Card Title / Subtitle / Body / Caption),
    all on one font family. "Segoe UI Variable" is Fluent 2's default
    system font on Windows 11; the FontFamily list below falls back to
    "Segoe UI" (present on every Windows 8+ machine) so this renders
    correctly even where the Variable family isn't installed - WPF tries
    each name in order and uses the first one it can resolve.

    Rojan.TextStyle.HeroTitle is kept beyond the six-step scale
    specifically for large KPI numbers (Controls/Dashboard/KPIValue.xaml)
    - a distinct "big number display" case, not a duplicate of PageTitle.
  -->
  <FontFamily x:Key="Rojan.FontFamily.Default">Segoe UI Variable, Segoe UI</FontFamily>

  <Style x:Key="Rojan.TextStyle.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Subtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Rojan.TextStyle.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- Large numeric display (KPI values) - deliberately outside the six-step scale, see note above. -->
  <Style x:Key="Rojan.TextStyle.HeroTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Default}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

</ResourceDictionary>
