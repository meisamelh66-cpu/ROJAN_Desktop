<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    ROJAN Desktop Design System - the complete token+control set in one
    file, same merge order Rojan.Desktop.Shell.Theming.ThemeResources.Apply
    builds in code at runtime.

    Fluent 2 Premium Theme pass: this is no longer the app's live runtime
    path - App.xaml merges nothing statically, and ThemeResources.Apply
    (called from App.xaml.cs's OnStartup, before any Window is created)
    assembles the same files in the same order, choosing Light.xaml or
    Dark.xaml per the user's persisted theme preference (Light/Dark/
    System - see Presentation.Theming.IThemeService). This file is kept
    as a standalone, self-contained convenience aggregate - useful for a
    design-time preview of a single control/page in isolation, or any
    future consumer that just wants "the whole design system, one theme,
    one merge" - with Light.xaml hardcoded as its theme (matching the
    shipped default); it is not merged by anything in this solution
    anymore, but every key it defines is identical to what
    ThemeResources.Apply produces, so nothing that referenced it is
    broken, just no longer exercised.

    Merge order matters here (each later file's StaticResource lookups
    need the earlier ones already merged into the same scope, resolved
    lazily on first use per ResourceDictionary's own deferred-content
    behavior) - Colors before the theme file, both before Typography/
    Controls/ShellChrome/etc., exactly mirroring ThemeResources.Apply.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Light.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
    <ResourceDictionary Source="Shapes.xaml" />
    <ResourceDictionary Source="Icons.xaml" />
    <ResourceDictionary Source="Shadows.xaml" />
    <ResourceDictionary Source="Elevation.xaml" />
    <ResourceDictionary Source="Controls.xaml" />
    <ResourceDictionary Source="ShellChrome.xaml" />
    <ResourceDictionary Source="DashboardComponents.xaml" />
    <ResourceDictionary Source="Views.xaml" />
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
