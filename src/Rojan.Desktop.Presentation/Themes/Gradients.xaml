<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <!-- Colors must be merged here, not just alongside this dictionary in
         Theme.xaml - a StaticResource lookup only sees a sibling
         dictionary's keys if this dictionary merges it directly. -->
    <ResourceDictionary Source="Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    ROJAN AI Design System - gradient tokens, ported from RojanTokens.kt's
    Brush.linearGradient definitions. Compose's default linearGradient(colors)
    (no explicit start/end) resolves to a top-left-to-bottom-right diagonal
    over the shape's bounds - StartPoint/EndPoint below approximate that;
    exact geometry is not pinned by the source token file and is trivially
    adjustable once a real component consumes these.
  -->

  <LinearGradientBrush x:Key="Rojan.Brush.ButtonGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Rojan.Color.VividPurple}" Offset="0" />
    <GradientStop Color="{StaticResource Rojan.Color.VividMagenta}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Rojan.Brush.HeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Rojan.Color.VividPurple}" Offset="0" />
    <GradientStop Color="{StaticResource Rojan.Color.VividMagenta}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Rojan.Brush.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Rojan.Color.WarmWhite}" Offset="0" />
    <GradientStop Color="{StaticResource Rojan.Color.BlushPink}" Offset="0.25" />
    <GradientStop Color="{StaticResource Rojan.Color.AquaMint}" Offset="0.5" />
    <GradientStop Color="{StaticResource Rojan.Color.SoftLavender}" Offset="0.75" />
    <GradientStop Color="{StaticResource Rojan.Color.WarmWhite}" Offset="1" />
  </LinearGradientBrush>

</ResourceDictionary>
