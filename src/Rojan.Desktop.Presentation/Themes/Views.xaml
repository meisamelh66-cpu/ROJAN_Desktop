<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dashboardVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Dashboard"
                    xmlns:dashboardView="clr-namespace:Rojan.Desktop.Presentation.Views.Dashboard"
                    xmlns:salonsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Salons"
                    xmlns:salonsView="clr-namespace:Rojan.Desktop.Presentation.Views.Salons"
                    xmlns:customersVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Customers"
                    xmlns:customersView="clr-namespace:Rojan.Desktop.Presentation.Views.Customers"
                    xmlns:bookingsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Bookings"
                    xmlns:bookingsView="clr-namespace:Rojan.Desktop.Presentation.Views.Bookings"
                    xmlns:bookingWorkflowVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.BookingWorkflow"
                    xmlns:bookingWorkflowView="clr-namespace:Rojan.Desktop.Presentation.Views.BookingWorkflow"
                    xmlns:calendarVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Calendar"
                    xmlns:calendarView="clr-namespace:Rojan.Desktop.Presentation.Views.Calendar"
                    xmlns:specialistsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Specialists"
                    xmlns:specialistsView="clr-namespace:Rojan.Desktop.Presentation.Views.Specialists"
                    xmlns:servicesVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Services"
                    xmlns:servicesView="clr-namespace:Rojan.Desktop.Presentation.Views.Services"
                    xmlns:inventoryVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Inventory"
                    xmlns:inventoryView="clr-namespace:Rojan.Desktop.Presentation.Views.Inventory"
                    xmlns:accountingVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Accounting"
                    xmlns:accountingView="clr-namespace:Rojan.Desktop.Presentation.Views.Accounting"
                    xmlns:hrVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.HR"
                    xmlns:hrView="clr-namespace:Rojan.Desktop.Presentation.Views.HR"
                    xmlns:settingsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Settings"
                    xmlns:settingsView="clr-namespace:Rojan.Desktop.Presentation.Views.Settings"
                    xmlns:reportingVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Reporting"
                    xmlns:reportingView="clr-namespace:Rojan.Desktop.Presentation.Views.Reporting"
                    xmlns:analyticsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Analytics"
                    xmlns:analyticsView="clr-namespace:Rojan.Desktop.Presentation.Views.Analytics"
                    xmlns:aiVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.AI"
                    xmlns:aiView="clr-namespace:Rojan.Desktop.Presentation.Views.AI"
                    xmlns:modulesVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Modules"
                    xmlns:modulesView="clr-namespace:Rojan.Desktop.Presentation.Views.Modules"
                    xmlns:organizationsVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Organizations"
                    xmlns:organizationsView="clr-namespace:Rojan.Desktop.Presentation.Views.Organizations"
                    xmlns:helpVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Help"
                    xmlns:helpView="clr-namespace:Rojan.Desktop.Presentation.Views.Help"
                    xmlns:notificationVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Notifications"
                    xmlns:notificationView="clr-namespace:Rojan.Desktop.Presentation.Views.Notifications"
                    xmlns:searchVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Search"
                    xmlns:searchView="clr-namespace:Rojan.Desktop.Presentation.Views.Search"
                    xmlns:workspacesVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Workspaces"
                    xmlns:workspacesView="clr-namespace:Rojan.Desktop.Presentation.Views.Workspaces"
                    xmlns:automationVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Automation"
                    xmlns:automationView="clr-namespace:Rojan.Desktop.Presentation.Views.Automation"
                    xmlns:supportVm="clr-namespace:Rojan.Desktop.Presentation.ViewModels.Support"
                    xmlns:supportView="clr-namespace:Rojan.Desktop.Presentation.Views.Support">

  <!--
    ViewModel-to-View mapping (implicit DataTemplate, keyed by DataType,
    no x:Key) - see docs/architecture/01-desktop-shell.md §6. Once merged
    into the Application's resource scope, Shell.Navigation.NavigationService
    setting ContentControl.Content to a resolved ViewModel instance
    automatically renders the matching View below - Shell never references
    a page View type directly.
  -->
  <DataTemplate DataType="{x:Type dashboardVm:DashboardPageViewModel}">
    <dashboardView:DashboardPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type salonsVm:SalonPageViewModel}">
    <salonsView:SalonPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type customersVm:CustomerPageViewModel}">
    <customersView:CustomerPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type bookingsVm:BookingPageViewModel}">
    <bookingsView:BookingPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type bookingWorkflowVm:BookingWizardViewModel}">
    <bookingWorkflowView:BookingWizardView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type calendarVm:CalendarPageViewModel}">
    <calendarView:CalendarPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type specialistsVm:SpecialistPageViewModel}">
    <specialistsView:SpecialistPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type servicesVm:ServicePageViewModel}">
    <servicesView:ServicePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type inventoryVm:InventoryPageViewModel}">
    <inventoryView:InventoryPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type accountingVm:AccountingPageViewModel}">
    <accountingView:AccountingPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type accountingVm:PosCheckoutViewModel}">
    <accountingView:PosCheckoutView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hrVm:HrPageViewModel}">
    <hrView:HrPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type settingsVm:SettingsPageViewModel}">
    <settingsView:SettingsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type reportingVm:ReportingPageViewModel}">
    <reportingView:ReportingPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type reportingVm:ExportDialogViewModel}">
    <reportingView:ExportDialogView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type analyticsVm:AnalyticsPageViewModel}">
    <analyticsView:AnalyticsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type aiVm:AiCenterPageViewModel}">
    <aiView:AiCenterPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type modulesVm:PlaceholderModuleViewModel}">
    <modulesView:PlaceholderModulePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type organizationsVm:OrganizationPageViewModel}">
    <organizationsView:OrganizationPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type helpVm:HelpDialogViewModel}">
    <helpView:ContextHelpDialogView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type notificationVm:ToastNotificationViewModel}">
    <notificationView:ToastNotificationView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type searchVm:CommandPaletteViewModel}">
    <searchView:CommandPaletteView />
  </DataTemplate>

  <!--
    Phase 29: Enterprise Workspace & Window Management. PaneLeafViewModel/
    PaneSplitViewModel are the recursive secondary-pane tree's two node
    types - a ContentPresenter bound to either PaneNode.First/Second (typed
    as plain `object`, since either type can appear at any position)
    resolves through these exactly like every other ViewModel-to-View
    mapping in this file. WorkspaceOutlineViewModel is the flagship
    dockable panel's content, hosted inside DockedPanelView the same way
    any future panel's content would be.
  -->
  <DataTemplate DataType="{x:Type workspacesVm:PaneLeafViewModel}">
    <workspacesView:PaneLeafView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type workspacesVm:PaneSplitViewModel}">
    <workspacesView:PaneSplitView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type workspacesVm:WorkspaceOutlineViewModel}">
    <workspacesView:WorkspaceOutlinePanelView />
  </DataTemplate>

  <!-- Phase 32: Enterprise Automation, Workflow & Business Rules Engine. -->
  <DataTemplate DataType="{x:Type automationVm:AutomationPageViewModel}">
    <automationView:AutomationPage />
  </DataTemplate>

  <!-- UI Polish Sprint: Support Center. -->
  <DataTemplate DataType="{x:Type supportVm:SupportPageViewModel}">
    <supportView:SupportPage />
  </DataTemplate>

</ResourceDictionary>
