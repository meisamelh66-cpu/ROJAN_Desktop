<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Dark.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Shapes.xaml" />
    <ResourceDictionary Source="Icons.xaml" />
    <ResourceDictionary Source="Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    Phase 16: shell-chrome-only button styles (header window commands,
    sidebar collapse toggle, notification bell, back/forward) - neutral
    hover/pressed feedback, no accent (chrome buttons are not one of
    Fluent 2's accent-eligible cases). Content is expected to be a
    Rojan.FontFamily.Icons glyph (see Icons.xaml) via a TextBlock, not the
    old mix of raw Unicode/emoji characters.
  -->

  <!-- Small square icon button - base for every chrome affordance below. -->
  <Style x:Key="Rojan.Style.ChromeIconButton" TargetType="Button">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Rojan.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Rojan.FontFamily.Icons}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rojan.Style.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.SurfacePressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window close command - same shape, red hover instead of neutral (standard "close = red" convention, matches Windows 11's own title bar). -->
  <Style x:Key="Rojan.Style.WindowCloseButton" TargetType="Button" BasedOn="{StaticResource Rojan.Style.ChromeIconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Rojan.Brush.ErrorText}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
