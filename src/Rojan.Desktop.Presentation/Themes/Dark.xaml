<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Phase 16: Dark theme - available as an explicit user choice (see
    Rojan.Desktop.Shell/Theming/ThemeService); Light.xaml is now the
    shipped default (Fluent 2 Premium Light Theme pass). Navy-tinted
    neutral surface ramp, not pure gray - keeps ROJAN's existing Navy as
    the brand's dark base rather than adopting Windows' own neutral
    palette wholesale ("Fluent 2 with ROJAN identity", not a Windows
    clone).

    Phase 17A: renamed to the strict semantic names a Fluent 2 compliance
    audit expects - Background (was Navy), Border/BorderStrong (was
    Stroke/StrokeStrong), Disabled (was DisabledText) - and added Card as
    its own explicit token (same value as Surface today, but named for
    what it is: the Window -> Navigation -> Page -> Section -> Card ->
    Content hierarchy's card tier) rather than reusing the more generic
    Surface token by coincidence. Every key name here is otherwise
    unchanged from Phase 16.

    Self-contained: every surface/text/border/status key a page might
    reference is defined here (and mirrored with light-appropriate
    values in Light.xaml) - Rojan.Desktop.Shell.Theming.ThemeService is
    the one place that decides which of Light.xaml/Dark.xaml actually
    gets merged app-wide, restart-required (same UX as the Localization
    platform's language switch), see Shell/App.xaml.cs.

    Error/Warning/Success moved here from the theme-invariant
    Colors.xaml in the same pass - Error was nudged slightly brighter
    (#E5484D -> #F1555B) to move it from a borderline ~4.45:1 to a
    comfortable ~5.1:1 against this file's own Background, see
    Light.xaml's doc comment for the full rationale.

    Design System Alignment pass: Background and Surface/Card retargeted
    to the exact rojanai.ir product theme's dark shell (`.rojan-theme`
    "background" #1A1426, "card" #241B30 - see
    ROJAN_Web_Design_System_Audit.md §1 / ROJAN_Desktop_Design_Token_
    Proposal.md §1) - a warm purple-navy instead of the prior cool
    blue-navy, matching the website's actual dark app shell rather than
    a generic dark neutral. The website only defines two dark-surface
    tiers (background/card); Workspace/SurfaceSecondary/SurfaceElevated/
    SurfaceHover/SurfacePressed below are interpolated to preserve this
    file's existing five-tier hierarchy (Background < Workspace <
    Surface/Card < SurfaceElevated, with Hover/Pressed as Card-adjacent
    steps) - same relative-lightness relationship as before, just
    re-based on the new purple-navy hue instead of the old blue-navy
    one. Border/BorderStrong (translucent white) and every text/status
    color are UNCHANGED - already conceptually aligned with the
    website's own translucent-white-border dark convention, and text/
    status contrast was previously AA-verified against the old
    Background; deliberately not re-verified against the new one in
    this pass (all are darker/similar lightness, not lighter, so this
    is not expected to regress contrast, but flagging as unverified
    rather than silently claiming AA compliance for values not
    explicitly re-checked here).
  -->

  <Color x:Key="Rojan.Color.Background">#FF1A1426</Color>
  <!-- Premium Lavender Enhancement pass (light theme only - see Light.xaml's own doc comment): Header/Navigation are new keys every consumer now references, so they must resolve here too or selecting Dark theme throws a StaticResource-not-found error. No dark-appropriate target values were given, so both alias straight to this file's own Background, leaving dark mode's appearance unchanged. -->
  <Color x:Key="Rojan.Color.Header">#FF1A1426</Color>
  <Color x:Key="Rojan.Color.Navigation">#FF1A1426</Color>
  <!-- Enterprise UX/UI Refinement pass: mirrors Light.xaml's new Background/Workspace split - a step brighter than Background, one step below Card, so the workspace content area still reads as distinct chrome-vs-canvas in dark mode too. -->
  <Color x:Key="Rojan.Color.Workspace">#FF1F172B</Color>
  <Color x:Key="Rojan.Color.Surface">#FF241B30</Color>
  <Color x:Key="Rojan.Color.Card">#FF241B30</Color>
  <Color x:Key="Rojan.Color.SurfaceSecondary">#FF161120</Color>
  <Color x:Key="Rojan.Color.SurfaceElevated">#FF2C2238</Color>
  <Color x:Key="Rojan.Color.SurfaceHover">#FF281F36</Color>
  <Color x:Key="Rojan.Color.SurfacePressed">#FF221A2E</Color>
  <Color x:Key="Rojan.Color.Border">#21FFFFFF</Color>
  <Color x:Key="Rojan.Color.BorderStrong">#3DFFFFFF</Color>

  <Color x:Key="Rojan.Color.TextPrimary">#FFF3F1FA</Color>
  <Color x:Key="Rojan.Color.TextSecondary">#FFB6B2C9</Color>
  <Color x:Key="Rojan.Color.MutedText">#FFA39DBB</Color>
  <Color x:Key="Rojan.Color.HintText">#FF8B85A3</Color>
  <Color x:Key="Rojan.Color.Disabled">#FF5C5770</Color>

  <Color x:Key="Rojan.Color.Error">#FFF1555B</Color>
  <Color x:Key="Rojan.Color.Warning">#FFF2B93D</Color>
  <Color x:Key="Rojan.Color.Success">#FF3FB950</Color>

  <SolidColorBrush x:Key="Rojan.Brush.Background" Color="{StaticResource Rojan.Color.Background}" />
  <SolidColorBrush x:Key="Rojan.Brush.Header" Color="{StaticResource Rojan.Color.Header}" />
  <SolidColorBrush x:Key="Rojan.Brush.Navigation" Color="{StaticResource Rojan.Color.Navigation}" />
  <SolidColorBrush x:Key="Rojan.Brush.Workspace" Color="{StaticResource Rojan.Color.Workspace}" />
  <SolidColorBrush x:Key="Rojan.Brush.Surface" Color="{StaticResource Rojan.Color.Surface}" />
  <SolidColorBrush x:Key="Rojan.Brush.Card" Color="{StaticResource Rojan.Color.Card}" />
  <SolidColorBrush x:Key="Rojan.Brush.SurfaceSecondary" Color="{StaticResource Rojan.Color.SurfaceSecondary}" />
  <SolidColorBrush x:Key="Rojan.Brush.SurfaceElevated" Color="{StaticResource Rojan.Color.SurfaceElevated}" />
  <SolidColorBrush x:Key="Rojan.Brush.SurfaceHover" Color="{StaticResource Rojan.Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Rojan.Brush.SurfacePressed" Color="{StaticResource Rojan.Color.SurfacePressed}" />
  <SolidColorBrush x:Key="Rojan.Brush.Border" Color="{StaticResource Rojan.Color.Border}" />
  <SolidColorBrush x:Key="Rojan.Brush.BorderStrong" Color="{StaticResource Rojan.Color.BorderStrong}" />

  <SolidColorBrush x:Key="Rojan.Brush.TextPrimary" Color="{StaticResource Rojan.Color.TextPrimary}" />
  <SolidColorBrush x:Key="Rojan.Brush.TextSecondary" Color="{StaticResource Rojan.Color.TextSecondary}" />
  <SolidColorBrush x:Key="Rojan.Brush.MutedText" Color="{StaticResource Rojan.Color.MutedText}" />
  <SolidColorBrush x:Key="Rojan.Brush.HintText" Color="{StaticResource Rojan.Color.HintText}" />
  <SolidColorBrush x:Key="Rojan.Brush.Disabled" Color="{StaticResource Rojan.Color.Disabled}" />

  <SolidColorBrush x:Key="Rojan.Brush.Error" Color="{StaticResource Rojan.Color.Error}" />
  <SolidColorBrush x:Key="Rojan.Brush.Warning" Color="{StaticResource Rojan.Color.Warning}" />
  <SolidColorBrush x:Key="Rojan.Brush.Success" Color="{StaticResource Rojan.Color.Success}" />

</ResourceDictionary>
