<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Fluent 2 Premium Theme pass: no longer self-merges Colors.xaml (unused
    here - every effect below is a literal Black, no StaticResource).

    Phase 16: semantic elevation tiers - what a surface's role is, not how
    deep its shadow happens to be. Controls.xaml/ShellChrome.xaml/page
    Views reference these (Rojan.Effect.ElevationX), not
    Shadows.xaml's "ShadowLevelN" resources directly - keeps the mapping
    from "this is a Card" to "this is a level-4 shadow" in one place, so
    the depth scale can be retuned later without hunting through every
    consumer. DropShadowEffect is a Freezable, and a WPF resource
    dictionary can't declare a second key as a plain alias onto an
    existing Freezable entry (attempted via a top-level
    <StaticResource x:Key=".." ResourceKey=".."/> - a valid-looking
    pattern that the XAML compiler rejects at this scope) - so each tier
    is its own definition here rather than a reference into Shadows.xaml.
  -->

  <!-- Fluent 2 Premium Theme pass: opacities lowered to match Shadows.xaml's own tuning - see that file's doc comment. -->
  <DropShadowEffect x:Key="Rojan.Effect.ElevationNavigation"
                     Color="Black"
                     Direction="270"
                     ShadowDepth="1"
                     BlurRadius="4"
                     Opacity="0.10" />

  <DropShadowEffect x:Key="Rojan.Effect.ElevationCard"
                     Color="Black"
                     Direction="270"
                     ShadowDepth="2"
                     BlurRadius="8"
                     Opacity="0.12" />

  <DropShadowEffect x:Key="Rojan.Effect.ElevationPopover"
                     Color="Black"
                     Direction="270"
                     ShadowDepth="4"
                     BlurRadius="16"
                     Opacity="0.16" />

  <DropShadowEffect x:Key="Rojan.Effect.ElevationDialog"
                     Color="Black"
                     Direction="270"
                     ShadowDepth="6"
                     BlurRadius="28"
                     Opacity="0.22" />

  <!--
    Dashboard Modernization Sprint: a deeper hover-state tier for the
    premium dashboard card shell (ElevationCard's own values, deepened
    along the same neutral-black Fluent depth scale as ElevationPopover/
    ElevationDialog above) - "hover elevation" per the sprint spec.
    Additive; ElevationCard's own rest-state value is untouched.
  -->
  <DropShadowEffect x:Key="Rojan.Effect.ElevationCardHover"
                     Color="Black"
                     Direction="270"
                     ShadowDepth="5"
                     BlurRadius="22"
                     Opacity="0.20" />

</ResourceDictionary>
