<Window x:Class="Rojan.Desktop.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization;assembly=Rojan.Desktop.Presentation"
        Title="ROJAN Reception"
        Width="420"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource Rojan.Brush.Background}">

    <!--
        Desktop OTP Authentication Migration: a standalone top-level Window
        (not a MainWindow-hosted dialog region) since it must be shown, and
        can succeed or fail, entirely before MainWindow/MainWindowViewModel
        (workspace restoration, organization context, etc.) are ever
        constructed - see App.xaml.cs's OnStartup gating. FlowDirection is
        set in code-behind from ILocalizationService, same as MainWindow.

        DataContext is LoginWindowViewModel - Phone Number + OTP
        (MobileLogin) is the only sign-in flow, per the approved Identity
        Policy (Email/Password is deliberately not offered here as an
        alternative - see LoginWindowViewModel's own doc comment for why
        this isn't a dual-mode UI). Two panels share this DataContext,
        switched via a DataTrigger on MobileLogin.IsCodeSent - the
        phone-entry step and the code-entry step. Bindings stay fully
        qualified (MobileLogin.X) matching every other ViewModel-per-section
        convention in this app. IsBusy/ErrorMessage react via
        Style+DataTrigger (no value converters needed).
    -->
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="ROJAN Reception"
                       Style="{StaticResource Rojan.TextStyle.Display}"
                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="{x:Static loc:Strings.Login_Title}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <!-- ===================== Step 1: phone number entry ===================== -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MobileLogin.IsCodeSent}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{x:Static loc:Strings.Login_Mobile_PhoneLabel}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="PhoneTextBox"
                         Text="{Binding MobileLogin.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MobileLogin.IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Content="{x:Static loc:Strings.Login_Mobile_SendCodeButton}"
                        Command="{Binding MobileLogin.RequestCodeCommand}"
                        IsDefault="True"
                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                        HorizontalAlignment="Stretch"
                        Height="40" />
            </StackPanel>

            <!-- ===================== Step 2: OTP code entry ===================== -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MobileLogin.IsCodeSent}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{x:Static loc:Strings.Login_Mobile_CodeLabel}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="CodeTextBox"
                         Text="{Binding MobileLogin.Code, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MobileLogin.IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Content="{x:Static loc:Strings.Login_Mobile_VerifyButton}"
                        Command="{Binding MobileLogin.VerifyCodeCommand}"
                        IsDefault="True"
                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{x:Static loc:Strings.Login_Mobile_ResendButton}"
                            Command="{Binding MobileLogin.ResendCodeCommand}"
                            Style="{StaticResource Rojan.Style.ButtonSecondary}"
                            Margin="0,0,4,0" />
                    <Button Grid.Column="1"
                            Content="{x:Static loc:Strings.Login_Mobile_ChangeNumberButton}"
                            Command="{Binding MobileLogin.ChangeNumberCommand}"
                            Style="{StaticResource Rojan.Style.ButtonSecondary}"
                            Margin="4,0,0,0" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding MobileLogin.ErrorMessage}"
                       Foreground="{StaticResource Rojan.Brush.Error}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MobileLogin.ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
