<Window x:Class="Rojan.Desktop.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization;assembly=Rojan.Desktop.Presentation"
        Title="ROJAN Desktop"
        Width="420"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource Rojan.Brush.Background}">

    <!--
        Owner App Mobile Login: a standalone top-level Window (not a
        MainWindow-hosted dialog region) since it must be shown, and can
        succeed or fail, entirely before MainWindow/MainWindowViewModel
        (workspace restoration, organization context, etc.) are ever
        constructed - see App.xaml.cs's OnStartup gating. FlowDirection is
        set in code-behind from ILocalizationService, same as MainWindow.

        DataContext is LoginWindowViewModel - Email/Password (EmailLogin)
        is the only sign-in flow (Authentication Recovery, Option C: Mobile
        Number + OTP was the sole flow for a period, but calls backend
        endpoints that do not exist on the real ROJAN_Backend - see
        LoginWindowViewModel's own doc comment). Bindings stay fully
        qualified (EmailLogin.X) matching every other ViewModel-per-section
        convention in this app. IsBusy/ErrorMessage react via
        Style+DataTrigger (no value converters needed).
    -->
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="ROJAN Desktop"
                       Style="{StaticResource Rojan.TextStyle.Display}"
                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="{x:Static loc:Strings.Login_Title}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <!-- ===================== Email + Password (only sign-in flow) ===================== -->
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.Login_EmailLabel}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="EmailTextBox"
                         Text="{Binding EmailLogin.Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmailLogin.IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="{x:Static loc:Strings.Login_PasswordLabel}"
                           Style="{StaticResource Rojan.TextStyle.Caption}"
                           Foreground="{StaticResource Rojan.Brush.TextSecondary}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,8">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmailLogin.IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <TextBlock Text="{Binding EmailLogin.ErrorMessage}"
                           Foreground="{StaticResource Rojan.Brush.Error}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmailLogin.ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="{x:Static loc:Strings.Login_SignInButton}"
                        Command="{Binding EmailLogin.SignInCommand}"
                        IsDefault="True"
                        Style="{StaticResource Rojan.Style.ButtonPrimary}"
                        HorizontalAlignment="Stretch"
                        Height="40" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
