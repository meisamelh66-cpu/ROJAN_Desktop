<Window x:Class="Rojan.Desktop.Shell.Workspaces.FloatingModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        MinWidth="480"
        MinHeight="360"
        Background="{StaticResource Rojan.Brush.Background}">

    <!--
        Phase 29: Enterprise Workspace & Window Management. A module "torn
        off" into its own real OS window - same custom-WindowChrome idiom
        MainWindow.xaml uses (see that file's own doc comment for why
        WindowChrome over WindowStyle="None"+AllowsTransparency), just a
        shorter caption since there's no sidebar/breadcrumb/search here.
        No manual theme-dictionary merge needed: Shell.Theming.ThemeResources
        merges the whole design system into Application.Resources at
        startup, and every StaticResource lookup here falls back to that
        automatically, the same as any other Window in this app.
        ContentHost hosts whichever of the 14 existing module pages this
        window was floated from, unmodified - resolved via the same
        implicit-DataTemplate-by-ViewModel-type mechanism NavigationHost
        already uses in MainWindow.
    -->
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shellChrome:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Rojan.Brush.Header}" BorderBrush="{StaticResource Rojan.Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Rojan.Style.ChromeIconButton}" Click="MinimizeButton_Click">
                        <TextBlock Text="{StaticResource Rojan.Icon.Minimize}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" />
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource Rojan.Style.ChromeIconButton}" Click="MaximizeRestoreButton_Click">
                        <TextBlock Text="{StaticResource Rojan.Icon.Maximize}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="11" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Rojan.Style.WindowCloseButton}" Click="CloseButton_Click">
                        <TextBlock Text="{StaticResource Rojan.Icon.Close}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</Window>
