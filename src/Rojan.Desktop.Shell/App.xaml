<Application x:Class="Rojan.Desktop.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <!-- No StartupUri: startup is entirely code-driven from OnStartup
         (App.xaml.cs), so the Generic Host builds/starts before any
         window is shown - see docs/architecture/01-desktop-shell.md §4/§5.

         ShutdownMode=OnExplicitShutdown: without this, WPF's default
         (OnLastWindowClose) tears the Application down the instant
         LoginWindow closes after a successful fresh-session OTP sign-in -
         at that moment it is the only open window, since MainWindow does
         not exist yet. App.xaml.cs's OnStartup already calls Shutdown()
         explicitly on every real exit path (declined login, declined salon
         selection, declined feature setup, session-resolution decline,
         sign-out) and MainWindow.Closed also calls it explicitly - this
         setting makes that the only way the app exits, matching what
         OnStartup's own "PASS D3" comment at the mainWindow.Show() call site
         already documents as the intended behavior. -->

    <!--
         Phase 05: the design system itself (tokens + reusable components)
         lives in Rojan.Desktop.Presentation - Shell only consumes it, it
         does not own or duplicate any theme resource dictionary.

         Fluent 2 Premium Theme pass: Application.Resources is left EMPTY
         here (no static Source= merge) - which of Light.xaml/Dark.xaml
         actually gets merged is now a runtime decision (the user's
         persisted Light/Dark/System preference, resolved by
         IThemeService), so Rojan.Desktop.Shell.Theming.ThemeResources.Apply
         builds the merge in code, in OnStartup, before MainWindow (or
         anything else XAML-based) is created - the same "must happen
         before any XAML that depends on it" ordering the Localization
         platform's culture/RTL setup already uses just below this in
         App.xaml.cs. Every View now consumes this one application-level
         resource tree instead of each merging its own local copy of the
         design system. -->
    <Application.Resources>
        <ResourceDictionary />
    </Application.Resources>

</Application>
