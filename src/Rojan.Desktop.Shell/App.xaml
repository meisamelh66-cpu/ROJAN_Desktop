<Application x:Class="Rojan.Desktop.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- No StartupUri: startup is entirely code-driven from OnStartup
         (App.xaml.cs), so the Generic Host builds/starts before any
         window is shown - see docs/architecture/01-desktop-shell.md §4/§5. -->

    <!--
         Phase 05: the design system itself (tokens + reusable components)
         lives in Rojan.Desktop.Presentation - Shell only consumes the one
         aggregate entry point, it does not own or duplicate any theme
         resource dictionary. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Rojan.Desktop.Presentation;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
