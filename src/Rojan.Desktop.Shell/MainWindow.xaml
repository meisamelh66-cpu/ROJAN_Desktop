<Window x:Class="Rojan.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:navigation="clr-namespace:Rojan.Desktop.Presentation.Navigation;assembly=Rojan.Desktop.Presentation"
        xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization;assembly=Rojan.Desktop.Presentation"
        xmlns:appOrg="clr-namespace:Rojan.Desktop.Application.Organizations;assembly=Rojan.Desktop.Application"
        xmlns:helpControls="clr-namespace:Rojan.Desktop.Presentation.Controls.Help;assembly=Rojan.Desktop.Presentation"
        xmlns:notificationViews="clr-namespace:Rojan.Desktop.Presentation.Views.Notifications;assembly=Rojan.Desktop.Presentation"
        xmlns:appWorkspaces="clr-namespace:Rojan.Desktop.Application.Workspaces;assembly=Rojan.Desktop.Application"
        xmlns:workspacesView="clr-namespace:Rojan.Desktop.Presentation.Views.Workspaces;assembly=Rojan.Desktop.Presentation"
        xmlns:converters="clr-namespace:Rojan.Desktop.Presentation.Converters;assembly=Rojan.Desktop.Presentation"
        xmlns:shared="clr-namespace:Rojan.Desktop.Presentation.Controls.Shared;assembly=Rojan.Desktop.Presentation"
        Title="ROJAN Reception"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{StaticResource Rojan.Brush.Background}">

    <!--
        Phase 07: Enterprise Navigation &amp; Module Shell. MainWindow is now
        the permanent application frame - Header/Navigation/Workspace/
        Status/Notification/Dialog regions - not a page-specific layout.
        Every region reads from MainWindowViewModel; none of them know
        which modules exist beyond what IModuleRegistry supplies through
        it.

        Phase 16: Microsoft Fluent 2 Design System Integration - neutral
        surfaces, one accent (selected nav item, the brand status dot),
        and one consistent icon family (Segoe Fluent Icons, see
        Themes/Icons.xaml) replacing the prior mixed Unicode/emoji glyph
        set. Structure/bindings/commands are unchanged from Phase 07 -
        this is a visual pass only.

        Custom title bar via WindowChrome (not WindowStyle="None" +
        AllowsTransparency, which disables hardware-accelerated rendering
        in a way custom WindowChrome does not) - CaptionHeight matches the
        header's own height below, so the whole header row is the
        draggable caption area by default; every interactive header
        element is explicitly marked IsHitTestVisibleInChrome="True" to
        opt back into normal click/focus behavior instead of dragging the
        window.

        Phase 19A: RTL is now actually enabled - MainWindow.xaml.cs's
        constructor sets FlowDirection from ILocalizationService.CurrentLanguage
        right after InitializeComponent(), overriding the LeftToRight
        default below (kept only as the design-time/XAML-preview value).
        Grid column ordering mirrors automatically, as this file's Phase
        05 note always expected. The asymmetric BorderThickness values
        below (e.g. the navigation region's right-only border,
        "0,0,1,0") were this note's original open question - confirmed
        under Arabic and Persian during this phase's runtime validation
        pass (see docs/phases/phase-19A-globalization-platform.md): WPF
        mirrors Thickness left/right the same way it mirrors Grid column
        order, so this border stays on the boundary between the nav
        region and content (right edge in LTR, left edge in RTL) with
        no XAML changes needed.
    -->
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="56"
                                   ResizeBorderThickness="6"
                                   GlassFrameThickness="0"
                                   CornerRadius="0" />
    </shellChrome:WindowChrome.WindowChrome>

    <!--
        Phase 28: Enterprise Global Search & Command Palette - global
        keyboard shortcuts, available from anywhere in the window
        regardless of which control currently has focus (WPF's
        Window.InputBindings mechanism, not previously used anywhere in
        this app). Ctrl+K is the primary shortcut (matches VS Code/most
        modern command-palette conventions); Ctrl+P is bound as an alias
        to the same command per the spec's "Ctrl+K and Ctrl+P
        architecture" - both entries in one small, extensible list rather
        than hardcoded as a single binding, so a future shortcut is just
        one more KeyBinding here.
    -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding OpenCommandPaletteCommand}" />

        <!--
            Phase 29: Enterprise Workspace & Window Management - one more
            small addition to the same extensible KeyBinding list Phase 28
            started. Split/cycle/close/float act on WorkspaceHost.FocusedLeafId
            (the pane a click last focused) - see WorkspaceHostViewModel's
            own doc comment for why that fallback lives there rather than
            in a bound CommandParameter here.
        -->
        <KeyBinding Modifiers="Control+Shift" Key="D" Command="{Binding WorkspaceHost.SplitRightCommand}" CommandParameter="{Binding WorkspaceHost.FocusedLeafId}" />
        <KeyBinding Modifiers="Control+Shift" Key="J" Command="{Binding WorkspaceHost.SplitDownCommand}" CommandParameter="{Binding WorkspaceHost.FocusedLeafId}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding WorkspaceHost.CloseFocusedTabCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="F" Command="{Binding WorkspaceHost.FloatOutFocusedTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding WorkspaceHost.CycleTabNextCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding WorkspaceHost.CycleTabPreviousCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="W" Command="{Binding WorkspaceHost.ToggleSwitcherCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="R" Command="{Binding WorkspaceHost.ResetWorkspaceCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToFlowDirectionConverter x:Key="BoolToFlowDirectionConverter" />

        <!--
            Phase 29: Enterprise Workspace & Window Management - one row in
            the Workspace Switcher popover, same PlacementTarget.DataContext
            trick BranchSwitcherRowTemplate below already establishes for
            reaching MainWindowViewModel from inside a Popup's separate
            visual root.
        -->
        <DataTemplate x:Key="WorkspaceSwitcherRowTemplate" DataType="{x:Type appWorkspaces:WorkspaceSummaryDto}">
            <Border Background="Transparent" Cursor="Hand" Padding="8,6" CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding PlacementTarget.DataContext.WorkspaceHost.SwitchWorkspaceItemCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource Rojan.Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                            Command="{Binding PlacementTarget.DataContext.WorkspaceHost.StartRenameCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                            CommandParameter="{Binding}"
                            ToolTip="{x:Static loc:Strings.Workspace_Switcher_Rename}"
                            AutomationProperties.Name="{x:Static loc:Strings.Workspace_Switcher_Rename}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Edit}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                    </Button>
                    <Button Grid.Column="3"
                            Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                            Command="{Binding PlacementTarget.DataContext.WorkspaceHost.DuplicateWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                            CommandParameter="{Binding}"
                            ToolTip="{x:Static loc:Strings.Workspace_Switcher_Duplicate}"
                            AutomationProperties.Name="{x:Static loc:Strings.Workspace_Switcher_Duplicate}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Copy}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                    </Button>
                    <Button Grid.Column="4"
                            Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                            Command="{Binding PlacementTarget.DataContext.WorkspaceHost.DeleteWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                            CommandParameter="{Binding}"
                            ToolTip="{x:Static loc:Strings.Workspace_Switcher_Delete}"
                            AutomationProperties.Name="{x:Static loc:Strings.Workspace_Switcher_Delete}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Delete}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            Branch Switcher row - reused for Favorites/Recent/every
            organization group. Popup content lives in a separate visual
            root, so RelativeSource AncestorType=Window cannot reach
            MainWindowViewModel from here; AncestorType=Popup + PlacementTarget
            is the standard WPF pattern that does.
        -->
        <DataTemplate x:Key="BranchSwitcherRowTemplate" DataType="{x:Type appOrg:BranchDto}">
            <Border Background="Transparent" Cursor="Hand" Padding="8,6" CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding PlacementTarget.DataContext.SelectBranchFromSwitcherCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Rojan.TextStyle.Body}" />
                        <TextBlock Text="{Binding Code}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Cursor="Hand"
                            Command="{Binding PlacementTarget.DataContext.ToggleFavoriteBranchCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="{StaticResource Rojan.Icon.FavoriteOutline}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="14" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header region -->
            <RowDefinition Height="*" />
            <!-- Body: Navigation + Workspace regions -->
            <RowDefinition Height="Auto" />
            <!-- Status region -->
        </Grid.RowDefinitions>

        <!-- ================= Header region ================= -->
        <Border Grid.Row="0"
                Height="56"
                Background="{StaticResource Rojan.Brush.Header}"
                BorderBrush="{StaticResource Rojan.Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Brand -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Module title / breadcrumb -->
                    <ColumnDefinition Width="*" />
                    <!-- Draggable spacer -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Search -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Branch Switcher -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Phase 29: Workspace Switcher -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Language selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Notification -->
                    <ColumnDefinition Width="Auto" />
                    <!-- User profile -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Window commands -->
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Rojan.Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="ROJAN Reception"
                               Style="{StaticResource Rojan.TextStyle.WindowTitle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Current module title + breadcrumb -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="{Binding SelectedNavigationItem.Title}"
                               Style="{StaticResource Rojan.TextStyle.Subtitle}"
                               Foreground="{StaticResource Rojan.Brush.TextPrimary}" />
                    <TextBlock Text="{Binding BreadcrumbText}"
                               Style="{StaticResource Rojan.TextStyle.Caption}"
                               Foreground="{StaticResource Rojan.Brush.MutedText}" />
                </StackPanel>

                <!-- Phase 28: Global Search & Command Palette entry point - opens the same palette as Ctrl+K/Ctrl+P. -->
                <Border Grid.Column="3"
                        Style="{StaticResource Rojan.Style.Panel}"
                        Width="240"
                        Height="32"
                        Cursor="Hand"
                        ToolTip="{x:Static loc:Strings.Search_Palette_Placeholder}"
                        AutomationProperties.Name="{x:Static loc:Strings.Common_Search}"
                        shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommandPaletteCommand}" />
                    </Border.InputBindings>
                    <Grid Margin="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource Rojan.Icon.Search}"
                                       FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                       FontSize="13"
                                       Foreground="{StaticResource Rojan.Brush.HintText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static loc:Strings.Common_Search}"
                                       Style="{StaticResource Rojan.TextStyle.Body}"
                                       Foreground="{StaticResource Rojan.Brush.HintText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Ctrl+K"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.HintText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!--
                    Branch Switcher (Phase 22: Enterprise Multi-Branch &
                    Organization Platform). A professional Fluent 2 flyout,
                    not a plain ComboBox: current branch indicator on the
                    trigger button, a search box, Favorite/Recently-used
                    sections, and every organization's branches grouped
                    underneath. Selecting a branch live-switches the active
                    branch (no restart) via ICurrentSessionService.SwitchBranchAsync;
                    the popup itself fades in/out (PopupAnimation="Fade")
                    for a smooth transition.
                -->
                <StackPanel Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BranchSwitcherButton"
                            Command="{Binding ToggleBranchSwitcherCommand}"
                            Style="{StaticResource Rojan.Style.ButtonSecondary}"
                            ToolTip="{x:Static loc:Strings.Shell_BranchSwitcher}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Rojan.Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CurrentBranch.Name}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{StaticResource Rojan.Icon.ChevronDown}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        </StackPanel>
                    </Button>

                    <Popup IsOpen="{Binding IsBranchSwitcherOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BranchSwitcherButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Style="{StaticResource Rojan.Style.Panel}" Width="320" MaxHeight="480" Padding="12" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Search -->
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="10,6">
                                        <Grid>
                                            <TextBlock Text="{x:Static loc:Strings.Shell_BranchSwitcher_SearchPlaceholder}"
                                                       Foreground="{StaticResource Rojan.Brush.HintText}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BranchSearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding BranchSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                                     CaretBrush="{StaticResource Rojan.Brush.Accent}" />
                                        </Grid>
                                    </Border>

                                    <!-- Favorites -->
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FavoriteBranches.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{x:Static loc:Strings.Shell_BranchSwitcher_Favorites}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="4,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding FavoriteBranches}" ItemTemplate="{StaticResource BranchSwitcherRowTemplate}" />
                                    </StackPanel>

                                    <!-- Recently used -->
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentBranches.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{x:Static loc:Strings.Shell_BranchSwitcher_Recent}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="4,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding RecentBranches}" ItemTemplate="{StaticResource BranchSwitcherRowTemplate}" />
                                    </StackPanel>

                                    <!-- Every organization's branches, grouped -->
                                    <ItemsControl ItemsSource="{Binding BranchGroups}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type navigation:BranchSwitcherGroup}">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding OrganizationName}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="4,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Branches}" ItemTemplate="{StaticResource BranchSwitcherRowTemplate}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>

                <!--
                    Phase 29: Enterprise Workspace & Window Management -
                    Workspace button/popover, same trigger-Button-plus-Popup
                    chrome the Branch Switcher above already establishes.
                    Two sections: pane Actions (split/toggle-outline/reset,
                    acting on WorkspaceHost.FocusedLeafId the same way the
                    keyboard shortcuts do) and Workspaces (switch/new/
                    rename/duplicate/delete - WorkspaceSwitcherRowTemplate
                    above).
                -->
                <StackPanel Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="WorkspaceSwitcherButton"
                            Command="{Binding WorkspaceHost.ToggleSwitcherCommand}"
                            Style="{StaticResource Rojan.Style.ChromeIconButton}"
                            ToolTip="{x:Static loc:Strings.Workspace_HeaderButton_Tooltip}"
                            AutomationProperties.Name="{x:Static loc:Strings.Workspace_HeaderButton_Tooltip}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Workspace}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="14" />
                    </Button>

                    <Popup IsOpen="{Binding WorkspaceHost.IsSwitcherOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=WorkspaceSwitcherButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Style="{StaticResource Rojan.Style.Panel}" Width="320" MaxHeight="560" Padding="12" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Strings.Workspace_Switcher_Title}" Style="{StaticResource Rojan.TextStyle.SectionHeader}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" Margin="4,0,0,10" />

                                    <!-- Pane actions -->
                                    <TextBlock Text="{x:Static loc:Strings.Workspace_HeaderButton_Tooltip}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="4,0,0,8" />
                                    <UniformGrid Columns="2" Rows="2">
                                        <Button Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="2" Content="{x:Static loc:Strings.Workspace_Pane_SplitRight}"
                                                Command="{Binding WorkspaceHost.SplitRightCommand}" CommandParameter="{Binding WorkspaceHost.FocusedLeafId}" />
                                        <Button Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="2" Content="{x:Static loc:Strings.Workspace_Pane_SplitDown}"
                                                Command="{Binding WorkspaceHost.SplitDownCommand}" CommandParameter="{Binding WorkspaceHost.FocusedLeafId}" />
                                        <Button Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="2" Content="{x:Static loc:Strings.Workspace_DockPanel_Toggle}"
                                                Command="{Binding WorkspaceHost.ToggleDockPanelCommand}" CommandParameter="outline" />
                                        <Button Style="{StaticResource Rojan.Style.ButtonSecondary}" Margin="2" Content="{x:Static loc:Strings.Workspace_Switcher_Reset}"
                                                Command="{Binding WorkspaceHost.ResetWorkspaceCommand}" />
                                    </UniformGrid>

                                    <!-- Recent Workspaces - most-recently-switched-to first, hidden once there's nothing recent yet (a fresh install with only the Default workspace). -->
                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WorkspaceHost.RecentWorkspaces.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{x:Static loc:Strings.Workspace_Switcher_Recent}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="4,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding WorkspaceHost.RecentWorkspaces}" ItemTemplate="{StaticResource WorkspaceSwitcherRowTemplate}" />
                                    </StackPanel>

                                    <!-- Workspaces -->
                                    <TextBlock Text="{x:Static loc:Strings.Workspace_Switcher_All}" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" Margin="4,16,0,4" />
                                    <ItemsControl ItemsSource="{Binding WorkspaceHost.Workspaces}" ItemTemplate="{StaticResource WorkspaceSwitcherRowTemplate}" />

                                    <!-- New workspace / rename inline editor -->
                                    <Border Style="{StaticResource Rojan.Style.Panel}" Padding="10,6" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding WorkspaceHost.NewWorkspaceNameText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                                     CaretBrush="{StaticResource Rojan.Brush.Accent}"
                                                     Tag="{x:Static loc:Strings.Workspace_Switcher_NewNamePlaceholder}"
                                                     AutomationProperties.Name="{x:Static loc:Strings.Workspace_Switcher_NewNamePlaceholder}" />
                                            <Button Grid.Column="1"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                                    Command="{Binding WorkspaceHost.ConfirmNameCommand}"
                                                    ToolTip="{x:Static loc:Strings.Workspace_Switcher_New}"
                                                    AutomationProperties.Name="{x:Static loc:Strings.Workspace_Switcher_New}">
                                                <TextBlock Text="{StaticResource Rojan.Icon.Add}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="13" Foreground="{StaticResource Rojan.Brush.Accent}" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                                    Command="{Binding WorkspaceHost.CancelNameEditCommand}"
                                                    ToolTip="{x:Static loc:Strings.Common_Cancel}"
                                                    AutomationProperties.Name="{x:Static loc:Strings.Common_Cancel}">
                                                <TextBlock Text="{StaticResource Rojan.Icon.Dismiss}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="11" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>

                <!--
                    Language selector - UX toolbar redesign: the toolbar's
                    only entry point for switching language (Settings still
                    has the full built-in/pack management UI). Same trigger-
                    Button-plus-Popup chrome as Branch/Workspace Switcher
                    above, not a plain ComboBox, for visual consistency.
                    Switching is "select, persist, restart required" via
                    ILocalizationService.SetLanguageAsync - same non-live
                    flow SettingsPageViewModel/ToggleThemeCommand already
                    use, communicated honestly via StatusMessage rather than
                    faking a live language change.
                -->
                <StackPanel Grid.Column="6" Margin="8,0,0,0" VerticalAlignment="Center" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LanguageSwitcherButton"
                            Command="{Binding ToggleLanguageSwitcherCommand}"
                            Style="{StaticResource Rojan.Style.ButtonSecondary}"
                            ToolTip="{x:Static loc:Strings.Settings_Language_SectionTitle}"
                            AutomationProperties.Name="{x:Static loc:Strings.Settings_Language_SectionTitle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentLanguage.Code}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Rojan.Icon.ChevronDown}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        </StackPanel>
                    </Button>

                    <Popup IsOpen="{Binding IsLanguageSwitcherOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=LanguageSwitcherButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Style="{StaticResource Rojan.Style.Panel}" Width="200" Padding="6" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                                <ItemsControl.ItemTemplate>
                                    <!--
                                        Premium Language Selector: each row now shows a small
                                        vector flag (shared:FlagIcon) beside the language name -
                                        same Button/Command/CommandParameter wiring as before, only
                                        the content changed from a bare TextBlock to a flag+text
                                        StackPanel. FlowDirection is bound per-row to that
                                        language's own IsRightToLeft (not the ambient app
                                        FlowDirection), so Farsi/Arabic rows always read RTL and
                                        English/German rows always read LTR regardless of which
                                        language is currently active - WPF mirrors the StackPanel's
                                        child order, the Button's HorizontalContentAlignment, and
                                        the flag's own Margin together automatically, so the flag
                                        always lands on the correct side without any extra
                                        per-language logic. A fixed FlagIcon Width and Margin on
                                        every row keeps every name starting at the same offset
                                        (equal spacing, aligned rows).
                                    -->
                                    <DataTemplate DataType="{x:Type loc:LanguageInfo}">
                                        <Button Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Rojan.Style.ButtonSecondary}"
                                                FlowDirection="{Binding IsRightToLeft, Converter={StaticResource BoolToFlowDirectionConverter}}"
                                                HorizontalContentAlignment="Left"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <shared:FlagIcon LanguageCode="{Binding Code}" Width="20" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding NativeName}" Style="{StaticResource Rojan.TextStyle.Body}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Notification button - Phase 27: badge counter overlay shows NotificationCenter.UnreadCount when > 0. -->
                <Grid Grid.Column="7" Margin="4,0,0,0" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="NotificationButton"
                            Style="{StaticResource Rojan.Style.ChromeIconButton}"
                            Command="{Binding ToggleNotificationPanelCommand}"
                            ToolTip="{x:Static loc:Strings.Common_Notifications}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Notification}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="14" />
                    </Button>
                    <Border IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Rojan.Style.NotificationBadge}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationCenter.HasUnread}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding NotificationCenter.UnreadCount}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.ButtonText}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- User profile placeholder - avatar/name still not functional (no User entity in this app, see Common_GuestUser's existing doc trail), but the role subtitle and plan badge are real session data (ICurrentSessionService.CurrentRole / CurrentOrganization.SubscriptionPlan), not fabricated. -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Ellipse Width="26" Height="26" VerticalAlignment="Center" Fill="{StaticResource Rojan.Brush.SurfaceHover}" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:Strings.Common_GuestUser}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.TextSecondary}" />
                        <TextBlock Text="{Binding CurrentRoleDisplayName}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.MutedText}"
                                   FontSize="10" />
                    </StackPanel>
                    <Border Background="{StaticResource Rojan.Brush.AccentSubtle}"
                            CornerRadius="{StaticResource Rojan.CornerRadius.Pill}"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{x:Static loc:Strings.Header_SubscriptionPlanTooltip}">
                        <TextBlock Text="{Binding CurrentSubscriptionPlanDisplayName}"
                                   Style="{StaticResource Rojan.TextStyle.Caption}"
                                   Foreground="{StaticResource Rojan.Brush.Accent}"
                                   FontSize="10" />
                    </Border>
                </StackPanel>

                <!-- Window commands -->
                <StackPanel Grid.Column="9" Orientation="Horizontal" Margin="16,0,0,0" shellChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Rojan.Style.ChromeIconButton}" Click="MinimizeButton_Click" ToolTip="{x:Static loc:Strings.Common_Minimize}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Minimize}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" />
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource Rojan.Style.ChromeIconButton}" Click="MaximizeRestoreButton_Click" ToolTip="{x:Static loc:Strings.Common_Maximize}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Maximize}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="11" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Rojan.Style.WindowCloseButton}" Click="CloseButton_Click" ToolTip="{x:Static loc:Strings.Common_Close}">
                        <TextBlock Text="{StaticResource Rojan.Icon.Close}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body: Navigation + Workspace regions ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- Navigation region -->
                <ColumnDefinition Width="*" />
                <!-- Workspace region -->
            </Grid.ColumnDefinitions>

            <!-- Navigation region -->
            <Border Grid.Column="0"
                    Background="{StaticResource Rojan.Brush.Navigation}"
                    BorderBrush="{StaticResource Rojan.Brush.Border}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="232" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter Property="Width" Value="56" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Top"
                            Style="{StaticResource Rojan.Style.ChromeIconButton}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{x:Static loc:Strings.Common_CollapseExpandNavigation}"
                            Margin="12,12,0,8"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{StaticResource Rojan.Icon.Menu}" FontFamily="{StaticResource Rojan.FontFamily.Icons}" FontSize="14" />
                    </Button>

                    <!-- Reference-parity Phase A: sidebar logo header block, above the nav list. Reuses the existing collapse-aware text-hiding pattern (see the nav item Title trigger below) rather than inventing a new one. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,4,12,16">
                        <Border Width="30" Height="30" CornerRadius="{StaticResource Rojan.CornerRadius.Medium}" Background="{StaticResource Rojan.Brush.Accent}">
                            <TextBlock Text="R" FontWeight="Bold" Foreground="{StaticResource Rojan.Brush.ButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="ROJAN" Style="{StaticResource Rojan.TextStyle.Subtitle}" Foreground="{StaticResource Rojan.Brush.TextPrimary}" FontWeight="Bold" />
                            <TextBlock Text="Desktop" Style="{StaticResource Rojan.TextStyle.Caption}" Foreground="{StaticResource Rojan.Brush.MutedText}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Reference-parity Phase A: subscription card - real data (ICurrentSessionService.CurrentOrganization.SubscriptionPlan via CurrentSubscriptionPlanDisplayName, already added for the header badge), not fabricated. Manage button navigates to the Organizations module (real navigation) rather than being a dead placeholder. -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource Rojan.Brush.AccentSubtle}"
                            CornerRadius="{StaticResource Rojan.CornerRadius.Large}"
                            Margin="12,12,12,16"
                            Padding="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Rojan.Icon.Crown.Geometry}"
                                      Fill="{StaticResource Rojan.Brush.Accent}"
                                      Stretch="Uniform"
                                      Width="15"
                                      Height="15"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentSubscriptionPlanDisplayName}"
                                           Style="{StaticResource Rojan.TextStyle.Body}"
                                           Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Header_SubscriptionActiveStatus}"
                                       Style="{StaticResource Rojan.TextStyle.Caption}"
                                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                                       Margin="0,4,0,10" />
                            <Button Content="{x:Static loc:Strings.Header_ManageSubscription}"
                                    Style="{StaticResource Rojan.Style.ButtonPrimary}"
                                    Command="{Binding NavigateToModuleCommand}"
                                    CommandParameter="organizations"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="NavigationListBox"
                             DockPanel.Dock="Top"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Rojan.Style.NavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type navigation:NavigationItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="{StaticResource Rojan.FontFamily.Icons}"
                                               FontSize="15"
                                               Width="20"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Body}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--
                Workspace region - real content target, DataTemplate-resolved
                per the selected module's ViewModel. Phase 29: wraps the
                pre-existing NavigationHost (unchanged element, unchanged
                Attach() wiring in MainWindow.xaml.cs) with an optional
                secondary-pane split and the Workspace Outline dock zone -
                both zero-width/collapsed by default (HasSecondaryPane
                false, OutlinePanel.IsVisible false until the user opens
                it), so a fresh install renders byte-for-byte identical to
                every prior phase.
            -->
            <Grid Grid.Column="1" Background="{StaticResource Rojan.Brush.Workspace}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding WorkspaceHost.OutlinePanel.EffectiveSize, Converter={StaticResource DoubleToGridLengthConverter}}" />
                </Grid.ColumnDefinitions>

                <!-- Primary pane + optional secondary-pane tree -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding WorkspaceHost.HasSecondaryPane, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=Auto}" />
                        <ColumnDefinition Width="{Binding WorkspaceHost.HasSecondaryPane, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=Star}" />
                    </Grid.ColumnDefinitions>

                    <ContentControl x:Name="NavigationHost" Grid.Column="0" />

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource Rojan.Brush.Border}"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False"
                                  Visibility="{Binding WorkspaceHost.HasSecondaryPane, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ContentControl Grid.Column="2" Content="{Binding WorkspaceHost.SecondaryRoot}" />
                </Grid>

                <!-- Right dock zone: the Workspace Outline panel (Phase 29's flagship dockable panel) -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource Rojan.Brush.Border}"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              Visibility="{Binding WorkspaceHost.OutlinePanel.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <workspacesView:DockedPanelView Grid.Column="2"
                                                 Margin="4"
                                                 DataContext="{Binding WorkspaceHost.OutlinePanel}"
                                                 Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

        </Grid>

        <!-- ================= Status region ================= -->
        <Border Grid.Row="2"
                Background="{StaticResource Rojan.Brush.Background}"
                BorderBrush="{StaticResource Rojan.Brush.Border}"
                BorderThickness="0,1,0,0"
                CornerRadius="0"
                Height="26">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       VerticalAlignment="Center"
                       Margin="16,0" />
        </Border>

        <!--
            Notification region (Phase 27: Enterprise Notification Center).
            UX toolbar redesign: was a plain Border driven by an
            IsNotificationPanelOpen DataTrigger, which only closed when the
            bell was clicked again - no outside-click dismissal. Now a
            Popup with StaysOpen="False", the exact same idiom the header's
            own Branch/Workspace Switcher already establish above: WPF
            closes it automatically on an outside click and, because
            IsOpen is bound Mode=TwoWay, that close pushes back into
            IsNotificationPanelOpen - no click-away handler code needed.
            HorizontalOffset="-348" = Rojan.Style.ChromeIconButton's own
            32px width minus this panel's 380px width, right-aligning the
            panel's right edge with the bell button's right edge (Bottom
            placement otherwise left-aligns, which would run the panel off
            the window's right edge given how close the bell sits to it).
        -->
        <Popup Grid.Row="1"
               IsOpen="{Binding IsNotificationPanelOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=NotificationButton}"
               Placement="Bottom"
               HorizontalOffset="-348"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="380" Style="{StaticResource Rojan.Style.Card}" Margin="0,4,0,0">
                <notificationViews:NotificationCenterPanelView DataContext="{Binding NotificationCenter}" />
            </Border>
        </Popup>

        <!-- ================= Dialog region ================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveDialog}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!--
                Fluent modal scrim: a plain black smoke layer (not the theme
                Background brush, which would tint the whole window with
                itself), at a Fluent-appropriate 40% rather than the heavier
                50% used before this audit. Phase 26.4: outside-click-to-close
                is wired here (MainWindow.xaml.cs's Scrim_MouseLeftButtonDown)
                scoped specifically to the Context Help Dialog - every other
                existing dialog (e.g. PosCheckoutView's multi-step sale) keeps
                its prior behavior of not closing on a scrim click, since that
                could silently discard in-progress work.
            -->
            <Border x:Name="Scrim" Background="{StaticResource Rojan.Brush.Scrim}" Opacity="0.4" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" />
            <ContentControl Content="{Binding ActiveDialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!--
            ================= Toast overlay region (Phase 27) =================
            Non-modal, deliberately rendered above the Dialog region (last in
            this Grid's Z-order) so a toast - e.g. "connection lost" - stays
            visible even while a modal dialog is open. Never routed through
            IDialogService/ActiveDialog - see ToastHostViewModel's own doc
            comment for why toasts are architecturally separate from dialogs.
        -->
        <Grid Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,16,0">
            <ItemsControl ItemsSource="{Binding ToastHost.ActiveToasts}" />
        </Grid>

    </Grid>

</Window>
