<Window x:Class="Rojan.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:Rojan.Desktop.Shell.Navigation"
        xmlns:controls="clr-namespace:Rojan.Desktop.Presentation.Controls;assembly=Rojan.Desktop.Presentation"
        Title="ROJAN Desktop"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{StaticResource Rojan.Brush.Navy}">

    <!--
        Phase 05: Shell only consumes the ROJAN Desktop Design System
        (Rojan.Desktop.Presentation.Themes.Controls/SectionHeader) - it no
        longer defines its own inline styles or owns any theme resource
        dictionary (see App.xaml).

        RTL-ready note: this layout uses Grid column ordering (which WPF
        mirrors automatically under FlowDirection="RightToLeft") rather than
        manual positioning - flipping the Window's FlowDirection alone
        re-flows header/sidebar/content correctly. The one thing that does
        NOT auto-mirror is the asymmetric BorderThickness values below
        (e.g. "0,0,1,0") - revisit those specifically if/when RTL is
        actually enabled, everything else needs no rework.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top header -->
            <RowDefinition Height="*" />
            <!-- Body: sidebar + content -->
        </Grid.RowDefinitions>

        <!-- Top header -->
        <Border Grid.Row="0"
                Height="64"
                Background="{StaticResource Rojan.Brush.Navy}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="24,0">
                <Ellipse Width="12"
                         Height="12"
                         Fill="{StaticResource Rojan.Brush.AIGlow}"
                         VerticalAlignment="Center" />
                <controls:SectionHeader Title="ROJAN Desktop"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <!-- Sidebar -->
                <ColumnDefinition Width="*" />
                <!-- Main content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0"
                    Style="{StaticResource Rojan.Style.GlassPanel}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="0">
                <ListBox x:Name="NavigationListBox"
                         Margin="0,16,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Rojan.Style.GlassNavigationItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type navigation:NavigationItem}">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource Rojan.TextStyle.Body}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Main content area -->
            <Grid Grid.Column="1"
                  Background="{StaticResource Rojan.Brush.Navy}">

                <!--
                    Navigation foundation's real content target -
                    Phase 06A: Dashboard is now registered and navigable;
                    the other five sections have no page yet.
                -->
                <ContentControl x:Name="NavigationHost" />

                <!-- Placeholder for the sections with no page yet - hidden once a real page (Dashboard) is showing. -->
                <TextBlock Text="{Binding SelectedNavigationItem.Title, StringFormat={}{0} — coming soon}"
                           Style="{StaticResource Rojan.TextStyle.HeroTitle}"
                           Foreground="{StaticResource Rojan.Brush.ButtonText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding PlaceholderVisibility}" />
            </Grid>

        </Grid>
    </Grid>

</Window>
