<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Desktop Productionization Sprint 2 (Production Branding): the real
         ROJAN brand mark (see build/generate-icon.ps1's own doc comment
         for provenance) - drives the .exe's own icon, its taskbar entry,
         and (via the installer's existing UninstallDisplayIcon binding to
         this same .exe) the Add/Remove Programs entry too. Start Menu/
         desktop shortcuts inherit it automatically since they already
         point at this .exe. -->
    <ApplicationIcon>Assets\RojanReception.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rojan.Desktop.Presentation\Rojan.Desktop.Presentation.csproj" />
    <ProjectReference Include="..\Rojan.Desktop.Infrastructure\Rojan.Desktop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 19A: Language Pack manifests - LanguagePackManager scans this
         folder (copied next to the exe) at startup so installing a new
         language is "drop a .pack file in", no code change. -->
    <None Include="Languages\*.pack" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Rojan.Desktop.Shell.Tests construct LanguagePackManager/LocalizationService
         via their internal (path-overriding) constructors instead of the real
         AppContext.BaseDirectory/LocalAppData. -->
    <InternalsVisibleTo Include="Rojan.Desktop.Shell.Tests" />
  </ItemGroup>

</Project>
