<Window x:Class="Rojan.Desktop.Shell.SalonSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rojan.Desktop.Presentation.Localization;assembly=Rojan.Desktop.Presentation"
        xmlns:salons="clr-namespace:Rojan.Desktop.Application.Salons;assembly=Rojan.Desktop.Application"
        Title="ROJAN Reception"
        Width="420"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource Rojan.Brush.Background}">

    <!--
        PASS D6 (Active Salon Context Correctness): a standalone top-level Window, same reasoning as
        LoginWindow.xaml's own doc comment - shown entirely before MainWindow/MainWindowViewModel are
        constructed, via App.xaml.cs's OnStartup gating, only when this account has more than one real
        candidate salon and none is already active. Each row is a plain clickable Border (Cursor="Hand"
        + MouseBinding), the exact same row idiom the existing Branch Switcher's own
        BranchSwitcherRowTemplate (MainWindow.xaml) already establishes for "click a list item to select
        it" - reused here rather than inventing a second interaction pattern.
    -->
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{x:Static loc:Strings.SalonSelection_Title}"
                       Style="{StaticResource Rojan.TextStyle.Display}"
                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="{x:Static loc:Strings.SalonSelection_Subtitle}"
                       Style="{StaticResource Rojan.TextStyle.Caption}"
                       Foreground="{StaticResource Rojan.Brush.MutedText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CandidateList" ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type salons:SalonContext}">
                        <Border Background="{StaticResource Rojan.Brush.SurfaceHover}"
                                Cursor="Hand"
                                Padding="14,12"
                                Margin="0,0,0,8"
                                CornerRadius="{StaticResource Rojan.CornerRadius.Small}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <TextBlock Text="{Binding SalonName}"
                                       Style="{StaticResource Rojan.TextStyle.Body}"
                                       Foreground="{StaticResource Rojan.Brush.TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource Rojan.Brush.Error}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Rojan.TextStyle.Caption}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
