<Project>

  <!--
    Shared MSBuild settings for every project in the solution. Individual
    .csproj files should not repeat these — override only when a specific
    project has a genuine, documented reason to differ (e.g. a test project
    disabling a warning that's noise in test code but not production code).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Company>ROJAN</Company>
    <!-- Desktop Productionization Sprint 2 (Production Branding): the
         user-facing Product name is "ROJAN Reception" (matches the
         installer's AppName, the Start Menu group, and every marketing
         surface). The solution/project/namespace names stay
         RojanDesktop/Rojan.Desktop.* unchanged - renaming those would
         ripple through every file in the repo for a purely cosmetic
         metadata field with zero functional benefit. -->
    <Product>ROJAN Reception</Product>
    <Copyright>Copyright © ROJAN $([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>

  <!--
    Versioning: single source of truth for the whole solution, per
    docs/standards/versioning.md. Every project inherits this unless a
    packaging step later needs to override it for a specific artifact.

    Desktop Productionization Sprint 2: bumped to 1.0.0, a deliberate
    judgment call made explicitly in this sprint (see that doc's own §4 -
    "1.0.0 only once the first genuinely usable release goes out ... made
    explicitly at that time, not automatically"). This is a version
    label, not a claim that every gap is closed - see
    docs/RojanReception_v1.0_Production_Checklist.md for what's real and
    what still isn't (unsigned installer, no live-tested login, POS still
    intentionally out of scope).
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>
